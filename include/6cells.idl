// This file is libsixel 6cells IDL.  Its surface is intentionally close to
// OMG IDL and MIDL, but tools/gen_6cells_h.awk is the only supported compiler.

/*
 * Attribute contract:
 *
 * [component]
 * - Marks an interface as a 6cells component boundary.  Concrete storage stays
 *   hidden, and callers operate through the generated vtbl contract.
 *
 * [native]
 * - Marks a C-native primitive or handle that participates in the 6cells
 *   contract without becoming an interface or factory-created component.
 *
 * [opaque]
 * - Marks a native type whose concrete storage stays hidden outside its owning
 *   implementation.
 *
 * [refcounted]
 * - Marks a component or native type whose lifetime is controlled by
 *   ref()/unref().
 *
 * [responsibility("...")]
 * - Records the component's single responsibility in machine-readable form.
 *
 * [forbid_state("name", ...)]
 * - Lists state categories that must not be owned by the component.  The
 *   generator expands each state name into the generated header comment.
 *
 * [classid("...")]
 * - Applies to coclass declarations only and records the factory lookup key.
 *
 * [serviceid("...")]
 * - Applies to coclass declarations only and records the service lookup key.
 *
 * [lifetime(retained)] / [lifetime(release)]
 * - Marks refcount operations that retain or release the receiver.
 *
 * [mutates]
 * - Marks a method that changes receiver-owned state.
 *
 * [invalidates(name, ...)]
 * - Lists borrowed views or pointers invalidated by a mutating method.
 *
 * [borrows(name)]
 * - Marks a returned pointer or out view as borrowed from the receiver.  The
 *   caller must not free it.  Borrowed values become invalid after unref() or
 *   after a method whose [invalidates(...)] list contains the same name.
 *
 * [const]
 * - Marks a method whose generated receiver argument is const-qualified.
 *
 * [alias(...)]
 * - Controls C projection type names only; it is not a semantic design
 *   contract.  Generated vtbl receiver arguments are always named self.
 *
 * coclass name { [default] interface iface; };
 * - Records that a factory-created concrete component provides iface.  The
 *   syntax intentionally follows COM/MIDL-style coclass blocks.
 */

module sixel {

/*
 * Component services hide their concrete storage. Their interfaces may evolve
 * together with their callers; the compatibility boundary is sixel.h.in at
 * v1.8.7-r2. Legacy public entry points adapt to these component contracts.
 */
struct sixel_option_argument_list_resolution;

[native, opaque, refcounted]
[responsibility("provide allocation services required by factory creation")]
typedef sixel_allocator_t allocator;

[alias(sixel_timeline_logger_t)]
interface timeline_logger;

struct timeline_event {
    char const *role;
    char const *worker;
    char const *event;
    int job_id;
};

struct timeline_frame_context {
    int frame_no;
    int loop_no;
    int multiframe;
};

struct timeline_record {
    unsigned int session_id;
    double timestamp;
    unsigned long long thread_id;
    char const *worker;
    char const *role;
    char const *event;
    int job_id;
    int frame_no;
    int loop_no;
    int multiframe;
};

[component, refcounted]
[responsibility("own shared diagnostic timeline JSONL output and clock origin")]
[forbid_state("frame_context", "job_context")]
[alias(sixel_timeline_writer_t)]
interface timeline_writer {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    SIXELSTATUS create_logger(
        in allocator *allocator,
        out timeline_logger **logger);
    SIXELSTATUS write(in timeline_record const *record);
    void flush();
};

[serviceid("services/timeline-writer")]
coclass timeline_writer_component {
    [default] interface timeline_writer;
};

/*
 * TODO: Replace ambient frame context with an explicit event/context DTO
 * so frame scope is not hidden mutable state on timeline_logger.
 */
[component, refcounted]
[responsibility("record one diagnostic timeline session")]
[forbid_state("output_file", "global_writer")]
interface timeline_logger {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    SIXELSTATUS log(in timeline_event const *event);
    SIXELSTATUS set_frame_context(
        in timeline_frame_context const *context);
    void clear_frame_context();
    [const] unsigned int session_id();
};

[classid("diagnostics/timeline-logger")]
coclass timeline_logger_component {
    [default] interface timeline_logger;
};

struct thread_pool_job {
    int band_index;
};

typedef int (*sixel_thread_pool_worker_function_t)(
    thread_pool_job job,
    void *userdata,
    void *workspace);

typedef void (*sixel_thread_pool_workspace_cleanup_function_t)(
    void *workspace);

[alias(sixel_thread_pool_t)]
interface thread_pool;

struct thread_pool_create_request {
    int threads;
    int queue_size;
    size_t workspace_size;
    sixel_thread_pool_worker_function_t worker;
    void *userdata;
    sixel_thread_pool_workspace_cleanup_function_t workspace_cleanup;
};

[component, refcounted]
[responsibility("own one private worker queue and its worker threads")]
[forbid_state("global_queue", "process_thread_budget")]
interface thread_pool {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    void set_affinity(in int pin_threads);
    [mutates]
    SIXELSTATUS push(in thread_pool_job job);
    [mutates]
    void finish();
    int get_error();
    [mutates]
    SIXELSTATUS grow(in int additional_threads);
    /* Seal submissions and wait for all accepted jobs and policy hooks.
     * Release the batch policy snapshot, retaining threads and workspaces.
     * Return the first job error; repeated drains preserve that error.
     * The owner serializes lifecycle calls. Do not call from a pool job. */
    [mutates]
    SIXELSTATUS drain();
    /* Reopen a healthy drained pool with the caller's current policy.
     * Callback, userdata and workspace bindings remain unchanged. No jobs
     * run while drained. Active, failed or finished pools cannot resume.
     * Creation starts an open batch; finish remains terminal drain/join. */
    [mutates]
    SIXELSTATUS resume();
};

[component, refcounted]
[responsibility("create independent thread pools and resolve thread counts")]
[forbid_state("worker_threads", "job_queue", "encoder_state")]
[alias(sixel_threadpool_service_t)]
interface threadpool_service {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    int resolve_threads(in int requested);
    SIXELSTATUS create_pool(
        in thread_pool_create_request const *request,
        out thread_pool **pool);
};

[serviceid("services/threadpool")]
coclass threadpool_service_component {
    [default] interface threadpool_service;
};

[alias(sixel_encoder_core_t)]
interface encoder_core;

[alias(sixel_writer_t)]
interface sixel_writer;

interface frame;

/* Native data owners have no vtbl or factory identity. The declarations are
 * emitted here, rather than added to the legacy sixel.h public surface. */
cpp_quote <<
#include <stdint.h>

typedef struct sixel_wire_palette sixel_wire_palette_t;
typedef struct sixel_indexed_frame sixel_indexed_frame_t;
typedef struct sixel_retained_read sixel_retained_read_t;
typedef struct sixel_retained_update sixel_retained_update_t;
typedef struct sixel_stream_receipt sixel_stream_receipt_t;
>>

[native, opaque, refcounted]
[responsibility("own immutable wire definitions and their retained RGB")]
typedef sixel_wire_palette_t wire_palette;

[native, opaque, refcounted]
[responsibility("own indexed pixels and publish immutable completed rows")]
typedef sixel_indexed_frame_t indexed_frame;

[native, opaque, refcounted]
[responsibility("pin one published retained-plane generation for readers")]
typedef sixel_retained_read_t retained_read;

[native, opaque, refcounted]
[responsibility("own one prepared retained-plane update transaction")]
typedef sixel_retained_update_t retained_update;

[native, opaque, refcounted]
[responsibility("identify a successfully completed ordered writer image")]
typedef sixel_stream_receipt_t stream_receipt;

/* stream is allocated by the retained-plane instance, not by a transport.
 * begin_update binds this identity once before a new producer publishes rows.
 * Imported complete frames carry the identity used to compute their keeps;
 * begin_update verifies that identity instead of rebinding it.
 * sequence must exceed base_sequence; gaps for dropped source frames are OK.
 * Zero stream denotes an untracked image, which cannot advance history. */
struct encode_identity {
    uint64_t stream;
    uint64_t epoch;
    uint64_t base_sequence;
    uint64_t sequence;
};

struct wire_color_definition {
    unsigned int register_index;
    int type;
    int fields[3];
};

struct wire_palette_request {
    wire_color_definition const *definitions;
    size_t count;
    int color_definition;
    int colorspace;
};

struct wire_color {
    wire_color_definition definition;
    unsigned char emitted_rgb[3];
};

struct wire_palette_view {
    wire_color const *colors;
    size_t count;
    int color_definition;
    int colorspace;
};

/* Definitions are copied and validated; emitted RGB is derived from those
 * exact fields. In particular, never regenerate HLS fields from rounded RGB.
 * Index i addresses colors[i]; the serializer uses its register_index.
 * Unsupported wire interpretations fail without publishing a palette.
 * Views borrow the immutable owner until its last unref. */
SIXELAPI SIXELSTATUS sixel_wire_palette_new(
    out wire_palette **result,
    in wire_palette_request const *request,
    in allocator *allocator);
SIXELAPI void sixel_wire_palette_ref(in wire_palette *palette);
SIXELAPI void sixel_wire_palette_unref(in wire_palette *palette);
SIXELAPI SIXELSTATUS sixel_wire_palette_get_view(
    in wire_palette const *palette, out wire_palette_view *view);

enum indexed_skip {
    SIXEL_INDEXED_PAINT = 0,
    SIXEL_INDEXED_KEEP = 1,
    SIXEL_INDEXED_KEEP_APPROXIMATE = 3
};

enum indexed_state {
    SIXEL_INDEXED_BUILDING = 0,
    SIXEL_INDEXED_COMPLETE = 1,
    SIXEL_INDEXED_FAILED = 2
};

struct indexed_frame_description {
    int width;
    int height;
    int encoded_width;
    int encoded_height;
    int encoded_x;
    int encoded_y;
    int origin_x;
    int origin_y;
    int plane_width;
    int plane_height;
    int keycolor;
    int keycolor_reserved;
    int transparent_background;
    wire_palette *palette;
};

struct indexed_frame_take_request {
    indexed_frame_description description;
    encode_identity identity;
    sixel_index_t *indexes;
    size_t indexes_size;
    unsigned char *skip;
    size_t skip_size;
};

struct indexed_rows_view {
    sixel_index_t const *indexes;
    unsigned char const *skip;
    size_t row_stride;
    int first_row;
    int rows;
};

/* new allocates BUILDING storage, including capacity for a final skip mask.
 * PaletteApply is its sole producer; no writable view escapes this API.
 * take accepts packed complete external data, validates all painted indexes
 * and mask codes, and transfers both allocations only on success. Both must
 * belong to the supplied allocator. It clears the transferred request pointers
 * on success; failure leaves the request and empty result slot unchanged.
 * take copies identity; stream zero is valid for standalone serialization.
 * Both constructors retain the palette and allocator. No RGB plane is made.
 *
 * Final skip includes alpha/key transparency and delta keeps. A NULL skip
 * view means all paint. Kept indexes need not name a palette entry and must
 * not be dereferenced. Dimensions must be positive and offsets nonnegative.
 * encoded_x/y place source pixels in the encoded raster;
 * its extents must contain that rectangle without overflow. Leading padding
 * and the final partial SIXEL band never become retained source pixels.
 * origin_x/y independently place source pixels within the retained plane.
 * Nonzero skip requires transparent_background. The session sets SIXEL P2=1
 * for that description; a clearing header cannot represent retained keeps.
 * Rows are published as an immutable contiguous prefix with release/acquire
 * ordering. Completion seals the image; failure never turns into completion.
 * get_rows returns SIXEL_FALSE for unpublished rows, BAD_ARGUMENT for invalid
 * ranges, and a failure for an aborted producer. The owner pins returned views.
 * Refcount operations are thread-safe; users pin resources until GPU/worker
 * completion, including failure and cancellation. */
SIXELAPI SIXELSTATUS sixel_indexed_frame_new(
    out indexed_frame **result,
    in indexed_frame_description const *description,
    in allocator *allocator);
SIXELAPI SIXELSTATUS sixel_indexed_frame_take(
    out indexed_frame **result,
    inout indexed_frame_take_request *request,
    in allocator *allocator);
SIXELAPI void sixel_indexed_frame_ref(in indexed_frame *image);
SIXELAPI void sixel_indexed_frame_unref(in indexed_frame *image);
SIXELAPI SIXELSTATUS sixel_indexed_frame_get_description(
    in indexed_frame const *image, out indexed_frame_description *description);
SIXELAPI SIXELSTATUS sixel_indexed_frame_get_identity(
    in indexed_frame const *image, out encode_identity *identity);
SIXELAPI SIXELSTATUS sixel_indexed_frame_get_rows(
    in indexed_frame const *image, in int first_row, in int rows,
    out indexed_rows_view *view);
SIXELAPI indexed_state sixel_indexed_frame_get_state(
    in indexed_frame const *image);

interface gpu_buffer;
interface gpu_device;

struct retained_plane_description {
    int width;
    int height;
    int color_definition;
    int colorspace;
};

struct retained_read_view {
    unsigned char const *rgb;
    unsigned char const *valid;
    size_t rgb_stride;
    size_t valid_stride;
    retained_plane_description description;
    uint64_t stream;
    uint64_t epoch;
    uint64_t sequence;
};

/* The buffers are borrowed through the read lease and belong to device.
 * They represent the full canvas, including pixels outside a partial frame.
 * Only the device runtime may access their native GPU handles. */
struct retained_gpu_read_view {
    gpu_buffer *rgb;
    gpu_buffer *valid;
    size_t rgb_stride;
    size_t valid_stride;
    retained_plane_description description;
};

/* worker_threads: Inclusive of the caller; 0 or 1 requests serial execution. */
struct retained_update_request {
    retained_read *baseline;
    indexed_frame *image;
    uint64_t sequence;
    int record_paint;
    int worker_threads;
};

/* worker_threads: Actual CPU commit participants, including the caller.
 * Zero denotes a completed GPU candidate published without a CPU traversal. */
struct retained_update_stats {
    size_t painted_pixels;
    int refinement_needed;
    unsigned char const *paint;
    size_t paint_size;
    int worker_threads;
};

enum retained_invalidation {
    SIXEL_RETAINED_SEEK = 0,
    SIXEL_RETAINED_GEOMETRY = 1,
    SIXEL_RETAINED_OUTPUT_FORMAT = 2,
    SIXEL_RETAINED_OUTPUT_FAILURE = 3,
    SIXEL_RETAINED_QUEUE_DISCARD = 4
};

/* Read leases pin the plane, not a copy. Their view stays valid until the last
 * read unref. Callers release all leases before committing or invalidating.
 * Updates retain their plane and indexed image, but do not retain the baseline
 * read lease. A plane holds only a non-owning reference to its active update.
 * Dropping an uncommitted update aborts it after its last resource user exits.
 * The optional paint view borrows the update and survives until its last unref.
 * It is frame-local, one byte per source pixel; when record_paint is zero,
 * stats.paint is NULL and paint_size is zero without a paint allocation.
 * Receipts are immutable and can only be obtained from a successful writer
 * end_image; they are output acceptance records, not presentation timestamps. */
SIXELAPI void sixel_retained_read_ref(in retained_read *read);
SIXELAPI void sixel_retained_read_unref(in retained_read *read);
SIXELAPI SIXELSTATUS sixel_retained_read_get_view(
    in retained_read const *read, out retained_read_view *view);
/* FEATURE_ERROR means this lease has no storage on the requested device.
 * No upload or device discovery occurs here. A successful view is read-only
 * until the lease is released; ownership never transfers to PaletteApply. */
SIXELAPI SIXELSTATUS sixel_retained_read_get_gpu_view(
    in retained_read const *read, in gpu_device *device,
    out retained_gpu_read_view *view);
SIXELAPI void sixel_retained_update_ref(in retained_update *update);
SIXELAPI void sixel_retained_update_unref(in retained_update *update);
SIXELAPI void sixel_stream_receipt_ref(in stream_receipt *receipt);
SIXELAPI void sixel_stream_receipt_unref(in stream_receipt *receipt);

/* configure is idle-only and allocates before changing the current plane.
 * An unchanged description preserves history. A changed description advances
 * epoch and invalidates every pixel; allocation failure preserves old state.
 * acquire_read also works on an invalid plane: valid bytes identify holes.
 *
 * begin_update validates geometry, output interpretation and baseline identity,
 * reserves all commit storage, retains the image and stamps its identity.
 * worker_threads is a nonnegative per-update ceiling including the caller;
 * 0 and 1 use the calling thread only. The component may use fewer threads
 * for small rectangles, unavailable thread support or worker-admission
 * failure. Worker resources are prepared here, before output, and may be
 * reused by later updates. Each commit uses the current execution policy;
 * idle workers do not retain a previous frame's accounting context.
 * It neither expands indexes nor changes committed RGB. Only one update can
 * be active per plane. A COMPLETE imported image must already carry the same
 * identity derived from this baseline and requested sequence; no published
 * rows may be rebound to a new identity. FAILED images are always rejected.
 *
 * commit requires a COMPLETE image, its matching receipt, drained consumers
 * and no read leases. It checks all preconditions before writing, then performs
 * either an allocation-free publication of a completed GPU candidate or
 * one allocation-free CPU traversal, optionally partitioned into disjoint rows:
 * skip keeps, expand painted indexes directly into retained RGB, and collect
 * statistics. Partial-band padding is excluded. All participants finish
 * before publishing sequence or stats; stats.worker_threads reports their
 * actual CPU count including the caller, or zero for GPU publication.
 * No worker creation or GPU command submission occurs in commit.
 * Success advances sequence even for an all-keep image. Repeated/stale commits
 * fail without mutation. It never waits for physical terminal writes.
 *
 * abort preserves the committed baseline. invalidate requires quiescence,
 * advances epoch, clears validity and makes delayed old receipts unusable. Neither
 * operation can undo partially emitted bytes. The session must invalidate and
 * discard dependent output after partial writes or transport queue loss.
 * Calls with live readers/producers return LOGIC_ERROR instead of waiting
 * under a gate. Cancellation first drains those users outside the component.
 *
 * set_device is idle-only. The same device preserves allocations and history;
 * NULL selects CPU storage. Migration preserves emitted RGB, validity and
 * stream identity, and allocation failure leaves the previous state intact.
 * The GPU path requires coherent host-visible storage and its retained-update
 * kernel; unsupported devices return FEATURE_ERROR before any output.
 * CPU and legacy fallback can read or update the same coherent storage while
 * GPU work is quiescent. No second authoritative history is maintained.
 *
 * stage requires a COMPLETE image. On GPU it builds a private full-canvas
 * candidate from committed history, final indexes/skip and emitted palette,
 * and collects paint statistics. Pixels outside a partial frame are preserved.
 * It retains resources and drains commands outside the component gate before
 * returning; body consumers may still read the immutable indexed image.
 * CPU staging is a no-op. A stage failure never changes committed history;
 * commit rejects missing or failed GPU staging. Abort discards the candidate.
 * commit publishes only with a matching successful receipt. The explicit
 * resolved-prefix contract below permits advance_resolved instead. */

/* begin_resolved_update is the explicit alternative to begin_update for
 * a controller that delivers every resolved frame in order, or discards the
 * dependent suffix and invalidates history. It has the same geometry,
 * identity, resource-reservation and lifetime rules as begin_update, but
 * its update is published by advance_resolved without a stream receipt.
 * A successful begin selects one publication contract for the current epoch.
 * Either begin rejects the other contract in that epoch before mutation.
 * Failed begin leaves the selection unchanged. Abort preserves the selection;
 * invalidate clears it. An update records which begin created it.
 *
 * commit accepts only begin_update transactions and still requires a matching
 * receipt. advance_resolved accepts only begin_resolved_update transactions;
 * it requires a COMPLETE image, matching stream/epoch/base identity, no read
 * leases or image users, and successful GPU staging when GPU-backed.
 * All validation precedes mutation. GPU publication swaps completed surfaces;
 * CPU publication uses the prepared allocation-free traversal. Success clears
 * the active update and advances sequence, including for an all-keep image.
 * Repeated/stale calls fail without mutation. Neither publication waits for
 * another frame, emits bytes, allocates storage or submits GPU work.
 *
 * Resolved publication describes the reconstructed canvas after the resolved
 * prefix, not callback acceptance or physical presentation. The controller
 * owns ordered delivery and invalidation after cancellation/output loss.
 * A read is immutable until its last unref. Two GPU surfaces remain sufficient
 * when the single ordered resolver releases its read before each advance;
 * output consumers retain only the independent indexed image and wire palette.
 * No queue, writer receipt or transport callback is stored by this contract.
 * This alternative does not weaken direct encoding's receipt validation. */

[component, refcounted]
[responsibility("maintain the retained image of one ordered output stream")]
[forbid_state("lookup_policy", "dither_policy", "sixel_runs")]
[forbid_state("terminal_callback", "transport_queue", "audio_clock")]
interface retained_plane {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS configure(in retained_plane_description const *description);
    [mutates]
    SIXELSTATUS set_device(in gpu_device *device);
    SIXELSTATUS acquire_read(out retained_read **read);
    [mutates]
    SIXELSTATUS begin_update(
        in retained_update_request const *request,
        out retained_update **update);
    [mutates]
    SIXELSTATUS stage(in retained_update *update);
    [mutates]
    SIXELSTATUS commit(
        in retained_update *update, in stream_receipt const *receipt,
        out retained_update_stats *stats);
    [mutates]
    SIXELSTATUS abort(in retained_update *update);
    [mutates]
    SIXELSTATUS invalidate(in retained_invalidation reason);

    /* Ordered resolved-prefix publication; see the contract above. */
    [mutates]
    SIXELSTATUS begin_resolved_update(
        in retained_update_request const *request,
        out retained_update **update);
    [mutates]
    SIXELSTATUS advance_resolved(
        in retained_update *update, out retained_update_stats *stats);
};

[classid("image/retained-plane")]
coclass retained_plane_component {
    [default] interface retained_plane;
};

struct writer_init_request {
    sixel_write_function fn_write;
    void *priv;
};

struct writer_controls {
    int has_8bit_control;
    int has_sixel_scrolling;
    int has_sdm_glitch;
    int skip_dcs_envelope;
    int skip_header;
    int penetrate_multiplexer;
};

struct writer_image_header {
    int parameter0;
    int parameter1;
    int parameter2;
    int parameter_count;
    int width;
    int height;
    int use_raster_attributes;
};

/*
 * sixel_writer serializes terminal-framing bytes to the callback supplied by
 * the legacy public sixel_output_t wrapper.  The callback is invoked while the
 * writer lock is held, so a callback must not re-enter the same writer.
 * begin_image copies identity; NULL denotes an untracked image. end_image
 * publishes a receipt only after the complete image has reached the configured
 * callback boundary successfully. It reserves receipt capacity before the
 * first image byte. A NULL receipt output requests no receipt. Failure never
 * publishes one. An untracked image does not allocate or return a receipt.
 * The session drains PaletteApply/body work before end_image.
 * Buffered callbacks accept ordered packets ahead of physical display; a
 * later discarded packet invalidates every dependent delta suffix.
 * abort_image best-effort closes framing without creating a receipt.
 */
[component, refcounted]
[responsibility("write framed terminal SIXEL bytes to callback-backed output")]
[forbid_state("image_pixels", "palette", "dither_policy")]
[forbid_state("encode_policy", "ormode", "transparent_policy")]
[forbid_state("gri_arg_limit", "body_run_state")]
interface sixel_writer {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS init(in writer_init_request const *request);
    [mutates]
    SIXELSTATUS set_controls(in writer_controls const *controls);
    SIXELSTATUS get_controls(out writer_controls *controls);
    SIXELSTATUS begin_image(
        in writer_image_header const *header,
        in encode_identity const *identity);
    SIXELSTATUS write(in char const *data, in int size);
    SIXELSTATUS end_image(out stream_receipt **receipt);
    SIXELSTATUS abort_image();
};

[classid("io/sixel-writer")]
coclass sixel_writer_component {
    [default] interface sixel_writer;
};

struct encoder_core_options {
    int has_gri_arg_limit;
    int encode_policy;
    int ormode;
    int emit_palette;
};

/* A body sink accepts all bytes or reports failure. The session owns context
 * through finish/abort; no terminal/framing state belongs to the body encoder.
 * This callback is per byte chunk, never per pixel. */
typedef SIXELSTATUS (*sixel_body_write_function_t)(
    char const *data, size_t size, void *context);

struct body_byte_sink {
    sixel_body_write_function_t write;
    void *context;
};

struct encoder_core_prepare_request {
    indexed_frame *image;
    encoder_core_options options;
    body_byte_sink sink;
    int threads;
    int queue_bands;
    int worker_capacity; /* Zero uses threads; tail may grow after COMPLETE. */
    timeline_logger *logger; /* Borrowed through finish/abort. */
};

/*
 * prepare retains image, validates options and reserves controller scratch
 * without emitting bytes. Worker fragments can allocate during consumption.
 * An instance owns at most one active image. consume accepts
 * a monotonically growing count of published source rows; complete six-row
 * encoded bands can run immediately, including before PaletteApply finishes.
 * Source readiness is translated through encoded_y; empty leading bands do
 * not require source rows. The last partial band is accepted only when all
 * source rows have been published.
 * Workers may complete out of order; emitted body bytes remain ordered.
 * finish requires COMPLETE input and all rows consumed, then drains workers.
 * abort cancels/drains workers without framing or retained-state mutation.
 * Both release the image/sink borrow; failed jobs must be aborted before reuse.
 * Final decoded coverage must equal the indexed result, including skip holes.
 * Wire palette fields are serialized directly; no re-quantization occurs here.
 * Highcolor's changing palettes stay in the legacy public adapter until a
 * separate indexed representation can express them without losing semantics.
 */
[component, refcounted]
[responsibility("serialize published indexed rows into SIXEL body bytes")]
[forbid_state("callback_output", "dcs_envelope", "terminal_multiplexer", "image_file_output", "clipboard_output")]
[forbid_state("lookup_policy", "dither_policy", "retained_plane")]
interface encoder_core {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in encoder_core_prepare_request const *request);
    [mutates]
    SIXELSTATUS consume(in int published_rows);
    [mutates]
    SIXELSTATUS finish();
    [mutates]
    SIXELSTATUS abort();
};

[classid("codec/encoder-core")]
coclass encoder_core_component {
    [default] interface encoder_core;
};

[classid("codec/encoder-core.normal")]
coclass encoder_core_normal_component {
    [default] interface encoder_core;
};

[classid("codec/encoder-core.ormode")]
coclass encoder_core_ormode_component {
    [default] interface encoder_core;
};

[component, refcounted]
[responsibility("create components by class id")]
[alias(sixel_factory_t)]
interface factory {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    SIXELSTATUS create(
        in char const *class_name,
        in allocator *allocator,
        out void **object);
};

[serviceid("services/factory")]
coclass factory_component {
    [default] interface factory;
};

/*
 * getservice("services/factory", &factory) returns the process-wide factory
 * service with interface-level ownership.  Release it with factory->vtbl->unref
 * when the caller is done with the service pointer.
 */
SIXELAPI SIXELSTATUS sixel_components_getservice(
    in char const *name,
    out void **service);

[alias(sixel_palette_t)]
interface palette;

struct palette_entries_request {
    unsigned char const *entries;
    unsigned int colors;
    int depth;
};

struct palette_float32_entries_request {
    float const *entries;
    unsigned int colors;
    int depth;
};

/* GPU policy is request-local; zero-initialized requests stay on CPU. */
struct palette_generate_request {
    void const *data;
    unsigned int length;
    int pixelformat;
    unsigned int requested_colors;
    int method_for_largest;
    int method_for_rep;
    int quality_mode;
    int force_palette;
    int use_reversible;
    int quantize_model;
    int final_merge_mode;
    int lut_policy;
    int prefer_float32;
    int gpu_policy;
};

struct palette_entries_view {
    unsigned char *entries;
    size_t entries_size;
    unsigned int entry_count;
    int depth;
};

struct palette_float32_entries_view {
    float *entries;
    size_t entries_size;
    unsigned int entry_count;
    int depth;
};

struct palette_metadata {
    unsigned int entry_count;
    unsigned int requested_colors;
    unsigned int original_colors;
    int depth;
    int float_depth;
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 palette objects.
 * - Callers release with palette->vtbl->unref(palette).
 *
 * Encapsulation path:
 * - The palette object owns generated palette entries and metadata.
 * - Quantizer options are request-local generation inputs.
 * - Lookup policy caches belong to the dither/apply context.
 */
[component, refcounted]
[responsibility("own palette entries and quantization metadata only")]
[forbid_state("lookup_policy", "dither_policy", "input_pixels", "method_for_largest", "method_for_rep", "quality_mode", "force_palette", "use_reversible", "quantize_model", "final_merge_mode", "lut_policy")]
[alias(sixel_palette_t)]
interface palette {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(entries_view, float32_entries_view)]
    SIXELSTATUS init_entries(in palette_entries_request const *request);
    [mutates, invalidates(float32_entries_view)]
    SIXELSTATUS init_entries_float32(
        in palette_float32_entries_request const *request);
    [mutates, invalidates(entries_view, float32_entries_view)]
    SIXELSTATUS generate(in palette_generate_request const *request);
    [const, borrows(entries_view)]
    SIXELSTATUS get_entries(out palette_entries_view *view);
    [const, borrows(float32_entries_view)]
    SIXELSTATUS get_entries_float32(out palette_float32_entries_view *view);
    [const]
    SIXELSTATUS get_metadata(out palette_metadata *metadata);
};

[classid("quant/palette")]
coclass palette_component {
    [default] interface palette;
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 policy objects.
 * - Callers release with policy->vtbl->unref(policy).
 *
 * Creation path:
 * - sixel_lookup_policy_select_name(select_request)
 * - services/factory -> create("lookup/...", allocator, &policy)
 * - factory resolves class ids via generated classid registry
 * - policy->prepare(request)
 *
 * Reuse path:
 * - Callers may pass a prepared policy object through
 *   request.reuse_policy/request.reuse_policy_slot.
 * - request.parallel_dither_active carries execution context so policies can
 *   disable non-thread-safe cache paths without relying on global state.
 * - request.shared_instance_enabled stores the effective shared-instance
 *   preference resolved by the caller (CLI override or environment default).
 * - Lookup option pairs carry both a value and an override flag.  A zero
 *   override lets direct component users retain registry-backed environment
 *   defaults without teaching backends about environment variable names.
 * - FHEDT retains immutable grid references without consuming reuse_policy;
 *   reuse_policy_slot may be NULL. Each handle keeps its own cache settings.
 * - Implementations may choose to ignore reuse hints.
 *
 * Mapping:
 * - map_pixel_hint(pixel, hint) returns exactly what map_pixel(pixel)
 *   returns.  hint is a caller-owned guess, typically the index mapped for
 *   the previous pixel of the same scan; a negative hint means none.  It may
 *   only change the work done, never the result, so an implementation
 *   without a use for it forwards to map_pixel().
 * - map_pixels maps count samples in their supplied order, exactly as repeated
 *   map_pixel calls on the same prepared state. Strides are signed byte/input
 *   and index/output offsets, permitting reverse rows without reordering
 *   approximate caches. Zero count touches neither buffer. Buffers must not
 *   overlap; each addressed sample and output must be valid. Implementations
 *   without a bulk kernel use sixel_lookup_policy_map_pixels_default.
 * - workspace_size is optional (NULL means zero). The caller may allocate
 *   that many zeroed bytes, aligned as malloc, for map_pixels. This scratch
 *   belongs to one caller and one unchanged prepared policy; never share it
 *   concurrently or retain it across prepare. It owns no resources and can
 *   be freed directly by its allocator. NULL scratch always remains valid,
 *   including allocation failure; it changes only performance.
 * - Mapping methods are const. A prepared policy may memoize results only
 *   in caches safe for concurrent callers that cannot change a result;
 *   it keeps no scan history.  Continuity across pixels belongs to the
 *   caller, which passes it back as hint.
 */
interface lookup_policy;

struct lookup_policy_select_request {
    int method_for_diffuse;
    unsigned char const *palette;
    int depth;
    int reqcolor;
    int optimize_lookup;
    int lut_policy;
    int pixelformat;
};

/* Resolved lookup semantics, without palette ownership, environment flags,
 * CPU construction controls or mutable query caches. GPU-only planning uses
 * this snapshot without constructing a CPU table. FHEDT weights contain the
 * resolved positive ratios; byte execution requires equal axis weights. */
struct lookup_policy_configuration {
    int kind;
    int pixelformat;
    int fhedt_resolution;
    int fhedt_refine;
    int fhedt_use_dist2;
    int fhedt_use_cache;
    double fhedt_weights[3];
};

struct lookup_policy_prepare_request {
    unsigned char const *palette;
    float const *palette_float;
    int depth;
    int float_depth;
    int reqcolor;
    int pixelformat;
    int parallel_dither_active;
    int shared_instance_enabled;
    int lut_policy_packing;
    int lut_policy_packing_override;
    int fhedt_resolution;
    int fhedt_resolution_override;
    int fhedt_refine;
    int fhedt_refine_override;
    double fhedt_weights[3];
    int fhedt_weights_override;
    int fhedt_shared;
    int fhedt_shared_override;
    int fhedt_use_dist2;
    int fhedt_use_dist2_override;
    int fhedt_use_cache;
    int fhedt_use_cache_override;
    unsigned int fhedt_tile_xy;
    int fhedt_tile_xy_override;
    unsigned int fhedt_tile_depth;
    int fhedt_tile_depth_override;
    int fhedt_first_touch;
    int fhedt_first_touch_override;
    int fhedt_pin_threads;
    int fhedt_pin_threads_override;
    lookup_policy *reuse_policy;
    lookup_policy **reuse_policy_slot;
    allocator *allocator;
};

typedef int lookup_policy_result;

[component, refcounted]
[responsibility("map pixels to palette indexes")]
[forbid_state("image_pixels", "output_pixels")]
interface lookup_policy {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in lookup_policy_prepare_request const *request);
    [const] lookup_policy_result map_pixel(
        in unsigned char const *pixel);
    [const] lookup_policy_result map_pixel_hint(
        in unsigned char const *pixel,
        in int hint);
    [const] void map_pixels(
        in unsigned char const *pixels,
        in size_t count,
        in int pixel_stride,
        out sixel_index_t *result,
        in int result_stride,
        inout void *workspace);
    [const] size_t workspace_size();
    /* SIXEL_LUT_POLICY_* algorithm identity; negative for custom policies.
     * Execution planners use this description without inspecting vtables. */
    [const] int get_kind();
    /* Optional for policies without configurable GPU semantics. FHEDT
     * returns its successful preparation snapshot; an unprepared policy
     * returns SIXEL_LOGIC_ERROR. The caller owns the returned value. */
    [const] SIXELSTATUS get_configuration(
        out lookup_policy_configuration *configuration);
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 policy objects.
 * - Callers release with policy->vtbl->unref(policy).
 *
 * Creation path:
 * - sixel_dither_policy_select_name(select_request)
 * - services/factory -> create("dither/...", allocator, &policy)
 * - policy->prepare(request)
 */
interface dither_policy;

struct dither_policy_select_request {
    int method_for_diffuse;
    int ncolors;
    int pixelformat;
};

/* Packed selection uses bit (y * columns + x), low bit first in each word.
 * Without tiling, cell edges are floor(i * extent / grid). Tiling requires
 * a 64x64 grid and repeats in frame-local pixel coordinates, matching the
 * current refresh mask. It is not shifted by the retained-plane origin.
 * Coordinates outside width/height and NULL words select no cells.
 * Selected cells use min(selected_threshold, frame threshold).
 * The caller owns this immutable map through run and all its workers. */
struct delta_threshold_map {
    uint32_t const *words;
    size_t word_count;
    unsigned int columns;
    unsigned int rows;
    int width;
    int height;
    int tiled;
    unsigned int selected_threshold;
};


/* Select the sample used by delta keep decisions. TARGET preserves each
 * policy's existing target; for A/X/blue-noise it is the unperturbed sample.
 * QUERY uses the positional lookup input after perturbation and the policy's
 * normal precision/clamp rules. Both early and post-lookup gates use it.
 * Other policies keep their existing corrected-target semantics. This never
 * changes lookup, emitted palette colors, retained RGB, or error propagation.
 * Zero-initialized execution snapshots preserve the TARGET contract. */
enum delta_compare {
    SIXEL_DELTA_COMPARE_TARGET = 0,
    SIXEL_DELTA_COMPARE_QUERY = 1
};

/* Resolved values, with no environment precedence flags or frame pointers.
 * prepare copies these settings; callers may release or change their source
 * configuration afterwards. apply never reads a mutable legacy handle. */
enum lso2_gain {
    SIXEL_LSO2_GAIN_STANDARD = 0,
    SIXEL_LSO2_GAIN_SMALL_ERROR = 1
};

struct dither_policy_options {
    int method_for_diffuse;
    int ncolors;
    int keycolor_reserved;
    int use_rgb101_palette;
    int clamp_policy;
    double clamp_threshold;
    double diffusion_deadzone;
    float diffusion_perturb;
    int diffusion_perturb_seed;
    float a_dither_strength;
    float x_dither_strength;
    float bluenoise_strength;
    int bluenoise_phase_x;
    int bluenoise_phase_y;
    int bluenoise_channel_rgb;
    int bluenoise_size;
    float bluenoise_gradient_factor;
    lso2_gain lso2_gain;
};

struct dither_policy_prepare_request {
    dither_policy_options options;
    int method_for_scan;
    int pixelformat;
};

/* All execution views are borrowed through apply completion. Parallel bands
 * use distinct scratch and disjoint output rows. A row callback may originate
 * from any worker; PaletteApply serializes contiguous-prefix publication. */
typedef void (*sixel_dither_row_ready_function_t)(void *context, int row);

struct dither_execution {
    palette *working_palette;
    allocator *allocator;
    sixel_index_t *indexes;
    int width;
    int height;
    unsigned char const *transparent_mask;
    size_t transparent_size;
    int keycolor;
    unsigned char const *retained_rgb;
    size_t retained_rgb_size;
    unsigned char const *retained_valid;
    size_t retained_valid_size;
    int plane_width;
    int plane_height;
    int origin_x;
    int origin_y;
    int delta_enabled;
    unsigned int delta_threshold;
    int delta_metric;
    int delta_error_mode;
    int delta_keycolor;
    int delta_rgb101;
    int delta_hls;
    unsigned char const *hls_rgb;
    unsigned int hls_count;
    delta_threshold_map selection;
    unsigned char *skip;
    size_t skip_size;
    unsigned char const *gradient;
    size_t gradient_size;
    int gradient_width;
    int gradient_height;
    sixel_dither_row_ready_function_t row_ready;
    void *row_context;
    timeline_logger *logger;
    int band_height;
    delta_compare delta_compare;
};

struct dither_policy_apply_request {
    sixel_index_t *result;
    unsigned char *data;
    int width;
    int height;
    int band_origin;
    int output_start;
    int depth;
    unsigned char *palette;
    lookup_policy *lookup_policy;
    dither_execution const *execution;
};

typedef int dither_policy_supports_parallel_result;

[component, refcounted]
[responsibility("apply dithering from pixels and lookup policy")]
[forbid_state("input_owner", "output_owner")]
interface dither_policy {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in dither_policy_prepare_request const *request);
    [const] SIXELSTATUS get_configuration(
        out dither_policy_prepare_request *configuration);
    SIXELSTATUS apply(in dither_policy_apply_request const *request);
    [const] dither_policy_supports_parallel_result supports_parallel_bands();
};


struct palette_apply_delta {
    int enabled;
    int error_mode;
    unsigned int threshold;
    int metric;
    delta_threshold_map selection;
    delta_compare compare;
};

/* Lookup preparation consumes a palette view only for this call. Successful
 * preparers copy or retain a frozen representation; later palette mutation
 * cannot change the returned lookup. Query settings are already resolved and
 * owned by the concrete preparer. No environment lookup occurs here.
 * ncolors is the searchable prefix, in 1..palette.entry_count. The caller
 * excludes any reserved transparency slot; lookup must not add it back. */
/* Query precision is independent of source-image storage. FRACTIONAL uses
 * finite float coordinates in the closed byte-code cube [0,255]^3. It is
 * not a float32 image/working-colorspace capability. Providers explicitly
 * accept this contract or return FEATURE_ERROR before output; a byte-only
 * provider must not silently round a fractional query. Zero keeps the
 * existing integer-query contract. */
enum gpu_lookup_query_kind {
    SIXEL_GPU_LOOKUP_QUERY_BYTE = 0,
    SIXEL_GPU_LOOKUP_QUERY_FRACTIONAL = 1
};

/* allow_batch opts into tile-batch execution as well as point queries.
 * Zero requires point execution; CPU preparation ignores this capability. */
struct lookup_execution_request {
    palette *working_palette;
    unsigned int ncolors;
    int pixelformat;
    int colorspace;
    int parallel_dither_active;
    gpu_lookup_query_kind query_kind;
    int allow_batch;
};

/* CPU and GPU preparation are separate capabilities. Creating either
 * preparer does not build a CPU tree, GPU table or memo. A prepared CPU
 * lookup can be adapted here without surrendering its resolved settings. */
[component, refcounted]
[responsibility("prepare CPU lookup from resolved policy settings")]
[forbid_state("image_pixels", "output_pixels", "gpu_resources")]
interface lookup_preparer {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const]
    SIXELSTATUS prepare(in lookup_execution_request const *request,
        out lookup_policy **lookup);
};

/* GPU allocation belongs to the device runtime. Providers retain buffers
 * through this interface and never cast them to another owner's storage.
 * Only the matching runtime implementation accesses its native GPU handle. */
[component, refcounted]
[responsibility("own one device-local allocation")]
[forbid_state("lookup_kind", "palette_identity", "frame_history")]
interface gpu_buffer {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const] size_t size();
    /* Coherent host-visible storage, or FEATURE_ERROR. The mapping borrows
     * the buffer and remains stable until its last unref. The owner must
     * exclude conflicting GPU/CPU access and wait for GPU completion before
     * reading device writes; mapping alone provides no synchronization. */
    [const, borrows(shared_memory)]
    SIXELSTATUS shared_memory(out void **memory);
};

/* This is a cached device capability, not a discovery or fallback service.
 * Backend-specific execution uses the same retained device identity. Device
 * discovery happens before injection, never in a lookup query. Format names
 * describe a program ABI, not an algorithm or policy allowlist. */
[component, refcounted]
[responsibility("provide allocation on one selected GPU device")]
[forbid_state("lookup_kind", "palette_identity", "frame_history")]
interface gpu_device {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const, borrows(program_format)]
    char const *program_format();
    SIXELSTATUS create_buffer(in size_t bytes, out gpu_buffer **buffer);
};

/* Groups and local threads describe one builder dispatch. Commands for
 * successive passes are ordered with GPU write/read visibility. The runtime
 * validates dimensions and pipeline limits before accepting any output. */
struct gpu_lookup_build_pass {
    char const *entry_point;
    size_t groups[3];
    size_t threads[3];
};

/* Optional tile-batch query entry for "metal.lookup-rgb8.v1". This is a
 * dispatch capability, not a lookup algorithm. Only an opted-in FRACTIONAL
 * request may receive it. A point-only caller receives FEATURE_ERROR when
 * the provider needs collective execution; no implicit per-point substitute.
 *
 * Each group owns one nonoverlapping tile. Groups cover ceil(width/tile[0])
 * by ceil(height/tile[1]); local threads use the declared dimensions. The
 * runtime checks positive dimensions, overflow and device pipeline limits.
 * Padding lanes participate in collectives but never read/write out of range.
 *
 * The kernel uses builder bindings 0..3 unchanged, plus:
 *   4: device const float4 *queries (row-major width * height)
 *   5: device uint *indexes (same layout)
 *   6: constant uint2 &extent (width, height)
 * queries.xyz is finite in [0,255]^3 for active entries; w is 1 for active
 * or 0 for inactive. Inactive xyz is unspecified and excluded from bounds.
 * Every in-range index is written: an active result is < ncolors under the
 * policy's search semantics; inactive entries contain ncolors. The consumer
 * validates active indexes before using them. Invalid results fail the run.
 *
 * Query/index buffers belong to the dither runtime and are borrowed only
 * for the dispatch. The provider owns grouping, candidate reduction and
 * search. It never receives source pixels, residuals or retained history.
 * Commands order query generation, lookup and result consumption with GPU
 * write/read visibility. No CPU readback is part of this ABI. */
struct gpu_lookup_batch_dispatch {
    char const *entry_point;
    size_t tile[2];
    size_t threads[3];
};

/* Frozen program description borrowed from one retained plan. Chunk strings
 * are NUL-terminated; chunk_count is explicit. The runtime assembles/compiles
 * these chunks but does not inspect their algorithm or private table layout.
 * It keys compiled programs by full source and ABI/specialization inputs,
 * never by a policy name alone. Entry points are local to this program.
 *
 * The initial ABI is "metal.lookup-rgb8.v1". It has one private byte-addressed
 * workspace. Builders use palette at buffer 0, uint32 color count at buffer 1,
 * opaque constants at buffer 2, writable workspace at buffer 3. Constants
 * are copied verbatim; only this program's code interprets their contents.
 * A zero constant size uses a harmless zero word for binding; nonzero size
 * requires non-NULL storage. Workspace size is positive and device-valid.
 * Every builder writes all locations subsequently read by query or builders;
 * newly allocated storage is not assumed zero. No implicit clear dispatch.
 *
 * The query entry has the Metal signature
 *   uint lookup_rgb8(uchar3 query, constant uchar *palette, uint ncolors,
 *       constant uchar *configuration, device const uchar *workspace);
 * The composer calls it directly from its fused per-pixel kernel. It returns
 * an ordinary palette index under the concrete policy's declared semantics;
 * transparency and delta keep are handled by the application component.
 * It does not read pixel position, previous queries or retained history.
 * Image storage remains RGB8. A non-NULL batch descriptor replaces these
 * point entries with the explicitly opted-in tile-batch ABI.
 *
 * Providers own builders, constants, workspace layout and query code together.
 * VP-tree and ordered maintain separate implementations and caches. There is
 * no shared distance-row, candidate-builder or search service. */
/* Query kind is an ABI specialization and part of cache identity.
 * BYTE exposes the uchar3 entry above. FRACTIONAL additionally exposes
 * uint lookup_rgb8_fractional(float3 query, constant uchar *palette,
 *     uint ncolors, constant uchar *configuration,
 *     device const uchar *workspace);
 * This entry follows the provider's declared search semantics on the
 * continuous byte-code cube. The original BYTE entry remains intact.
 * A consumer verifies this field and the selected execution form before
 * compiling or submitting work. Point/batch form is part of plan identity. */
struct gpu_lookup_program_view {
    char const *program_format;
    char const *logical_name;
    char const * const *chunks;
    size_t chunk_count;
    unsigned char const *palette;
    size_t palette_size;
    unsigned int ncolors;
    void const *constants;
    size_t constants_size;
    size_t workspace_size;
    gpu_lookup_build_pass const *build_passes;
    size_t build_pass_count;
    gpu_lookup_query_kind query_kind;
    gpu_lookup_batch_dispatch const *batch;
};

struct gpu_lookup_binding_view {
    gpu_buffer *workspace;
    int needs_build;
};

/* A successful begin gives the caller one exclusive lease. Bindings and the
 * frozen program must remain alive until encoded work has completed/drained.
 * workspace is borrowed until finish; only the GPU builder writes it.
 *
 * finish is called exactly once, also on cancellation or encoding failure
 * before submission. SIXEL_OK means every build and consuming command has
 * completed successfully. Any other status prevents cache publication; an
 * attempted in-place build invalidates its overwritten cache identity.
 * A failed, unsubmitted invocation cannot publish successful construction.
 * finish is not a submission, wait, fallback or retained-history operation.
 * unref does not implicitly signal completion or release in-flight storage.
 * get_view/finish after finish return SIXEL_LOGIC_ERROR. */
[component, refcounted]
[responsibility("lease one lookup workspace until GPU completion")]
[forbid_state("terminal_callback", "frame_history", "submission_queue")]
interface gpu_lookup_binding {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const, borrows(binding_view)]
    SIXELSTATUS get_view(out gpu_lookup_binding_view *view);
    [mutates, invalidates(binding_view)]
    SIXELSTATUS finish(in SIXELSTATUS outcome);
};

/* A plan retains its device and freezes palette, configuration and program.
 * Its owner may reuse policy-private cache storage, but begin must pin the
 * correct identity until finish. Another live plan may never overwrite it.
 * Exact palette bytes/order/count and result-affecting settings determine
 * reuse; palette pointer equality is insufficient. Device identity is part
 * of resource compatibility. No peer policy's cache is inspected.
 *
 * A second begin on an unfinished plan returns SIXEL_LOGIC_ERROR. Across
 * plans, a provider must use another allocation or synchronize its cache
 * before granting a lease. It cannot require the caller to know cache locks.
 * A binding retains the plan; releasing the preparer never breaks the plan.
 * describe has no allocation, command submission or device discovery effect.
 * begin failures are runtime failures, not pre-output unsupported results. */
[component, refcounted]
[responsibility("own one frozen GPU palette lookup program")]
[forbid_state("image_pixels", "output_pixels", "dither", "frame_history")]
interface gpu_lookup_plan {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const, borrows(program_view)]
    SIXELSTATUS describe(out gpu_lookup_program_view *view);
    [mutates]
    SIXELSTATUS begin(out gpu_lookup_binding **binding);
};

/* Preparation is a consumer-owned capability. Each implementation validates
 * its own resolved settings and request representation. Success transfers
 * one retained plan; failures leave *plan NULL and publish no mutable state.
 * SIXEL_FEATURE_ERROR means unsupported before output. Other failures remain
 * failures and must not be disguised as a reason to retry on the CPU.
 * The composer validates/compiles the returned program during preparation.
 * It never branches on logical_name or the concrete policy's enum value. */
[component, refcounted]
[responsibility("prepare GPU lookup from resolved policy settings")]
[forbid_state("image_pixels", "output_pixels", "dither", "frame_history")]
interface gpu_lookup_preparer {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const]
    SIXELSTATUS prepare(in lookup_execution_request const *request,
        in gpu_device *device, out gpu_lookup_plan **plan);
};

/* A GPU dither receives lookup as an independent preparation capability.
 * It selects the query precision required by its own arithmetic, freezes a
 * lookup plan, and compiles before prepare succeeds. It never branches on a
 * lookup policy name, inspects its workspace, or creates a CPU lookup.
 * The working and emitted palettes have equal counts; a dither declares
 * which representation its lookup and residual use. Each diffusion method's
 * GPU dither uses the emitted RGB8 entries, excluding the reserved
 * transparency entry. */
struct gpu_dither_prepare_request {
    palette *working_palette;
    gpu_lookup_preparer *lookup;
    gpu_device *device;
    indexed_frame_description output;
    int pixelformat;
    int colorspace;
    int scan;
};

/* All views are borrowed until run returns after draining GPU work. Result
 * is BUILDING and matches the prepared description. The source and baseline
 * are immutable. Only result indexes/final skip/RGB may be written; this
 * component does not publish rows, seal result, or commit retained history.
 * PaletteApply owns publication, cancellation outcome and final sealing. */
struct gpu_dither_run_request {
    frame *source;
    retained_read *baseline;
    indexed_frame *result;
    palette_apply_delta delta;
    timeline_logger *logger;
    sixel_cancel_function cancel;
    void *cancel_context;
};

/* Optional deferred execution separates a history-independent solve from
 * ordered history resolution. The solve request has no baseline or result:
 * it cannot bind an encode identity, publish pixels or pin retained state.
 * Source, logger and callback are borrowed only through the synchronous
 * solve call. A returned solution owns all state needed by resolve. */
struct gpu_dither_solve_request {
    frame *source;
    timeline_logger *logger;
    sixel_cancel_function cancel;
    void *cancel_context;
};

struct gpu_dither_resolve_request {
    retained_read *baseline;
    indexed_frame *result;
    palette_apply_delta delta;
    timeline_logger *logger;
    sixel_cancel_function cancel;
    void *cancel_context;
};

/* A solution owns immutable per-image state and its frozen palette/device.
 * It has no retained lease, active lookup binding, writer or source borrow.
 * get_description borrows its palette until the last solution unref.
 *
 * resolve borrows its request through GPU drain. The BUILDING result must
 * match the description, and a retained update must already bind identity
 * when delta is enabled. Missing baseline disables keeps, not transparency.
 * The method performs no lookup acquisition or lookup query. It uses only
 * the completed solution and the supplied current retained view.
 *
 * Argument rejection before execution preserves READY. Once execution
 * starts, success, cancellation and runtime failure consume the solution;
 * repeated or concurrent execution returns LOGIC_ERROR. Only unpublished
 * indexes/skip may be written. Publication and sealing belong to PaletteApply.
 * Source and baseline never change. Every return drains submitted work.
 * Last unref of a READY solution only discards private state. */
[component, refcounted]
[responsibility("resolve one completed GPU dither against current history")]
[forbid_state("terminal_callback", "transport_queue", "retained_owner")]
[forbid_state("active_lookup_binding", "borrowed_source")]
interface gpu_dither_solution {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const, borrows(description)]
    SIXELSTATUS get_description(out indexed_frame_description *description);
    [mutates]
    SIXELSTATUS resolve(in gpu_dither_resolve_request const *request);
};

/* This retained capability freezes one prepared plan. solve executes on the
 * producer thread and returns only after GPU completion and exactly-once
 * lookup lease finish. Success transfers one retained solution; failures
 * leave *solution NULL and never leave GPU users or lookup bindings live.
 * Image scratch and solution capacity were reserved by prepare; solve does
 * not compile programs or allocate image-sized storage. Small command/lease
 * records follow their existing runtime contracts.
 *
 * One plan permits one live operation/solution. Monolithic run and deferred
 * solve are mutually exclusive until the solution is released. Distinct
 * prepared plans may execute on separate threads. Releasing the preparer or
 * capability does not invalidate a returned solution. There is no temporal
 * error state and no global queue or scheduling service in this component. */
[component, refcounted]
[responsibility("solve prepared GPU dither without retained history")]
[forbid_state("retained_pixels", "terminal_callback", "transport_queue")]
interface gpu_dither_deferred {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS solve(in gpu_dither_solve_request const *request,
        out gpu_dither_solution **solution);
};

/* The plan owns frozen configuration, compiled programs, scratch capacity
 * and retained device/lookup objects. Scratch is private to each invocation
 * or exclusively leased through completion; it is initialized on every run
 * and carries no residual between images. Image scratch allocation, program
 * compilation and admission occur during preparation before output. Lookup
 * lease records follow the provider binding contract. Runtime failures are not retry
 * signals. Every begun lookup lease is finished exactly once after draining,
 * including cancellation and failed command encoding or execution.
 *
 * The concrete dither owns its pass ordering and state transitions. Backend
 * resource services expose device/buffer operations, not shared candidate,
 * distance, or search algorithms. No CPU implementation is implied. */
[component, refcounted]
[responsibility("execute one prepared GPU dither into unpublished pixels")]
[forbid_state("terminal_callback", "transport_queue", "retained_owner")]
interface gpu_dither_plan {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS run(in gpu_dither_run_request const *request);
    /* Return a retained optional capability, or FEATURE_ERROR with NULL.
     * Admission was frozen by prepare. No allocation, probing, compilation,
     * command submission or current-plan mutation occurs in this getter. */
    [const]
    SIXELSTATUS get_deferred(out gpu_dither_deferred **deferred);
};

/* configure copies resolved settings, preserving them on failure. A caller
 * serializes configure/prepare; reconfiguration cannot change existing plans.
 * get_configuration has no device discovery, allocation or compilation
 * effect; an unconfigured preparer returns LOGIC_ERROR. prepare returns
 * one retained plan, or leaves *plan NULL. FEATURE_ERROR denotes unsupported
 * input/device/lookup before output; all other errors remain failures.
 * Releasing this preparer never invalidates a returned plan. */
[component, refcounted]
[responsibility("prepare GPU dither from resolved method settings")]
[forbid_state("image_pixels", "output_pixels", "frame_history")]
interface gpu_dither_preparer {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS configure(in dither_policy_prepare_request const *request);
    [const] SIXELSTATUS get_configuration(
        out dither_policy_prepare_request *configuration);
    [const]
    SIXELSTATUS prepare(in gpu_dither_prepare_request const *request,
        out gpu_dither_plan **plan);
};

[classid("dither/lso2.gpu")]
coclass dither_policy_lso2_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/fs.gpu")]
coclass dither_policy_fs_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/atkinson.gpu")]
coclass dither_policy_atkinson_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/jajuni.gpu")]
coclass dither_policy_jajuni_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/stucki.gpu")]
coclass dither_policy_stucki_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/burkes.gpu")]
coclass dither_policy_burkes_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/sierra1.gpu")]
coclass dither_policy_sierra1_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/sierra2.gpu")]
coclass dither_policy_sierra2_gpu {
    [default] interface gpu_dither_preparer;
};

[classid("dither/sierra3.gpu")]
coclass dither_policy_sierra3_gpu {
    [default] interface gpu_dither_preparer;
};

/* Preparers carry already resolved settings. The composition root supplies
 * the CPU/GPU capabilities of the same selected policy. A NULL capability is
 * unavailable, not a request for enum-based discovery. At least one preparer
 * is required. A GPU preparer requires the selected runtime device.
 * Legacy lookup_kind/configuration and already prepared CPU objects are
 * adapted before this boundary, never inspected by PaletteApply. */
struct palette_apply_prepare_request {
    palette *working_palette;
    lookup_preparer *cpu_lookup;
    gpu_lookup_preparer *gpu_lookup;
    gpu_device *device;
    dither_policy *dither;
    indexed_frame_description output;
    int pixelformat;
    int colorspace;
    int scan;
    int worker_threads;
    int band_height;
    int band_overlap;
    int gpu_policy;
    size_t gpu_auto_threshold;
    gpu_dither_preparer *gpu_dither;
};

/* Called serially by the producer with a monotonically increasing ready-row
 * prefix. Publication precedes the callback. The callback can enqueue body
 * work; its failure stops application and seals the indexed image FAILED.
 * It must not re-enter PaletteApply, mutate its plans or commit history. */
typedef SIXELSTATUS (*sixel_indexed_rows_ready_function_t)(
    indexed_frame *image, int published_rows, void *context);

struct palette_apply_run_request {
    frame *source;
    retained_read *baseline;
    indexed_frame *result;
    palette_apply_delta delta;
    timeline_logger *logger; /* Borrowed through run. */
    sixel_indexed_rows_ready_function_t rows_ready;
    void *rows_context;
    sixel_cancel_function cancel;
    void *cancel_context;
};

/* Deferred application accepts no baseline during solve. The producer
 * borrows source/logger/cancellation only until solve returns. A solution
 * owns the frozen output description and all completed application state. */
struct palette_apply_solve_request {
    frame *source;
    timeline_logger *logger;
    sixel_cancel_function cancel;
    void *cancel_context;
};

struct palette_apply_resolve_request {
    retained_read *baseline;
    indexed_frame *result;
    palette_apply_delta delta;
    timeline_logger *logger;
    sixel_cancel_function cancel;
    void *cancel_context;
};

/* The solution retains its validation context and concrete GPU solution.
 * Neither get_description nor an idle solution acquires retained history.
 * The returned description borrows its immutable palette through unref.
 *
 * resolve validates geometry/palette and the bound retained identity before
 * execution. Bad arguments leave the solution READY and result unpublished.
 * Once execution starts, resolve is single-use, drains the producer, validates
 * all pixels, then publishes the full height and seals COMPLETE. Runtime
 * error/cancellation seals FAILED; there is no partial-row callback, CPU
 * substitution or backend replay. Concurrent/repeated execution is invalid.
 * Every baseline, result, map and callback borrow ends on return.
 * EncoderCore consumes COMPLETE only after success. It retains its own image
 * reference; this solution never writes a SIXEL byte or commits history.
 * Discarding a READY solution has no output or retained-state effect. */
[component, refcounted]
[responsibility("validate and publish one deferred palette application")]
[forbid_state("sixel_runs", "terminal_callback", "transport_queue")]
[forbid_state("retained_owner", "active_lookup_binding", "borrowed_source")]
interface palette_apply_solution {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [const, borrows(description)]
    SIXELSTATUS get_description(out indexed_frame_description *description);
    [mutates]
    SIXELSTATUS resolve(in palette_apply_resolve_request const *request);
};

/* A retained capability of one successful PaletteApply preparation. It
 * delegates to the injected deferred GPU dither without inspecting method
 * names, pass counts or private state. CPU/stateless methods are not made
 * deferred implicitly. Unsupported capability is resolved before execution.
 * solve and monolithic run exclude each other on one prepared plan while a
 * solution is live. Re-preparation cannot mutate a returned capability or
 * solution: they retain the frozen preparation independently of PaletteApply.
 * Success returns one retained solution; failure leaves *solution NULL.
 * There are no outstanding GPU users, lookup bindings or source borrows when
 * solve returns. The controller owns queue and cancellation order. */
[component, refcounted]
[responsibility("prepare owned palette results for ordered resolution")]
[forbid_state("retained_pixels", "sixel_runs", "terminal_callback")]
[forbid_state("transport_queue", "audio_clock")]
interface palette_apply_deferred {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS solve(in palette_apply_solve_request const *request,
        out palette_apply_solution **solution);
};

/* dither is the optional CPU capability; gpu_dither is the optional GPU
 * capability. At least one is required. If both exist, their frozen
 * configuration must agree. Missing CPU capability is never replaced by a
 * different method. GPU OFF with no CPU dither returns FEATURE_ERROR. AUTO's
 * small-image CPU cutoff applies only when a CPU dither exists.
 *
 * An injected gpu_dither owns its prepared execution and receives the lookup
 * capability directly. PaletteApply does not inspect its algorithm, passes,
 * private state or method enum. The existing stateless GPU adapter remains
 * available when gpu_dither is NULL. A GPU-only preparation failure returns
 * before any output; runtime failure never switches to CPU.
 *
 * prepare retains compatible prepared dither and palette objects and the
 * supplied preparation capabilities. GPU eligibility of the application
 * shape is separate from lookup eligibility, which the provider owns.
 * GPU off or a below-threshold auto request prepares CPU lookup. Otherwise
 * the injected GPU preparer and composer attempt a plan without CPU lookup
 * construction. Only unsupported preparation (SIXEL_FEATURE_ERROR) permits
 * auto to prepare CPU lookup. Force returns that error. Missing required
 * capabilities also report SIXEL_FEATURE_ERROR; other errors propagate.
 * The composer validates and compiles the program before successful prepare.
 * No policy enum/name, table layout or policy-specific option is interpreted
 * by this component. An unsuccessful prepare preserves its previous plan.
 *
 * All resolved settings stay unchanged through run completion. Reconfiguration
 * requires prepare again. Hot loops do not reread options or probe devices.
 * Prepared CPU objects remain authoritative when supplied through an adapter;
 * the composition root must not pair them with a stale GPU configuration.
 * The CPU/GPU providers implement their declared selection semantics for the
 * same logical policy. The composer uses the prepared dither settings without
 * letting lookup change dither, transparency or emitted-color comparison.
 *
 * run requires BUILDING result storage matching the prepared description and
 * an exclusively borrowed source frame. The source's working pixels may be
 * modified as permitted by the selected dither; ownership never transfers.
 * Baseline interpretation/geometry must match delta input. With delta enabled,
 * a prepared retained update must already have bound the result identity.
 * No baseline means no delta keeps. Transparency still contributes final skip.
 *
 * All source, baseline, result, map and callback borrows end only after run
 * drains its producer/GPU work. Body consumers keep their own result reference.
 * A non-NULL cancel callback uses the existing sixel_cancel_function contract;
 * the legacy flag adapter supplies synchronized observations at this boundary.
 * Complete CPU bands can be published during run; GPU can publish one prefix
 * after completion. COMPLETE is set only after successful final publication.
 * Unsupported execution plans are resolved before output; a runtime failure
 * seals FAILED rather than rerunning a partially published image on CPU.
 * Frame statistics and retained state are published by the selected
 * retained_plane commit or advance_resolved contract,
 * not by this component. No persistent per-pixel error buffer is introduced. */
[component, refcounted]
[responsibility("apply dither and lookup into indexed pixels and final skip")]
[forbid_state("retained_pixels", "sixel_runs", "terminal_callback")]
[forbid_state("transport_queue", "audio_clock")]
interface palette_apply {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in palette_apply_prepare_request const *request);
    [mutates]
    SIXELSTATUS run(in palette_apply_run_request const *request);
    /* Borrow the actual prepared GPU device, or NULL for a CPU plan. This
     * never probes hardware or changes the prepared execution choice. */
    [const, borrows(device)]
    SIXELSTATUS get_device(out gpu_device **device);
    /* Return a retained optional capability, or FEATURE_ERROR with NULL.
     * No algorithm-name dispatch, probing, allocation or submission occurs.
     * Existing preparations without the capability retain ordinary run. */
    [const]
    SIXELSTATUS get_deferred(out palette_apply_deferred **deferred);
};

/* Stage diagnostics extend 6cells only; existing sixel.h playback result
 * and stats structures retain their layouts. Native playback owns samples. */
cpp_quote <<
#define SIXEL_HAVE_PLAYBACK_STAGE_SAMPLE 1
>>

[native, opaque]
[responsibility("refer to an existing playback session for diagnostics")]
typedef sixel_playback_t playback;

enum playback_stage_valid {
    SIXEL_PLAYBACK_STAGE_PREPARE = 1,
    SIXEL_PLAYBACK_STAGE_SOLVE = 2,
    SIXEL_PLAYBACK_STAGE_RESOLVE = 4,
    SIXEL_PLAYBACK_STAGE_EMIT = 8,
    SIXEL_PLAYBACK_STAGE_READY_WAIT = 16,
    SIXEL_PLAYBACK_STAGE_COMPLETION_INTERVAL = 32,
    SIXEL_PLAYBACK_STAGE_DEFERRED = 64
};

/* Durations are monotonic host elapsed seconds. prepare excludes solve and
 * credit/queue waits; solve includes upload/lookup/GPU wait; resolve includes
 * delta selection and indexed publication. emit spans body start through
 * writer acceptance and retained commit, excluding resolve. Ready wait spans
 * solve completion through resolve entry. Completion interval compares this
 * success with the immediately preceding success in the same generation;
 * failure/cancellation/generation change breaks that comparison. These
 * intervals overlap and must not be added as end-to-end latency. */
struct playback_stage_sample {
    size_t struct_size;
    uint64_t sequence;
    unsigned int valid;
    double prepare_seconds;
    double solve_seconds;
    double resolve_seconds;
    double emit_seconds;
    double ready_wait_seconds;
    double completion_interval_seconds;
};

/* Set sample.struct_size before calling. On success, copy the matching most
 * recently completed sample without retaining pointers. Unknown/stale
 * nonzero sequence returns SIXEL_FALSE with sample unchanged. Invalid args
 * return BAD_ARGUMENT. Samples are published before the ordered completion
 * callback, which may call this getter without encoder reentry. The callback
 * owns no pipeline gate. The sample remains available until another frame
 * completes, including a cancelled/failed frame. valid describes completed
 * stages, not inferred zero-cost stages; an unobserved interval is unset.
 * This operation never runs encoding, waits for GPU work or calls callbacks.
 * Playback must remain alive. An undersized structure is rejected without
 * writes; a larger supplied buffer is accepted with its unknown tail intact. */
SIXELAPI SIXELSTATUS sixel_playback_get_stage_sample(
    in playback *session, in uint64_t sequence,
    inout playback_stage_sample *sample);

/* Independent-pipeline diagnostics have a separate layout and getter.
 * The older stage sample keeps its existing interval meanings and layout;
 * an unrepresentable interval has its old validity bit unset, not redefined. */
cpp_quote <<
#define SIXEL_HAVE_PLAYBACK_PIPELINE_SAMPLE 1
>>

enum playback_pipeline_valid {
    SIXEL_PLAYBACK_PIPELINE_PALETTE = 1,
    SIXEL_PLAYBACK_PIPELINE_SOLVE = 2,
    SIXEL_PLAYBACK_PIPELINE_RESOLVE = 4,
    SIXEL_PLAYBACK_PIPELINE_ENCODE = 8,
    SIXEL_PLAYBACK_PIPELINE_PALETTE_WAIT = 16,
    SIXEL_PLAYBACK_PIPELINE_READY_WAIT = 32,
    SIXEL_PLAYBACK_PIPELINE_RESOLVED_WAIT = 64,
    SIXEL_PLAYBACK_PIPELINE_COMPLETION_WAIT = 128,
    SIXEL_PLAYBACK_PIPELINE_COMPLETION_INTERVAL = 256,
    SIXEL_PLAYBACK_PIPELINE_INDEPENDENT = 512,
    SIXEL_PLAYBACK_PIPELINE_ENCODE_INTERVAL = 1024,
    SIXEL_PLAYBACK_PIPELINE_DELIVERY = 2048,
    SIXEL_PLAYBACK_PIPELINE_ENCODED_WAIT = 4096
};

/* Durations use monotonic host seconds; they do not measure CPU busy time.
 * palette is this admission's own P build, even if its S selected an older
 * palette_sequence. Each actual build is measured once. A missing build is
 * invalid, not a fabricated zero duration. generation identifies the controller
 * generation; it is not a retained-plane epoch or a palette-store epoch.
 *
 * solve spans S preparation and history-free execution; gpu_prepare is a
 * subinterval. It excludes queue-space and palette waits. resolve spans R
 * work through history advance and publication; history is its stage/advance
 * subinterval. R first reserves downstream space, excluded from service.
 * encode spans E preparation through private-packet finish and cleanup, with
 * no external callback, history operation or own-palette join. delivery spans
 * the dispatcher's external byte callbacks, excluding joins and done. Each
 * stage bit covers its total and defined subinterval; do not add them twice.
 *
 * palette_wait measures S's compatible-palette wait. ready_wait spans solution
 * publication to R service entry, including resolved-slot capacity waits.
 * resolved_wait spans resolved-record publication to E service entry, including
 * packet-space waits. encoded_wait spans packet publication to delivery entry.
 * completion_wait spans external delivery completion to ordered done-callback
 * readiness, including own-P joins and source-borrower release.
 * Completion interval compares consecutive successful callback-ready frames;
 * encode interval compares consecutive successful E completions. Failure,
 * cancellation or generation changes reset the respective interval. Neither
 * is physical presentation timing. Invalid fields carry no measurement.
 * Parallel intervals must not be summed as end-to-end latency. */
struct playback_pipeline_sample {
    size_t struct_size;
    uint64_t sequence;
    uint64_t palette_sequence;
    uint64_t generation;
    unsigned int valid;
    double palette_seconds;
    double solve_seconds;
    double gpu_prepare_seconds;
    double resolve_seconds;
    double history_seconds;
    double encode_seconds;
    double delivery_seconds;
    double palette_wait_seconds;
    double ready_wait_seconds;
    double resolved_wait_seconds;
    double encoded_wait_seconds;
    double completion_wait_seconds;
    double completion_interval_seconds;
    double encode_interval_seconds;
};

/* Set sample.struct_size before calling. Copy the sample for the most recently
 * callback-ready frame, published before its ordered completion callback.
 * That callback may call this getter without encoder reentry. Unknown/stale
 * nonzero sequence returns FALSE unchanged. Invalid arguments/undersized
 * storage return BAD_ARGUMENT without writes; a larger buffer's unknown tail
 * remains intact. Unsupported scheduling returns FALSE, not invented values.
 * The getter holds no frame references and never submits, waits for GPU work
 * or invokes callbacks. The playback object must remain alive. */
SIXELAPI SIXELSTATUS sixel_playback_get_pipeline_sample(
    in playback *session, in uint64_t sequence,
    inout playback_pipeline_sample *sample);

/* Live queue occupancy is separate from completed-frame timing. */
cpp_quote <<
#define SIXEL_HAVE_PLAYBACK_QUEUE_SAMPLE 1
>>

/* Depths count waiting frames, excluding the active owner of each stage.
 * Entries 0..3 are P->S, S->R, R->E and E->delivery; their capacities are
 * reported in capacity[].
 * pending_palette counts admissions not yet taken by P, excluding reserved
 * tickets; pending_capacity is the playback admission bound for that queue.
 * Ring samples are individually consistent, not one atomic snapshot
 * across stages; do not derive in-flight work by subtracting their sum. */
struct playback_queue_sample {
    size_t struct_size;
    unsigned int valid;
    unsigned int stage_count;
    unsigned int pending_palette;
    unsigned int pending_capacity;
    unsigned int depth[4];
    unsigned int capacity[4];
};

/* Set sample.struct_size before calling. Success returns valid=1 and four
 * entries. Non-lock-free atomics, startup, shutdown, legacy scheduling or
 * transient contention return FALSE with sample unchanged. Invalid arguments
 * or undersized
 * storage return BAD_ARGUMENT without writes; larger buffers preserve their
 * size and unknown tail. The getter uses a try-lock and bounded atomic reads:
 * it never waits for a lane, GPU, callback or mutex. No frame is retained.
 * Playback must remain alive throughout the call. */
SIXELAPI SIXELSTATUS sixel_playback_get_queue_sample(
    in playback *session, inout playback_queue_sample *sample);

[classid("processing/palette-apply")]
coclass palette_apply_component {
    [default] interface palette_apply;
};

[alias(sixel_chunk_t)]
interface chunk;

struct chunk_source_request {
    char const *filename;
    int finsecure;
    int const *cancel_flag;
    sixel_cancel_function cancel_function;
    void *cancel_context;
};

struct chunk_memory_request {
    unsigned char const *bytes;
    size_t size;
    char const *source_path;
};

struct chunk_bytes_view {
    unsigned char const *bytes;
    size_t size;
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 chunk objects.
 * - Callers release with chunk->vtbl->unref(chunk).
 *
 * Encapsulation path:
 * - The chunk object owns loaded input bytes and optional source metadata.
 * - Loaders keep their own decode cursors; chunk bytes are read-only views.
 */
[component, refcounted]
[responsibility("own input bytes and source metadata only")]
[forbid_state("read_cursor", "decode_state")]
interface chunk {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(bytes_view, source_path)]
    SIXELSTATUS init_source(in chunk_source_request const *request);
    [mutates, invalidates(bytes_view, source_path)]
    SIXELSTATUS init_memory(in chunk_memory_request const *request);
    [const, borrows(bytes_view)]
    SIXELSTATUS get_bytes(out chunk_bytes_view *view);
    [const, borrows(source_path)]
    char const *source_path();
};

[classid("image/chunk")]
coclass chunk_component {
    [default] interface chunk;
};

interface loader_component;

[component, refcounted]
[responsibility("decode one chunk through one loader backend")]
[forbid_state("loader_chain", "global_decode_cursor")]
interface loader_component {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS setopt(in int option, in void const *value);
    SIXELSTATUS load(
        in chunk const *chunk,
        in sixel_load_image_function fn_load,
        in void *context);
    [const] char const *name();
    int predicate(in chunk const *chunk);
};

typedef loader_component sixel_loader_component_t;
typedef loader_component_vtbl sixel_loader_vtbl_t;

[alias(sixel_loader_manager_t)]
interface loader_manager;

struct loader_suboptions {
    int background_policy;
    int background_colorspace;
    int cms_target_colorspace;
    int cms_prefer_8bit;
    unsigned int cms_rendering_intent_order;
    int hdr_fallback_profile;
    double hdr_exposure_ev;
    int hdr_tonemap_mode;
    int hdr_use_header_exposure;
    int osc11_bg_query;
    int osc11_bg_query_timeout_ms;
    int thumbnail_size_hint;
    int png_trns_keycolor;
    int librsvg_allow_relative_resources;
    int librsvg_allow_stdin_svgz;
    int builtin_pam_duplicate_keys;
    int builtin_pam_endhdr_tokens;
    int builtin_pam_large_header;
    int builtin_pnm_trailing_data;
    int builtin_pnm_truncated_ascii;
    int wic_ico_minsize;
    int libjpeg_enable_cms;
    int libjpeg_cms_engine;
    int libjpeg_enable_orientation;
    int libpng_enable_cms;
    int libpng_cms_engine;
    int libpng_chrm_arithmetic;
    int libpng_enable_orientation;
    int libwebp_enable_cms;
    int libwebp_cms_engine;
    int libwebp_enable_orientation;
    int libwebp_max_output_frames;
    int coregraphics_enable_orientation;
    size_t coregraphics_cache_max_bytes;
    int coregraphics_cache_max_bytes_override;
    int libtiff_enable_cms;
    int libtiff_cms_engine;
    int builtin_enable_cms;
    int builtin_cms_engine;
    int builtin_enable_orientation;
    int builtin_bmp_info40_mode;
};

struct loader_manager_build_request {
    struct sixel_option_argument_list_resolution const *resolution;
    int skip_predicate_gate;
    int require_static;
    int use_palette;
    int reqcolors;
    unsigned char const *bgcolor;
    int has_bgcolor;
    int bgcolor_source;
    int loop_control;
    int has_start_frame_no;
    int start_frame_no;
    loader_suboptions const *suboptions;
    timeline_logger *timeline_logger;
    int *timeline_job_seq;
    sixel_loader_t *timeline_loader;
};

[component, refcounted]
[responsibility("build loader chains and select loaders for chunks")]
[forbid_state("chunk_bytes", "pixel_storage")]
interface loader_manager {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(loader_chain, selected_loader)]
    SIXELSTATUS build_chain(in loader_manager_build_request const *request);
    [borrows(selected_loader)]
    SIXELSTATUS load(
        in chunk const *chunk,
        out loader_component **selected_loader,
        in sixel_load_image_function fn_load,
        in void *load_context);
};

[classid("loader/manager")]
coclass loader_manager_component {
    [default] interface loader_manager;
};

/*
 * Ownership/lifetime:
 * - Existing public sixel_frame_new() returns refcount=1 frame objects.
 * - init_pixels() takes ownership of request->pixels and request->palette,
 *   matching sixel_frame_init().
 * - Public sixel_frame_init_borrowed() is a separate mutable-borrowed API
 *   and is not exposed through this component request.
 * - set_transparency() takes ownership of request->transparent_mask.
 *
 * Encapsulation path:
 * - This header exposes only the object contract and request/view DTOs.
 * - src/frame-private.h remains a temporary storage owner while loader-side
 *   direct-field callers migrate toward this interface.
 * - src/frame.c owns frame operations that need concrete storage access.
 */
enum frame_pixels_kind {
    SIXEL_FRAME_PIXELS_U8 = 0,
    SIXEL_FRAME_PIXELS_FLOAT32 = 1
};

struct frame_pixels_request {
    void *pixels;
    unsigned char *palette;
    int width;
    int height;
    int pixelformat;
    int colorspace; /* negative means infer from pixelformat */
    int ncolors;
    frame_pixels_kind kind;
};

struct frame_pixels_view {
    unsigned char *pixels;
    float *pixels_float32;
    unsigned char *palette;
    int width;
    int height;
    int pixelformat;
    int colorspace;
    int ncolors;
};

struct frame_timeline {
    int delay;
    int frame_no;
    int loop_count;
    int multiframe;
    int handoff_shareable;
};

struct frame_transparency {
    int transparent;
    int alpha_zero_is_transparent;
    unsigned char *transparent_mask;
    size_t transparent_mask_size;
};

/* Internal straight-alpha plane, independent of RGB coordinates and masks.
 * get_alpha() borrows storage; set_alpha() takes ownership only on success.
 * A NULL plane with count zero removes fractional coverage. */
struct frame_alpha {
    float *values;
    size_t count;
};

[component, refcounted]
[responsibility("own pixel storage and per-frame metadata")]
[forbid_state("lookup_policy", "dither_policy", "decode_state")]
interface frame {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS init_pixels(in frame_pixels_request const *request);
    [borrows(pixels_view)]
    SIXELSTATUS get_pixels(out frame_pixels_view *view);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS set_pixelformat(in int pixelformat);
    SIXELSTATUS get_timeline(out frame_timeline *timeline);
    [mutates]
    SIXELSTATUS set_timeline(in frame_timeline const *timeline);
    SIXELSTATUS get_transparency(out frame_transparency *transparency);
    [mutates]
    SIXELSTATUS set_transparency(in frame_transparency const *transparency);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS resize(
        in int width,
        in int height,
        in int method_for_resampling);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS resize_float32(
        in int width,
        in int height,
        in int method_for_resampling);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS clip(in int x, in int y, in int width, in int height);
    SIXELSTATUS measure_storage(out size_t *storage_bytes);
    SIXELSTATUS clone(
        in allocator *allocator,
        out frame **frame_out);
    SIXELSTATUS get_alpha(out frame_alpha *alpha);
    [mutates]
    SIXELSTATUS set_alpha(in frame_alpha const *alpha);
};

[classid("image/frame")]
coclass frame_component {
    [default] interface frame;
};

cpp_quote <<
static inline sixel_frame_interface_t *
sixel_frame_as_interface(sixel_frame_t const *frame)
{
    return (sixel_frame_interface_t *)frame;
}
>>

};
