};

[classid("diagnostics/timeline-logger")]
coclass timeline_logger_component {
    [default] interface timeline_logger;
};

struct thread_pool_job {
    int band_index;
};

typedef int (*sixel_thread_pool_worker_function_t)(
    thread_pool_job job,
    void *userdata,
    void *workspace);

typedef void (*sixel_thread_pool_workspace_cleanup_function_t)(
    void *workspace);

[alias(sixel_thread_pool_t)]
interface thread_pool;

struct thread_pool_create_request {
    int threads;
    int queue_size;
    size_t workspace_size;
    sixel_thread_pool_worker_function_t worker;
    void *userdata;
    sixel_thread_pool_workspace_cleanup_function_t workspace_cleanup;
};

[component, refcounted]
[responsibility("own one short-lived worker queue and its worker threads")]
[forbid_state("global_queue", "process_thread_budget")]
interface thread_pool {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    void set_affinity(in int pin_threads);
    [mutates]
    SIXELSTATUS push(in thread_pool_job job);
    [mutates]
    void finish();
    int get_error();
    [mutates]
    SIXELSTATUS grow(in int additional_threads);
};

[component, refcounted]
[responsibility("create independent thread pools and resolve thread counts")]
[forbid_state("worker_threads", "job_queue", "encoder_state")]
[alias(sixel_threadpool_service_t)]
interface threadpool_service {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    int resolve_threads(in int requested);
    SIXELSTATUS create_pool(
        in thread_pool_create_request const *request,
        out thread_pool **pool);
};

[serviceid("services/threadpool")]
coclass threadpool_service_component {
    [default] interface threadpool_service;
};

[alias(sixel_encoder_core_t)]
interface encoder_core;

[alias(sixel_writer_t)]
interface sixel_writer;

interface frame;

/* Native data owners have no vtbl or factory identity. The declarations are
 * emitted here, rather than added to the legacy sixel.h public surface. */
cpp_quote <<
#include <stdint.h>

typedef struct sixel_wire_palette sixel_wire_palette_t;
typedef struct sixel_indexed_frame sixel_indexed_frame_t;
typedef struct sixel_retained_read sixel_retained_read_t;
typedef struct sixel_retained_update sixel_retained_update_t;
typedef struct sixel_stream_receipt sixel_stream_receipt_t;
>>

[native, opaque, refcounted]
[responsibility("own immutable wire definitions and their retained RGB")]
typedef sixel_wire_palette_t wire_palette;

[native, opaque, refcounted]
[responsibility("own indexed pixels and publish immutable completed rows")]
typedef sixel_indexed_frame_t indexed_frame;

[native, opaque, refcounted]
[responsibility("pin one committed retained-plane generation for readers")]
typedef sixel_retained_read_t retained_read;

[native, opaque, refcounted]
[responsibility("own one prepared retained-plane update transaction")]
typedef sixel_retained_update_t retained_update;

[native, opaque, refcounted]
[responsibility("identify a successfully completed ordered writer image")]
typedef sixel_stream_receipt_t stream_receipt;

/* stream is allocated by the retained-plane instance, not by a transport.
 * begin_update binds this identity once before a new producer publishes rows.
 * Imported complete frames carry the identity used to compute their keeps;
 * begin_update verifies that identity instead of rebinding it.
 * sequence must exceed base_sequence; gaps for dropped source frames are OK.
 * Zero stream denotes an untracked image, which cannot advance history. */
struct encode_identity {
    uint64_t stream;
    uint64_t epoch;
    uint64_t base_sequence;
    uint64_t sequence;
};

struct wire_color_definition {
    unsigned int register_index;
    int type;
    int fields[3];
};

struct wire_palette_request {
    wire_color_definition const *definitions;
    size_t count;
    int color_definition;
    int colorspace;
};

struct wire_color {
    wire_color_definition definition;
    unsigned char emitted_rgb[3];
};

struct wire_palette_view {
    wire_color const *colors;
    size_t count;
    int color_definition;
    int colorspace;
};

/* Definitions are copied and validated; emitted RGB is derived from those
 * exact fields. In particular, never regenerate HLS fields from rounded RGB.
 * Index i addresses colors[i]; the serializer uses its register_index.
 * Unsupported wire interpretations fail without publishing a palette.
 * Views borrow the immutable owner until its last unref. */
SIXELAPI SIXELSTATUS sixel_wire_palette_new(
    out wire_palette **result,
    in wire_palette_request const *request,
    in allocator *allocator);
SIXELAPI void sixel_wire_palette_ref(in wire_palette *palette);
SIXELAPI void sixel_wire_palette_unref(in wire_palette *palette);
SIXELAPI SIXELSTATUS sixel_wire_palette_get_view(
    in wire_palette const *palette, out wire_palette_view *view);

enum indexed_skip {
    SIXEL_INDEXED_PAINT = 0,
    SIXEL_INDEXED_KEEP = 1,
    SIXEL_INDEXED_KEEP_APPROXIMATE = 3
};

enum indexed_state {
    SIXEL_INDEXED_BUILDING = 0,
    SIXEL_INDEXED_COMPLETE = 1,
    SIXEL_INDEXED_FAILED = 2
};

struct indexed_frame_description {
    int width;
    int height;
    int encoded_width;
    int encoded_height;
    int encoded_x;
    int encoded_y;
    int origin_x;
    int origin_y;
    int plane_width;
    int plane_height;
    int keycolor;
    int keycolor_reserved;
    int transparent_background;
    wire_palette *palette;
};

struct indexed_frame_take_request {
    indexed_frame_description description;
    encode_identity identity;
    sixel_index_t *indexes;
    size_t indexes_size;
    unsigned char *skip;
    size_t skip_size;
};

struct indexed_rows_view {
    sixel_index_t const *indexes;
    unsigned char const *skip;
    size_t row_stride;
    int first_row;
    int rows;
};

/* new allocates BUILDING storage, including capacity for a final skip mask.
 * PaletteApply is its sole producer; no writable view escapes this API.
 * take accepts packed complete external data, validates all painted indexes
 * and mask codes, and transfers both allocations only on success. Both must
 * belong to the supplied allocator. It clears the transferred request pointers
 * on success; failure leaves the request and empty result slot unchanged.
 * take copies identity; stream zero is valid for standalone serialization.
 * Both constructors retain the palette and allocator. No RGB plane is made.
 *
 * Final skip includes alpha/key transparency and delta keeps. A NULL skip
 * view means all paint. Kept indexes need not name a palette entry and must
 * not be dereferenced. Dimensions must be positive and offsets nonnegative.
 * encoded_x/y place source pixels in the encoded raster;
 * its extents must contain that rectangle without overflow. Leading padding
 * and the final partial SIXEL band never become retained source pixels.
 * origin_x/y independently place source pixels within the retained plane.
 * Nonzero skip requires transparent_background. The session sets SIXEL P2=1
 * for that description; a clearing header cannot represent retained keeps.
 * Rows are published as an immutable contiguous prefix with release/acquire
 * ordering. Completion seals the image; failure never turns into completion.
 * get_rows returns SIXEL_FALSE for unpublished rows, BAD_ARGUMENT for invalid
 * ranges, and a failure for an aborted producer. The owner pins returned views.
 * Refcount operations are thread-safe; users pin resources until GPU/worker
 * completion, including failure and cancellation. */
SIXELAPI SIXELSTATUS sixel_indexed_frame_new(
    out indexed_frame **result,
    in indexed_frame_description const *description,
    in allocator *allocator);
SIXELAPI SIXELSTATUS sixel_indexed_frame_take(
    out indexed_frame **result,
    inout indexed_frame_take_request *request,
    in allocator *allocator);
SIXELAPI void sixel_indexed_frame_ref(in indexed_frame *image);
SIXELAPI void sixel_indexed_frame_unref(in indexed_frame *image);
SIXELAPI SIXELSTATUS sixel_indexed_frame_get_description(
    in indexed_frame const *image, out indexed_frame_description *description);
SIXELAPI SIXELSTATUS sixel_indexed_frame_get_identity(
    in indexed_frame const *image, out encode_identity *identity);
SIXELAPI SIXELSTATUS sixel_indexed_frame_get_rows(
    in indexed_frame const *image, in int first_row, in int rows,
    out indexed_rows_view *view);
SIXELAPI indexed_state sixel_indexed_frame_get_state(
    in indexed_frame const *image);

struct retained_plane_description {
    int width;
    int height;
    int color_definition;
    int colorspace;
};

struct retained_read_view {
    unsigned char const *rgb;
    unsigned char const *valid;
    size_t rgb_stride;
    size_t valid_stride;
    retained_plane_description description;
    uint64_t stream;
    uint64_t epoch;
    uint64_t sequence;
};

struct retained_update_request {
    retained_read *baseline;
    indexed_frame *image;
    uint64_t sequence;
    int record_paint;
};

struct retained_update_stats {
    size_t painted_pixels;
    int refinement_needed;
    unsigned char const *paint;
    size_t paint_size;
};

enum retained_invalidation {
    SIXEL_RETAINED_SEEK = 0,
    SIXEL_RETAINED_GEOMETRY = 1,
    SIXEL_RETAINED_OUTPUT_FORMAT = 2,
    SIXEL_RETAINED_OUTPUT_FAILURE = 3,
    SIXEL_RETAINED_QUEUE_DISCARD = 4
};

/* Read leases pin the plane, not a copy. Their view stays valid until the last
 * read unref. Callers release all leases before committing or invalidating.
 * Updates retain their plane and indexed image, but do not retain the baseline
 * read lease. A plane holds only a non-owning reference to its active update.
 * Dropping an uncommitted update aborts it after its last resource user exits.
 * The optional paint view borrows the update and survives until its last unref.
 * It is frame-local, one byte per source pixel; when record_paint is zero,
 * stats.paint is NULL and paint_size is zero without a paint allocation.
 * Receipts are immutable and can only be obtained from a successful writer
 * end_image; they are output acceptance records, not presentation timestamps. */
SIXELAPI void sixel_retained_read_ref(in retained_read *read);
SIXELAPI void sixel_retained_read_unref(in retained_read *read);
SIXELAPI SIXELSTATUS sixel_retained_read_get_view(
    in retained_read const *read, out retained_read_view *view);
SIXELAPI void sixel_retained_update_ref(in retained_update *update);
SIXELAPI void sixel_retained_update_unref(in retained_update *update);
SIXELAPI void sixel_stream_receipt_ref(in stream_receipt *receipt);
SIXELAPI void sixel_stream_receipt_unref(in stream_receipt *receipt);

/* configure is idle-only and allocates before changing the current plane.
 * An unchanged description preserves history. A changed description advances
 * epoch and invalidates every pixel; allocation failure preserves old state.
 * acquire_read also works on an invalid plane: valid bytes identify holes.
 *
 * begin_update validates geometry, output interpretation and baseline identity,
 * reserves all commit storage, retains the image and stamps its identity.
 * It neither expands indexes nor changes committed RGB. Only one update can
 * be active per plane. A COMPLETE imported image must already carry the same
 * identity derived from this baseline and requested sequence; no published
 * rows may be rebound to a new identity. FAILED images are always rejected.
 *
 * commit requires a COMPLETE image, its matching receipt, drained consumers
 * and no read leases. It checks all preconditions before writing, then performs
 * one allocation-free traversal: skip keeps, expand painted indexes directly
 * into retained RGB, and collect statistics. Partial-band padding is excluded.
 * Success advances sequence even for an all-keep image. Repeated/stale commits
 * fail without mutation. It never waits for physical terminal writes.
 *
 * abort preserves the CPU baseline. invalidate requires quiescence, advances
 * epoch, clears validity and makes delayed old receipts unusable. Neither
 * operation can undo partially emitted bytes. The session must invalidate and
 * discard dependent output after partial writes or transport queue loss.
 * Calls with live readers/producers return LOGIC_ERROR instead of waiting
 * under a gate. Cancellation first drains those users outside the component.
 * This contract does not yet expose speculative in-place GPU mutation. */
[component, refcounted]
[responsibility("maintain the retained image of one ordered output stream")]
[forbid_state("lookup_policy", "dither_policy", "sixel_runs")]
[forbid_state("terminal_callback", "transport_queue", "audio_clock")]
interface retained_plane {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS configure(in retained_plane_description const *description);
    SIXELSTATUS acquire_read(out retained_read **read);
    [mutates]
    SIXELSTATUS begin_update(
        in retained_update_request const *request,
        out retained_update **update);
    [mutates]
    SIXELSTATUS commit(
        in retained_update *update, in stream_receipt const *receipt,
        out retained_update_stats *stats);
    [mutates]
    SIXELSTATUS abort(in retained_update *update);
    [mutates]
    SIXELSTATUS invalidate(in retained_invalidation reason);
};

[classid("image/retained-plane")]
coclass retained_plane_component {
    [default] interface retained_plane;
};

struct writer_init_request {
    sixel_write_function fn_write;
    void *priv;
};

struct writer_controls {
    int has_8bit_control;
    int has_sixel_scrolling;
    int has_sdm_glitch;
    int skip_dcs_envelope;
    int skip_header;
    int penetrate_multiplexer;
};

struct writer_image_header {
    int parameter0;
    int parameter1;
    int parameter2;
    int parameter_count;
    int width;
    int height;
    int use_raster_attributes;
};

/*
 * sixel_writer serializes terminal-framing bytes to the callback supplied by
 * the legacy public sixel_output_t wrapper.  The callback is invoked while the
 * writer lock is held, so a callback must not re-enter the same writer.
 * begin_image copies identity; NULL denotes an untracked image. end_image
 * publishes a receipt only after the complete image has reached the configured
 * callback boundary successfully. It reserves receipt capacity before the
 * first image byte. A NULL receipt output requests no receipt. Failure never
 * publishes one. The session drains PaletteApply/body work before end_image.
 * Buffered callbacks accept ordered packets ahead of physical display; a
 * later discarded packet invalidates every dependent delta suffix.
 * abort_image best-effort closes framing without creating a receipt.
 */
[component, refcounted]
[responsibility("write framed terminal SIXEL bytes to callback-backed output")]
[forbid_state("image_pixels", "palette", "dither_policy")]
[forbid_state("encode_policy", "ormode", "transparent_policy")]
[forbid_state("gri_arg_limit", "body_run_state")]
interface sixel_writer {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS init(in writer_init_request const *request);
    [mutates]
    SIXELSTATUS set_controls(in writer_controls const *controls);
    SIXELSTATUS get_controls(out writer_controls *controls);
    SIXELSTATUS begin_image(
        in writer_image_header const *header,
        in encode_identity const *identity);
    SIXELSTATUS write(in char const *data, in int size);
    SIXELSTATUS end_image(out stream_receipt **receipt);
    SIXELSTATUS abort_image();
};

[classid("io/sixel-writer")]
coclass sixel_writer_component {
    [default] interface sixel_writer;
};

struct encoder_core_options {
    int has_gri_arg_limit;
    int encode_policy;
    int ormode;
    int emit_palette;
};

/* A body sink accepts all bytes or reports failure. The session owns context
 * through finish/abort; no terminal/framing state belongs to the body encoder.
 * This callback is per byte chunk, never per pixel. */
typedef SIXELSTATUS (*sixel_body_write_function_t)(
    char const *data, size_t size, void *context);

struct body_byte_sink {
    sixel_body_write_function_t write;
    void *context;
};

struct encoder_core_prepare_request {
    indexed_frame *image;
    encoder_core_options options;
    body_byte_sink sink;
    int threads;
    int queue_bands;
};

/*
 * prepare retains image, validates options and reserves scratch without
 * emitting bytes. An instance owns at most one active image. consume accepts
 * a monotonically growing count of published source rows; complete six-row
 * encoded bands can run immediately, including before PaletteApply finishes.
 * Source readiness is translated through encoded_y; empty leading bands do
 * not require source rows. The last partial band is accepted only when all
 * source rows have been published.
 * Workers may complete out of order; emitted body bytes remain ordered.
 * finish requires COMPLETE input and all rows consumed, then drains workers.
 * abort cancels/drains workers without framing or retained-state mutation.
 * Both release the image/sink borrow; failed jobs must be aborted before reuse.
 * Final decoded coverage must equal the indexed result, including skip holes.
 * Wire palette fields are serialized directly; no re-quantization occurs here.
 * Highcolor's changing palettes stay in the legacy public adapter until a
 * separate indexed representation can express them without losing semantics.
 */
[component, refcounted]
[responsibility("serialize published indexed rows into SIXEL body bytes")]
[forbid_state("callback_output", "dcs_envelope", "terminal_multiplexer", "image_file_output", "clipboard_output")]
[forbid_state("lookup_policy", "dither_policy", "retained_plane")]
interface encoder_core {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in encoder_core_prepare_request const *request);
    [mutates]
    SIXELSTATUS consume(in int published_rows);
    [mutates]
    SIXELSTATUS finish();
    [mutates]
    SIXELSTATUS abort();
};

[classid("codec/encoder-core")]
coclass encoder_core_component {
    [default] interface encoder_core;
};

[classid("codec/encoder-core.normal")]
coclass encoder_core_normal_component {
    [default] interface encoder_core;
};

[classid("codec/encoder-core.ormode")]
coclass encoder_core_ormode_component {
    [default] interface encoder_core;
};

[component, refcounted]
[responsibility("create components by class id")]
[alias(sixel_factory_t)]
interface factory {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    SIXELSTATUS create(
        in char const *class_name,
        in allocator *allocator,
        out void **object);
};

[serviceid("services/factory")]
coclass factory_component {
    [default] interface factory;
};

/*
 * getservice("services/factory", &factory) returns the process-wide factory
 * service with interface-level ownership.  Release it with factory->vtbl->unref
 * when the caller is done with the service pointer.
 */
SIXELAPI SIXELSTATUS sixel_components_getservice(
    in char const *name,
    out void **service);

[alias(sixel_palette_t)]
interface palette;

struct palette_entries_request {
    unsigned char const *entries;
    unsigned int colors;
    int depth;
};

struct palette_float32_entries_request {
    float const *entries;
    unsigned int colors;
    int depth;
};

/* GPU policy is request-local; zero-initialized requests stay on CPU. */
struct palette_generate_request {
    void const *data;
    unsigned int length;
    int pixelformat;
    unsigned int requested_colors;
    int method_for_largest;
    int method_for_rep;
    int quality_mode;
    int force_palette;
    int use_reversible;
    int quantize_model;
    int final_merge_mode;
    int lut_policy;
    int prefer_float32;
    int gpu_policy;
};

struct palette_entries_view {
    unsigned char *entries;
    size_t entries_size;
    unsigned int entry_count;
    int depth;
};

struct palette_float32_entries_view {
    float *entries;
    size_t entries_size;
    unsigned int entry_count;
    int depth;
};

struct palette_metadata {
    unsigned int entry_count;
    unsigned int requested_colors;
    unsigned int original_colors;
    int depth;
    int float_depth;
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 palette objects.
 * - Callers release with palette->vtbl->unref(palette).
 *
 * Encapsulation path:
 * - The palette object owns generated palette entries and metadata.
 * - Quantizer options are request-local generation inputs.
 * - Lookup policy caches belong to the dither/apply context.
 */
[component, refcounted]
[responsibility("own palette entries and quantization metadata only")]
[forbid_state("lookup_policy", "dither_policy", "input_pixels", "method_for_largest", "method_for_rep", "quality_mode", "force_palette", "use_reversible", "quantize_model", "final_merge_mode", "lut_policy")]
[alias(sixel_palette_t)]
interface palette {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(entries_view, float32_entries_view)]
    SIXELSTATUS init_entries(in palette_entries_request const *request);
    [mutates, invalidates(float32_entries_view)]
    SIXELSTATUS init_entries_float32(
        in palette_float32_entries_request const *request);
    [mutates, invalidates(entries_view, float32_entries_view)]
    SIXELSTATUS generate(in palette_generate_request const *request);
    [const, borrows(entries_view)]
    SIXELSTATUS get_entries(out palette_entries_view *view);
    [const, borrows(float32_entries_view)]
    SIXELSTATUS get_entries_float32(out palette_float32_entries_view *view);
    [const]
    SIXELSTATUS get_metadata(out palette_metadata *metadata);
};

[classid("quant/palette")]
coclass palette_component {
    [default] interface palette;
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 policy objects.
 * - Callers release with policy->vtbl->unref(policy).
 *
 * Creation path:
 * - sixel_lookup_policy_select_name(select_request)
 * - services/factory -> create("lookup/...", allocator, &policy)
 * - factory resolves class ids via generated classid registry
 * - policy->prepare(request)
 *
 * Reuse path:
 * - Callers may pass a prepared policy object through
 *   request.reuse_policy/request.reuse_policy_slot.
 * - request.parallel_dither_active carries execution context so policies can
 *   disable non-thread-safe cache paths without relying on global state.
 * - request.shared_instance_enabled stores the effective shared-instance
 *   preference resolved by the caller (CLI override or environment default).
 * - Lookup option pairs carry both a value and an override flag.  A zero
 *   override lets direct component users retain registry-backed environment
 *   defaults without teaching backends about environment variable names.
 * - FHEDT retains immutable grid references without consuming reuse_policy;
 *   reuse_policy_slot may be NULL. Each handle keeps its own cache settings.
 * - Implementations may choose to ignore reuse hints.
 *
 * Mapping:
 * - map_pixel_hint(pixel, hint) returns exactly what map_pixel(pixel)
 *   returns.  hint is a caller-owned guess, typically the index mapped for
 *   the previous pixel of the same scan; a negative hint means none.  It may
 *   only change the work done, never the result, so an implementation
 *   without a use for it forwards to map_pixel().
 * - map_pixels maps count samples in their supplied order, exactly as repeated
 *   map_pixel calls on the same prepared state. Strides are signed byte/input
 *   and index/output offsets, permitting reverse rows without reordering
 *   approximate caches. Zero count touches neither buffer. Buffers must not
 *   overlap; each addressed sample and output must be valid. Implementations
 *   without a bulk kernel use sixel_lookup_policy_map_pixels_default.
 * - workspace_size is optional (NULL means zero). The caller may allocate
 *   that many zeroed bytes, aligned as malloc, for map_pixels. This scratch
 *   belongs to one caller and one unchanged prepared policy; never share it
 *   concurrently or retain it across prepare. It owns no resources and can
 *   be freed directly by its allocator. NULL scratch always remains valid,
 *   including allocation failure; it changes only performance.
 * - Mapping methods are const. A prepared policy may memoize results only
 *   in caches safe for concurrent callers that cannot change a result;
 *   it keeps no scan history.  Continuity across pixels belongs to the
 *   caller, which passes it back as hint.
 */
interface lookup_policy;

struct lookup_policy_select_request {
    int method_for_diffuse;
    unsigned char const *palette;
    int depth;
    int reqcolor;
    int optimize_lookup;
    int lut_policy;
    int pixelformat;
};

struct lookup_policy_prepare_request {
    unsigned char const *palette;
    float const *palette_float;
    int depth;
    int float_depth;
    int reqcolor;
    int pixelformat;
    int parallel_dither_active;
    int shared_instance_enabled;
    int lut_policy_packing;
    int lut_policy_packing_override;
    int fhedt_resolution;
    int fhedt_resolution_override;
    int fhedt_refine;
    int fhedt_refine_override;
    double fhedt_weights[3];
    int fhedt_weights_override;
    int fhedt_shared;
    int fhedt_shared_override;
    int fhedt_use_dist2;
    int fhedt_use_dist2_override;
    int fhedt_use_cache;
    int fhedt_use_cache_override;
    unsigned int fhedt_tile_xy;
    int fhedt_tile_xy_override;
    unsigned int fhedt_tile_depth;
    int fhedt_tile_depth_override;
    int fhedt_first_touch;
    int fhedt_first_touch_override;
    int fhedt_pin_threads;
    int fhedt_pin_threads_override;
    lookup_policy *reuse_policy;
    lookup_policy **reuse_policy_slot;
    allocator *allocator;
};

typedef int lookup_policy_result;

[component, refcounted]
[responsibility("map pixels to palette indexes")]
[forbid_state("image_pixels", "output_pixels")]
interface lookup_policy {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in lookup_policy_prepare_request const *request);
    [const] lookup_policy_result map_pixel(
        in unsigned char const *pixel);
    [const] lookup_policy_result map_pixel_hint(
        in unsigned char const *pixel,
        in int hint);
    [const] void map_pixels(
        in unsigned char const *pixels,
        in size_t count,
        in int pixel_stride,
        out sixel_index_t *result,
        in int result_stride,
        inout void *workspace);
    [const] size_t workspace_size();
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 policy objects.
 * - Callers release with policy->vtbl->unref(policy).
 *
 * Creation path:
 * - sixel_dither_policy_select_name(select_request)
 * - services/factory -> create("dither/...", allocator, &policy)
 * - policy->prepare(request)
 */
interface dither_policy;

struct dither_policy_select_request {
    int method_for_diffuse;
    int ncolors;
    int pixelformat;
};

struct dither_policy_prepare_request {
    sixel_dither_t *dither;
    int depth;
    int method_for_scan;
    int pixelformat;
};

struct dither_policy_apply_request {
    sixel_index_t *result;
    unsigned char *data;
    int width;
    int height;
    int band_origin;
    int output_start;
    int depth;
    unsigned char *palette;
    int method_for_scan;
    lookup_policy *lookup_policy;
    sixel_dither_t *dither;
    int pixelformat;
};

typedef int dither_policy_supports_parallel_result;

[component, refcounted]
[responsibility("apply dithering from pixels and lookup policy")]
[forbid_state("input_owner", "output_owner")]
interface dither_policy {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in dither_policy_prepare_request const *request);
    SIXELSTATUS apply(in dither_policy_apply_request const *request);
    [const] dither_policy_supports_parallel_result supports_parallel_bands();
};

/* Packed selection uses bit (y * columns + x), low bit first in each word.
 * Without tiling, cell edges are floor(i * extent / grid). Tiling requires
 * a 64x64 grid and repeats in frame-local pixel coordinates, matching the
 * current refresh mask. It is not shifted by the retained-plane origin.
 * Coordinates outside width/height and NULL words select no cells.
 * Selected cells use min(selected_threshold, frame threshold).
 * The caller owns this immutable map through run and all its workers. */
struct delta_threshold_map {
    uint32_t const *words;
    size_t word_count;
    unsigned int columns;
    unsigned int rows;
    int width;
    int height;
    int tiled;
    unsigned int selected_threshold;
};

struct palette_apply_delta {
    int enabled;
    unsigned int threshold;
    int metric;
    delta_threshold_map selection;
};

struct palette_apply_prepare_request {
    palette *working_palette;
    lookup_policy *lookup;
    dither_policy *dither;
    indexed_frame_description output;
    int pixelformat;
    int colorspace;
    int scan;
    int worker_threads;
    int gpu_policy;
    size_t gpu_auto_threshold;
};

/* Called serially by the producer with a monotonically increasing ready-row
 * prefix. Publication precedes the callback. The callback can enqueue body
 * work; its failure stops application and seals the indexed image FAILED.
 * It must not re-enter PaletteApply, mutate its plans or commit history. */
typedef SIXELSTATUS (*sixel_indexed_rows_ready_function_t)(
    indexed_frame *image, int published_rows, void *context);

struct palette_apply_run_request {
    frame *source;
    retained_read *baseline;
    indexed_frame *result;
    palette_apply_delta delta;
    sixel_indexed_rows_ready_function_t rows_ready;
    void *rows_context;
    sixel_cancel_function cancel;
    void *cancel_context;
};

/* prepare retains compatible prepared lookup/dither and palette objects.
 * They stay unchanged from prepare through run completion. Reconfiguration
 * between runs requires prepare again before the next run; retaining a cache
 * reference alone does not prohibit its idle reuse. The component resolves
 * the execution plan without output, reusing device capabilities;
 * hot loops neither reread environment options nor probe device availability.
 * The existing policy preparation contracts supply policy-specific settings.
 * CPU/GPU implementations must consume the same resolved settings, including
 * dither strength/phase and emitted-color comparison semantics.
 *
 * run requires BUILDING result storage matching the prepared description and
 * an exclusively borrowed source frame. The source's working pixels may be
 * modified as permitted by the selected dither; ownership never transfers.
 * Baseline interpretation/geometry must match delta input. With delta enabled,
 * a prepared retained update must already have bound the result identity.
 * No baseline means no delta keeps. Transparency still contributes final skip.
 *
 * All source, baseline, result, map and callback borrows end only after run
 * drains its producer/GPU work. Body consumers keep their own result reference.
 * A non-NULL cancel callback uses the existing sixel_cancel_function contract;
 * the legacy flag adapter supplies synchronized observations at this boundary.
 * Complete CPU bands can be published during run; GPU can publish one prefix
 * after completion. COMPLETE is set only after successful final publication.
 * Unsupported execution plans are resolved before output; a runtime failure
 * seals FAILED rather than rerunning a partially published image on CPU.
 * Frame statistics and retained state are published by retained_plane.commit,
 * not by this component. No persistent per-pixel error buffer is introduced. */
[component, refcounted]
[responsibility("apply dither and lookup into indexed pixels and final skip")]
[forbid_state("retained_pixels", "sixel_runs", "terminal_callback")]
[forbid_state("transport_queue", "audio_clock")]
interface palette_apply {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS prepare(in palette_apply_prepare_request const *request);
    [mutates]
    SIXELSTATUS run(in palette_apply_run_request const *request);
};

[classid("processing/palette-apply")]
coclass palette_apply_component {
    [default] interface palette_apply;
};

[alias(sixel_chunk_t)]
interface chunk;

struct chunk_source_request {
    char const *filename;
    int finsecure;
    int const *cancel_flag;
    sixel_cancel_function cancel_function;
    void *cancel_context;
};

struct chunk_memory_request {
    unsigned char const *bytes;
    size_t size;
    char const *source_path;
};

struct chunk_bytes_view {
    unsigned char const *bytes;
    size_t size;
};

/*
 * Ownership/lifetime:
 * - Factory create returns refcount=1 chunk objects.
 * - Callers release with chunk->vtbl->unref(chunk).
 *
 * Encapsulation path:
 * - The chunk object owns loaded input bytes and optional source metadata.
 * - Loaders keep their own decode cursors; chunk bytes are read-only views.
 */
[component, refcounted]
[responsibility("own input bytes and source metadata only")]
[forbid_state("read_cursor", "decode_state")]
interface chunk {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(bytes_view, source_path)]
    SIXELSTATUS init_source(in chunk_source_request const *request);
    [mutates, invalidates(bytes_view, source_path)]
    SIXELSTATUS init_memory(in chunk_memory_request const *request);
    [const, borrows(bytes_view)]
    SIXELSTATUS get_bytes(out chunk_bytes_view *view);
    [const, borrows(source_path)]
    char const *source_path();
};

[classid("image/chunk")]
coclass chunk_component {
    [default] interface chunk;
};

interface loader_component;

[component, refcounted]
[responsibility("decode one chunk through one loader backend")]
[forbid_state("loader_chain", "global_decode_cursor")]
interface loader_component {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates]
    SIXELSTATUS setopt(in int option, in void const *value);
    SIXELSTATUS load(
        in chunk const *chunk,
        in sixel_load_image_function fn_load,
        in void *context);
    [const] char const *name();
    int predicate(in chunk const *chunk);
};

typedef loader_component sixel_loader_component_t;
typedef loader_component_vtbl sixel_loader_vtbl_t;

[alias(sixel_loader_manager_t)]
interface loader_manager;

struct loader_suboptions {
    int background_policy;
    int background_colorspace;
    int cms_target_colorspace;
    int cms_prefer_8bit;
    unsigned int cms_rendering_intent_order;
    int hdr_fallback_profile;
    double hdr_exposure_ev;
    int hdr_tonemap_mode;
    int hdr_use_header_exposure;
    int osc11_bg_query;
    int osc11_bg_query_timeout_ms;
    int thumbnail_size_hint;
    int png_trns_keycolor;
    int librsvg_allow_relative_resources;
    int librsvg_allow_stdin_svgz;
    int builtin_pam_duplicate_keys;
    int builtin_pam_endhdr_tokens;
    int builtin_pam_large_header;
    int builtin_pnm_trailing_data;
    int builtin_pnm_truncated_ascii;
    int wic_ico_minsize;
    int libjpeg_enable_cms;
    int libjpeg_cms_engine;
    int libjpeg_enable_orientation;
    int libpng_enable_cms;
    int libpng_cms_engine;
    int libpng_chrm_arithmetic;
    int libpng_enable_orientation;
    int libwebp_enable_cms;
    int libwebp_cms_engine;
    int libwebp_enable_orientation;
    int libwebp_max_output_frames;
    int coregraphics_enable_orientation;
    size_t coregraphics_cache_max_bytes;
    int coregraphics_cache_max_bytes_override;
    int libtiff_enable_cms;
    int libtiff_cms_engine;
    int builtin_enable_cms;
    int builtin_cms_engine;
    int builtin_enable_orientation;
    int builtin_bmp_info40_mode;
};

struct loader_manager_build_request {
    struct sixel_option_argument_list_resolution const *resolution;
    int skip_predicate_gate;
    int require_static;
    int use_palette;
    int reqcolors;
    unsigned char const *bgcolor;
    int has_bgcolor;
    int bgcolor_source;
    int loop_control;
    int has_start_frame_no;
    int start_frame_no;
    loader_suboptions const *suboptions;
    timeline_logger *timeline_logger;
    int *timeline_job_seq;
    sixel_loader_t *timeline_loader;
};

[component, refcounted]
[responsibility("build loader chains and select loaders for chunks")]
[forbid_state("chunk_bytes", "pixel_storage")]
interface loader_manager {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(loader_chain, selected_loader)]
    SIXELSTATUS build_chain(in loader_manager_build_request const *request);
    [borrows(selected_loader)]
    SIXELSTATUS load(
        in chunk const *chunk,
        out loader_component **selected_loader,
        in sixel_load_image_function fn_load,
        in void *load_context);
};

[classid("loader/manager")]
coclass loader_manager_component {
    [default] interface loader_manager;
};

/*
 * Ownership/lifetime:
 * - Existing public sixel_frame_new() returns refcount=1 frame objects.
 * - init_pixels() takes ownership of request->pixels and request->palette,
 *   matching sixel_frame_init().
 * - Public sixel_frame_init_borrowed() is a separate mutable-borrowed API
 *   and is not exposed through this component request.
 * - set_transparency() takes ownership of request->transparent_mask.
 *
 * Encapsulation path:
 * - This header exposes only the object contract and request/view DTOs.
 * - src/frame-private.h remains a temporary storage owner while loader-side
 *   direct-field callers migrate toward this interface.
 * - src/frame.c owns frame operations that need concrete storage access.
 */
enum frame_pixels_kind {
    SIXEL_FRAME_PIXELS_U8 = 0,
    SIXEL_FRAME_PIXELS_FLOAT32 = 1
};

struct frame_pixels_request {
    void *pixels;
    unsigned char *palette;
    int width;
    int height;
    int pixelformat;
    int colorspace; /* negative means infer from pixelformat */
    int ncolors;
    frame_pixels_kind kind;
};

struct frame_pixels_view {
    unsigned char *pixels;
    float *pixels_float32;
    unsigned char *palette;
    int width;
    int height;
    int pixelformat;
    int colorspace;
    int ncolors;
};

struct frame_timeline {
    int delay;
    int frame_no;
    int loop_count;
    int multiframe;
    int handoff_shareable;
};

struct frame_transparency {
    int transparent;
    int alpha_zero_is_transparent;
    unsigned char *transparent_mask;
    size_t transparent_mask_size;
};

/* Internal straight-alpha plane, independent of RGB coordinates and masks.
 * get_alpha() borrows storage; set_alpha() takes ownership only on success.
 * A NULL plane with count zero removes fractional coverage. */
struct frame_alpha {
    float *values;
    size_t count;
};

[component, refcounted]
[responsibility("own pixel storage and per-frame metadata")]
[forbid_state("lookup_policy", "dither_policy", "decode_state")]
interface frame {
    [lifetime(retained)]
    void ref();
    [lifetime(release)]
    void unref();
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS init_pixels(in frame_pixels_request const *request);
    [borrows(pixels_view)]
    SIXELSTATUS get_pixels(out frame_pixels_view *view);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS set_pixelformat(in int pixelformat);
    SIXELSTATUS get_timeline(out frame_timeline *timeline);
    [mutates]
    SIXELSTATUS set_timeline(in frame_timeline const *timeline);
    SIXELSTATUS get_transparency(out frame_transparency *transparency);
    [mutates]
    SIXELSTATUS set_transparency(in frame_transparency const *transparency);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS resize(
        in int width,
        in int height,
        in int method_for_resampling);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS resize_float32(
        in int width,
        in int height,
        in int method_for_resampling);
    [mutates, invalidates(pixels_view)]
    SIXELSTATUS clip(in int x, in int y, in int width, in int height);
    SIXELSTATUS measure_storage(out size_t *storage_bytes);
    SIXELSTATUS clone(
        in allocator *allocator,
        out frame **frame_out);
    SIXELSTATUS get_alpha(out frame_alpha *alpha);
    [mutates]
    SIXELSTATUS set_alpha(in frame_alpha const *alpha);
};

[classid("image/frame")]
coclass frame_component {
    [default] interface frame;
};

cpp_quote <<
static inline sixel_frame_interface_t *
sixel_frame_as_interface(sixel_frame_t const *frame)
{
    return (sixel_frame_interface_t *)frame;
}
>>

