/* handle type of dither context object */
struct sixel_dither;
typedef struct sixel_dither sixel_dither_t;

#ifdef __cplusplus
extern "C" {
#endif

/* create dither context object */
SIXELAPI SIXELSTATUS
sixel_dither_new(
    sixel_dither_t      /* out */   **ppdither,  /* dither object to be created */
    int                 /* in */    ncolors,     /* required colors */
    sixel_allocator_t   /* in */    *allocator); /* allocator, null if you use
                                                    default allocator */

/* create dither context object */
SIXELAPI @attr_func_deprecated@ sixel_dither_t *
sixel_dither_create(int /* in */ ncolors); /* number of colors */

/* get built-in dither context object */
SIXELAPI sixel_dither_t *
sixel_dither_get(int builtin_dither); /* ID of built-in dither object */

/* destroy dither context object */
SIXELAPI void
sixel_dither_destroy(sixel_dither_t *dither); /* dither context object */

/* increase reference count of dither context object (thread-unsafe) */
SIXELAPI void
sixel_dither_ref(sixel_dither_t *dither); /* dither context object */

/* decrease reference count of dither context object (thread-unsafe) */
SIXELAPI void
sixel_dither_unref(sixel_dither_t *dither); /* dither context object */

/*
 * Initialize the palette from the buffer format specified by pixelformat.
 * RGBFLOAT32, LINEARRGBFLOAT32, OKLABFLOAT32, CIELABFLOAT32 and DIN99DFLOAT32
 * use three float components per pixel, despite the byte-pointer signature.
 * Default CPU initialization with inactive snap retains that domain through
 * lookup. A separate gamma RGB output copy is rounded for SIXEL; query format
 * changes do not reinterpret the palette.
 * A failed native palette build requires successful reinitialization or an
 * explicit byte palette assignment before encoding again.
 */
SIXELAPI SIXELSTATUS
sixel_dither_initialize(
    sixel_dither_t *dither,                    /* dither context object */
    unsigned char /* in */ *data,              /* sample image */
    int           /* in */ width,              /* image width */
    int           /* in */ height,             /* image height */
    int           /* in */ pixelformat,        /* one of enum pixelFormat */
    int           /* in */ method_for_largest, /* method for finding the largest dimension */
    int           /* in */ method_for_rep,     /* method for choosing a color from the box */
    int           /* in */ quality_mode);      /* quality of histogram processing */

/* choose lookup table policy */
SIXELAPI void
sixel_dither_set_lut_policy(
    sixel_dither_t *dither,  /* dither context object */
    int             lut_policy);  /* one of SIXEL_LUT_POLICY_* */

/* query lookup table policy */
SIXELAPI int
sixel_dither_get_lut_policy(
    sixel_dither_t *dither);  /* dither context object */

/* set diffusion type, choose from enum methodForDiffuse */
SIXELAPI void
sixel_dither_set_diffusion_type(
    sixel_dither_t /* in */ *dither,   /* dither context object */
    int /* in */ method_for_diffuse);  /* one of enum methodForDiffuse */

/* set scan order for diffusion, choose from enum methodForScan */
SIXELAPI void
sixel_dither_set_diffusion_scan(
    sixel_dither_t /* in */ *dither, /* dither context object */
    int /* in */ method_for_scan);   /* one of enum methodForScan */

/*
 * Set paired FS coefficient perturbation (default zero). Other diffusion
 * methods ignore this setting. Non-finite or out-of-range values, and a
 * null dither, return SIXEL_BAD_ARGUMENT without changing the setting.
 */
SIXELAPI SIXELSTATUS
sixel_dither_set_diffusion_perturb(
    sixel_dither_t *dither,
    float perturb);

/* Set the deterministic coordinate-hash seed (default zero). */
SIXELAPI SIXELSTATUS
sixel_dither_set_diffusion_perturb_seed(
    sixel_dither_t *dither,
    int seed);

/*
 * Set error-diffusion correction limits (default AUTO, threshold 1.01).
 * Threshold must be finite and in [1, 16], including for HARD/NONE where
 * it is inactive. Invalid arguments leave both settings unchanged.
 * Settings belong to this dither instance and ignore environment defaults.
 */
SIXELAPI SIXELSTATUS
sixel_dither_set_clamp_policy(
    sixel_dither_t *dither,
    int policy,
    double threshold);

/* get number of palette colors */
SIXELAPI int
sixel_dither_get_num_of_palette_colors(
    sixel_dither_t /* in */ *dither);  /* dither context object */

/* get number of histogram colors */
SIXELAPI int
sixel_dither_get_num_of_histogram_colors(
    sixel_dither_t /* in */ *dither);  /* dither context object */

SIXELAPI @attr_func_deprecated@ int /* typoed! remains for compatibility. */
sixel_dither_get_num_of_histgram_colors(
    sixel_dither_t /* in */ *dither);  /* dither context object */

/*
 * Borrow mutable compatibility bytes. Reading does not discard a native
 * float palette. A write makes the byte view authoritative at the next apply
 * or encode; the pointer must not be retained across reinitialization.
 * For a native linear palette, recover linear values as byte / 255.
 * Perceptual lightness uses byte / 255. Opponent axes use byte / 255 - 0.5,
 * multiplied by 1 (Oklab), 3 (CIELAB) or 2 (DIN99d).
 * Byte assignment narrows precision but preserves the initialized domain.
 */
SIXELAPI @attr_func_deprecated@ unsigned char *
sixel_dither_get_palette(
    sixel_dither_t /* in */ *dither);  /* dither context object */

/* Assign an authoritative byte palette, replacing retained float precision. */
SIXELAPI void
sixel_dither_set_palette(
    sixel_dither_t /* in */ *dither,   /* dither context object */
    unsigned char  /* in */ *palette);

/*
 * Keep this API for backward compatibility.
 * Complexion correction is retired and this setter is a no-op.
 */
SIXELAPI @attr_func_deprecated@ void
sixel_dither_set_complexion_score(
    sixel_dither_t /* in */ *dither,   /* dither context object */
    int            /* in */ score);    /* ignored */

/* set whether omitting palette difinition */
SIXELAPI void
sixel_dither_set_body_only(
    sixel_dither_t /* in */ *dither,   /* dither context object */
    int            /* in */ bodyonly); /* 0: output palette section(default)
                                          1: do not output palette section */
/*
 * Keep this API for backward compatibility.
 * Palette-entry minimization is retired and this setter is a no-op.
 */
SIXELAPI void
sixel_dither_set_optimize_palette(
    sixel_dither_t /* in */ *dither,   /* dither context object */
    int            /* in */ do_opt);   /* ignored */
/* set pixelformat */
SIXELAPI void
sixel_dither_set_pixelformat(
    sixel_dither_t /* in */ *dither,      /* dither context object */
    int            /* in */ pixelformat); /* one of enum pixelFormat */

/* set final merge policy */
SIXELAPI void
sixel_dither_set_final_merge(
    sixel_dither_t /* in */ *dither,
    int            /* in */ final_merge);

/* set transparent */
SIXELAPI void
sixel_dither_set_transparent(
    sixel_dither_t /* in */ *dither,      /* dither context object */
    int            /* in */ transparent); /* transparent color index */

#ifdef __cplusplus
}
#endif

/* converter API */

typedef void * (* sixel_allocator_function)(size_t size);

#ifdef __cplusplus
extern "C" {
#endif

/*
 * Convert pixels into SIXEL and write to the output context. The dither's
 * pixelformat determines buffer layout; pixels may point to float components
 * cast to unsigned char *. The depth argument is retained for compatibility.
 * Encoding may modify the caller's pixel buffer.
 */
SIXELAPI SIXELSTATUS
sixel_encode(
    unsigned char  /* in */ *pixels,     /* pixel bytes */
    int            /* in */  width,      /* image width */
    int            /* in */  height,     /* image height */
    int            /* in */  depth,      /* color depth: now unused */
    sixel_dither_t /* in */ *dither,     /* dither context */
    sixel_output_t /* in */ *context);   /* output context */

/*
 * Convert sixel data into indexed pixel bytes and palette data.
 *
 * A decoded pixel value in [0, *ncolors) is a palette index. A value greater
 * than or equal to *ncolors is a transparent/unpainted pixel and must not be
 * used to index palette.
 */
SIXELAPI SIXELSTATUS
sixel_decode_raw(
    unsigned char       /* in */  *p,           /* sixel bytes */
    int                 /* in */  len,          /* size of sixel bytes */
    unsigned char       /* out */ **pixels,     /* decoded pixels */
    int                 /* out */ *pwidth,      /* image width */
    int                 /* out */ *pheight,     /* image height */
    unsigned char       /* out */ **palette,    /* RGB palette */
    int                 /* out */ *ncolors,     /* palette size (<= 256) */
    sixel_allocator_t   /* in */  *allocator);  /* allocator object or null */

/* convert sixel data into direct-color pixels */
SIXELAPI SIXELSTATUS
sixel_decode_direct(
    unsigned char       /* in */  *p,          /* sixel bytes */
    int                 /* in */  len,         /* size of sixel bytes */
    unsigned char       /* out */ **pixels,    /* decoded RGBA pixels */
    int                 /* out */ *pwidth,     /* image width */
    int                 /* out */ *pheight,    /* image height */
    sixel_allocator_t   /* in */  *allocator); /* allocator object or null */

/*
 * Decode options for sixel_decode_pixels().
 *
 * By default, raster attributes are treated as the declared canvas size, but
 * the decoder still keeps pixels that are actually painted outside that
 * rectangle.  This matters because SIXEL uses six-pixel-high bands, and some
 * streams declare a height that is not aligned to that band size.
 *
 * TRUST_RASTER_SIZE is an optimization hint for callers that already trust the
 * raster attributes.  When this flag is set, pixels outside the declared
 * raster width or height are discarded instead of growing the output frame.
 * The result flags still report that such paint was seen and clipped.
 */
#define SIXEL_DECODE_PIXELS_OPTION_TRUST_RASTER_SIZE 0x0001u

/*
 * Result flags returned by sixel_decode_pixels().
 *
 * ALPHA_OPAQUE means that the returned buffer can be treated as fully opaque.
 * For alpha-bearing formats, every returned alpha byte is 0xff.  For RGB and
 * XRGB/RGBX/XBGR/BGRX formats this flag is always set because transparent
 * pixels have already been composited over options->bgcolor and no alpha
 * channel is returned.
 *
 * PAINT_OUTSIDE_RASTER means that at least one non-empty SIXEL paint operation
 * addressed pixels outside the width or height declared by raster attributes.
 * Without TRUST_RASTER_SIZE, those pixels are preserved and the output frame
 * may be larger than the declared raster size.
 *
 * CLIPPED_TO_RASTER means that PAINT_OUTSIDE_RASTER was seen while
 * TRUST_RASTER_SIZE was set, so the out-of-raster pixels were discarded and
 * the output frame was clipped to the declared raster size.
 */
#define SIXEL_DECODE_PIXELS_RESULT_ALPHA_OPAQUE         0x0001u
#define SIXEL_DECODE_PIXELS_RESULT_PAINT_OUTSIDE_RASTER 0x0002u
#define SIXEL_DECODE_PIXELS_RESULT_CLIPPED_TO_RASTER    0x0004u
/*
 * PALETTE_REDEFINED means a color register was redefined after painting
 * had already started, so the stream cannot be represented by one index
 * plane plus one palette.  High color output (img2sixel -I) is built that
 * way, and decoders that work on indexed pixels must not trust them.
 */
#define SIXEL_DECODE_PIXELS_RESULT_PALETTE_REDEFINED    0x0008u

typedef struct sixel_decode_options {
    unsigned int flags;        /* bitwise OR of SIXEL_DECODE_PIXELS_OPTION_* */
    int preferred_pixelformat; /* desired output format, or 0 for RGBA8888 */
    unsigned char bgcolor[3];  /* RGB background for RGB/X output */
} sixel_decode_options_t;

typedef struct sixel_decode_result {
    unsigned char *pixels;     /* decoded pixel buffer */
    int width;                 /* image width */
    int height;                /* image height */
    int pixelformat;           /* actual output pixelformat */
    int stride;                /* bytes per output row */
    unsigned int flags;        /* bitwise OR of SIXEL_DECODE_PIXELS_RESULT_* */
} sixel_decode_result_t;

#define SIXEL_HAVE_PALETTE_TRANSFORM 1

/*
 * Map palette RGB8 values before painting, preserving the distinction between
 * a default color (is_default == 1) and an explicit RGB/HLS definition (0).
 * The callback replaces rgb with coordinates in the caller's output space.
 * It must be deterministic and reentrant: retries may repeat a definition,
 * and callers may run independent decodes concurrently with the same context.
 * No invocation count or ordering is promised. Selection alone does not map
 * an already mapped entry again. Transform and context are borrowed only for
 * the duration of the decode call, including any workers it joins.
 *
 * This interface supplies no CMS or color-distance model. Reconstruction in
 * a decoder object operates on the mapped RGB values. options->bgcolor must
 * already use that same output space; it is not passed through the callback.
 * A null transform preserves the unmapped API. A nonnull transform requires
 * a nonnull map_rgb callback. The existing options/result layouts are intact.
 */
typedef struct sixel_palette_transform {
    void *context;
    void (*map_rgb)(void *context, unsigned char rgb[3], int is_default);
} sixel_palette_transform_t;

SIXELAPI SIXELSTATUS
sixel_decode_pixels_mapped(unsigned char const *data,
                           size_t size,
                           sixel_decode_options_t const *options,
                           sixel_palette_transform_t const *transform,
                           sixel_decode_result_t *result,
                           sixel_allocator_t *allocator);

SIXELAPI SIXELSTATUS
sixel_decode_pixels_body_mapped(unsigned char const *body,
                                size_t body_size,
                                int const *params,
                                size_t nparams,
                                sixel_decode_options_t const *options,
                                sixel_palette_transform_t const *transform,
                                sixel_decode_result_t *result,
                                sixel_allocator_t *allocator);

SIXELAPI SIXELSTATUS
sixel_decode_pixels(unsigned char const /* in */ *data,
                    size_t              /* in */ size,
                    sixel_decode_options_t const
                                        /* in */ *options,
                    sixel_decode_result_t
                                        /* out */ *result,
                    sixel_allocator_t   /* in */ *allocator);

/*
 * Decode a DECSIXEL body after the caller has already consumed the DCS
 * introducer, DCS q parameters, q final byte, and string terminator.  params is
 * the normalized integer list from "DCS P1;P2;P3 q"; raster and color
 * parameters that live inside the body remain encoded in body bytes.
 */
#define SIXEL_HAVE_DECODE_PIXELS_BODY 1

SIXELAPI SIXELSTATUS
sixel_decode_pixels_body(unsigned char const /* in */ *body,
                         size_t              /* in */ body_size,
                         int const           /* in */ *params,
                         size_t              /* in */ nparams,
                         sixel_decode_options_t const
                                             /* in */ *options,
                         sixel_decode_result_t
                                             /* out */ *result,
                         sixel_allocator_t   /* in */ *allocator);

/*
 * Deprecated compatibility API. It follows the same indexed-pixel contract as
 * sixel_decode_raw(): values greater than or equal to *ncolors are
 * transparent/unpainted pixels and must not be used to index palette.
 */
SIXELAPI @attr_func_deprecated@ SIXELSTATUS
sixel_decode(
    unsigned char            /* in */  *sixels,    /* sixel bytes */
    int                      /* in */  size,       /* size of sixel bytes */
    unsigned char            /* out */ **pixels,   /* decoded pixels */
    int                      /* out */ *pwidth,    /* image width */
    int                      /* out */ *pheight,   /* image height */
    unsigned char            /* out */ **palette,  /* RGB palette */
    int                      /* out */ *ncolors,   /* palette size (<= 256) */
    sixel_allocator_function /* in */  fn_malloc); /* malloc function */

#ifdef __cplusplus
}
#endif

/* helper API */

#ifdef __cplusplus
extern "C" {
#endif

SIXELAPI void
sixel_tty_init_output_device(int fd);

SIXELAPI void
sixel_helper_set_additional_message(
    const char      /* in */  *message         /* error message */
);

SIXELAPI char const *
sixel_helper_get_additional_message(void);

/* convert error status code int formatted string */
SIXELAPI char const *
sixel_helper_format_error(
    SIXELSTATUS     /* in */  status           /* status code */
);

/* compute pixel depth from pixelformat */
SIXELAPI int
sixel_helper_compute_depth(
    int /* in */ pixelformat /* one of enum pixelFormat */
);

/* convert pixelFormat into PIXELFORMAT_RGB888 */
SIXELAPI SIXELSTATUS
sixel_helper_normalize_pixelformat(
    unsigned char       /* out */ *dst,             /* destination buffer */
    int                 /* out */ *dst_pixelformat, /* converted pixelformat */
    unsigned char const /* in */  *src,             /* source pixels */
    int                 /* in */  src_pixelformat,  /* format of source image */
    int                 /* in */  width,            /* width of source image */
    int                 /* in */  height            /* height of source image */
);

/*
 * Scale image to specified size.  Inputs whose computed depth is not three
 * bytes are normalized before scaling, and dst uses the resulting normalized
 * layout.  Allocate dst for that effective pixel format: RGB888 for G8,
 * packed-RGB, alpha-bearing, and float inputs; G8 or PAL8 for packed gray or
 * palette inputs.
 */
SIXELAPI SIXELSTATUS
sixel_helper_scale_image(
    unsigned char       /* out */ *dst,                  /* destination buffer */
    unsigned char const /* in */  *src,                  /* source image data */
    int                 /* in */  srcw,                  /* source image width */
    int                 /* in */  srch,                  /* source image height */
    int                 /* in */  pixelformat,           /* one of enum pixelFormat */
    int                 /* in */  dstw,                  /* destination image width */
    int                 /* in */  dsth,                  /* destination image height */
    int                 /* in */  method_for_resampling, /* one of methodForResampling */
    sixel_allocator_t   /* in */  *allocator             /* allocator object */
);

/* Convert packed pixels in place; size is in bytes. Float32 triplets keep
 * finite negative and above-one coordinates. Numeric conversion failures
 * leave the float buffer untouched. Byte formats retain their bounded
 * storage and LUT/SIMD paths. Equal source/target spaces are a no-op. */
SIXELAPI SIXELSTATUS
sixel_helper_convert_colorspace(
    unsigned char       /* in/out */ *pixels,
    size_t              /* in */      size,
    int                 /* in */      pixelformat,
    int                 /* in */      colorspace_src,
    int                 /* in */      colorspace_dst);

/*
 * CLI frontends call this helper so they default to the friendlier
 * suggestions while keeping library usage opt-in.
 */
SIXELAPI void
sixel_option_apply_cli_suggestion_defaults(void);

