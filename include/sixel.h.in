typedef SIXELSTATUS (* sixel_load_image_function)(
    sixel_frame_t /* in */     *frame,
    void          /* in/out */ *context);

/*
 * Return non-zero to request cancellation of the current load/encode process.
 */
typedef int (* sixel_cancel_function)(
    void /* in */ *context);

/* handle type of generic loader object */
struct sixel_loader;
typedef struct sixel_loader sixel_loader_t;

/* option identifiers for sixel_loader_setopt() */
#define SIXEL_LOADER_OPTION_REQUIRE_STATIC    (1)
#define SIXEL_LOADER_OPTION_USE_PALETTE       (2)
#define SIXEL_LOADER_OPTION_REQCOLORS         (3)
#define SIXEL_LOADER_OPTION_BGCOLOR           (4)
#define SIXEL_LOADER_OPTION_LOOP_CONTROL      (5)
#define SIXEL_LOADER_OPTION_INSECURE          (6)
#define SIXEL_LOADER_OPTION_CANCEL_FLAG       (7)
#define SIXEL_LOADER_OPTION_LOADER_ORDER      (8)
#define SIXEL_LOADER_OPTION_CONTEXT           (9)
#define SIXEL_LOADER_OPTION_WIC_ICO_MINSIZE   (10)
#define SIXEL_LOADER_OPTION_START_FRAME_NO    (11)
#define SIXEL_LOADER_OPTION_BGCOLOR_SOURCE    (12)
#define SIXEL_LOADER_OPTION_BACKGROUND_POLICY (13)

/* values for SIXEL_LOADER_OPTION_BGCOLOR_SOURCE */
#define SIXEL_LOADER_BGCOLOR_SOURCE_EXPLICIT  (0)
#define SIXEL_LOADER_BGCOLOR_SOURCE_ENV       (1)

/* create loader object */
SIXELAPI SIXELSTATUS
sixel_loader_new(
    sixel_loader_t   /* out */ **pploader,
    sixel_allocator_t/* in */  *allocator);

/* increase reference count of loader object (thread-unsafe) */
SIXELAPI void
sixel_loader_ref(
    sixel_loader_t /* in */ *loader);

/* decrease reference count of loader object (thread-unsafe) */
SIXELAPI void
sixel_loader_unref(
    sixel_loader_t /* in */ *loader);

/* set loader options */
SIXELAPI SIXELSTATUS
sixel_loader_setopt(
    sixel_loader_t /* in */ *loader,
    int            /* in */ option,
    void const     /* in */ *value);

/* load an image file using loader configuration */
SIXELAPI SIXELSTATUS
sixel_loader_load_file(
    sixel_loader_t         /* in */ *loader,
    char const             /* in */ *filename,
    sixel_load_image_function /* in */ fn_load);

/* Note: this function returns SIXEL_OK without calling FN_LOAD when the file
   content is empty or 1-byte LF.  This implies an assumption that CONTEXT is
   initialized to be the default value for the empty file before calling this
   function.  If it is not the case, the caller needs to properly detect it and
   handle this, or otherwise, CONTEXT can be used uninitialized in subsequent
   codes. */
SIXELAPI @attr_func_deprecated@ SIXELSTATUS
sixel_helper_load_image_file(
    char const                /* in */     *filename,     /* source file name */
    int                       /* in */     fstatic,       /* whether to extract static image */
    int                       /* in */     fuse_palette,  /* whether to use paletted image */
    int                       /* in */     reqcolors,     /* requested number of colors */
    unsigned char             /* in */     *bgcolor,      /* background color */
    int                       /* in */     loop_control,  /* one of enum loopControl */
    sixel_load_image_function /* in */     fn_load,       /* callback */
    int                       /* in */     finsecure,     /* true if do not verify SSL */
    int const                 /* in */     *cancel_flag,  /* cancel flag */
    void                      /* in/out */ *context,      /* private data for callback */
    sixel_allocator_t         /* in */     *allocator);   /* allocator object */

/* enumerate loader names currently compiled into the library */
SIXELAPI size_t
sixel_helper_get_available_loader_names(
    char const          /* out */ **names,
    size_t              /* in */     max_names);

/* probe helpers for SIXEL signature detection */
SIXELAPI SIXELSTATUS
sixel_probe_is_probable(unsigned char const /* in */ *data,
                        size_t              /* in */ len);

SIXELAPI SIXELSTATUS
sixel_parse_header(unsigned char const /* in */ *ibuf,
                   size_t             /* in */ headsize,
                   unsigned int       /* out */ **pparams,
                   size_t             /* out */ *pparamsize,
                   sixel_allocator_t  /* in */ *allocator);

/* write image to file */
SIXELAPI SIXELSTATUS
sixel_helper_write_image_file(
    unsigned char       /* in */ *data,        /* source pixel data */
    int                 /* in */ width,        /* source data width */
    int                 /* in */ height,       /* source data height */
    unsigned char       /* in */ *palette,     /* palette of source data */
    int                 /* in */ pixelformat,  /* source pixelFormat */
    char const          /* in */ *filename,    /* destination filename */
    int                 /* in */ imageformat,  /* one of enum imageformat */
    sixel_allocator_t   /* in */ *allocator);  /* allocator object */

#ifdef __cplusplus
}
#endif


/* easy encoder API
 *
 * Thread-enabled builds serialize individual encoder calls. The caller
 * serializes compound operations such as origin + frame, and all access in
 * thread-disabled builds. Callbacks must not reenter the active encoder.
 * Keep referenced objects alive through active and waiting calls; a last
 * reference release cannot race those calls. Internal frame workers are
 * distinct from application calls and do not change this lifetime contract.
 */

/* handle type of dither context object */
struct sixel_encoder;
typedef struct sixel_encoder sixel_encoder_t;

#ifdef __cplusplus
extern "C" {
#endif

/* create encoder object */
SIXELAPI SIXELSTATUS
sixel_encoder_new(
    sixel_encoder_t     /* out */ **ppencoder, /* encoder object to be created */
    sixel_allocator_t   /* in */  *allocator); /* allocator, null if you use
                                                  default allocator */

/* deprecated version of sixel_decoder_new() */
SIXELAPI @attr_func_deprecated@ sixel_encoder_t *
sixel_encoder_create(void);

/* increase encoder reference count through the atomic compatibility layer */
SIXELAPI void
sixel_encoder_ref(sixel_encoder_t /* in */ *encoder);

/* decrease encoder reference count through the atomic compatibility layer */
SIXELAPI void
sixel_encoder_unref(sixel_encoder_t /* in */ *encoder);

/* deprecated: use sixel_encoder_set_cancel_callback() instead */
SIXELAPI @attr_func_deprecated@ SIXELSTATUS
sixel_encoder_set_cancel_flag(
    sixel_encoder_t /* in */ *encoder,
    int             /* in */ *cancel_flag);

/*
 * Set a cancellation callback. Returns non-zero from CANCEL_FUNCTION to stop.
 * CANCEL_CONTEXT is passed to each callback invocation as-is.
 */
SIXELAPI SIXELSTATUS
sixel_encoder_set_cancel_callback(
    sixel_encoder_t       /* in */ *encoder,
    sixel_cancel_function /* in */ cancel_function,
    void                  /* in */ *cancel_context);

/*
 * Set the previous RGB plane used by 6delta encoding.  Plain
 * alpha-policy=keep/P2=1 does not need this buffer; it is only
 * consulted after 6delta is explicitly enabled, for example with
 * --update-policy=delta.  The buffer is copied as RGB888.  Pass NULL for PIXELS
 * to clear the retained 6delta buffer. Its normalized RGB values describe
 * the output color interpretation selected when this function is called;
 * this is not a loader/CMS conversion of a previous source image. For native
 * RGB output, supply emitted RGB101 expanded to RGB888. Select -U before
 * seeding. A later incompatible output interpretation cannot reuse this
 * history; working-space or precision changes alone do not invalidate it.
 *
 * The supplied buffer becomes the retained plane, so it also defines the plane
 * geometry that sixel_encoder_set_6delta_plane_size() would otherwise declare.
 */
SIXELAPI SIXELSTATUS
sixel_encoder_set_accumulation_buffer(
    sixel_encoder_t     /* in */ *encoder,
    unsigned char const /* in */ *pixels,
    int                 /* in */ width,
    int                 /* in */ height,
    int                 /* in */ pixelformat);

#define SIXEL_HAVE_ENCODER_6DELTA_PLANE 1

/*
 * Declare the size of the surface that 6delta keeps history for.  By default
 * the retained plane is exactly the frame being encoded, which means a caller
 * that encodes a different sub-rectangle each frame gets no keeps at all.
 * Callers that repaint parts of a larger, persistent surface -- a remote
 * desktop sending damage rectangles, for example -- should declare that whole
 * surface here once and then place each frame with
 * sixel_encoder_set_6delta_plane_origin().
 *
 * Changing the size discards the retained plane.  Passing 0 for both extents
 * restores the default "plane == frame" behaviour.
 */
SIXELAPI SIXELSTATUS
sixel_encoder_set_6delta_plane_size(
    sixel_encoder_t /* in */ *encoder,
    int             /* in */ width,
    int             /* in */ height);

/*
 * Place the next encoded frame at X,Y inside the declared plane.  The origin
 * persists until changed, so a caller that always encodes the full plane never
 * has to call this.  A frame that does not fit inside the plane at this origin
 * is encoded without any 6delta keep, and discards the retained plane.
 */
SIXELAPI SIXELSTATUS
sixel_encoder_set_6delta_plane_origin(
    sixel_encoder_t /* in */ *encoder,
    int             /* in */ x,
    int             /* in */ y);

/*
 * Discard the retained plane without changing its declared size.  Call this
 * whenever something outside libsixel repaints the surface -- a scroll, a
 * resize, an overlay drawn by the application -- because the retained plane no
 * longer describes what the terminal shows.  The next frame is then emitted in
 * full instead of keeping pixels against stale history.
 */
SIXELAPI SIXELSTATUS
sixel_encoder_invalidate_6delta_plane(
    sixel_encoder_t /* in */ *encoder);

#define SIXEL_HAVE_ENCODER_6DELTA_REFINEMENT 2

/* UPDATE_POLICY delta:R1 enables persistent residual threshold control. */
#define SIXEL_HAVE_ENCODER_6DELTA_RESIDUAL 1

/* Limit the effective delta threshold without changing its configured maximum
 * or the retained plane. 0 requests exact-threshold refinement; 255 removes
 * the runtime limit (the default). Values above 255 are rejected. The limit
 * persists until changed and is private to this encoder instance. */
SIXELAPI SIXELSTATUS
sixel_encoder_set_6delta_threshold_limit(
    sixel_encoder_t *encoder,
    unsigned int threshold);

/* After a successful frame, return nonzero when at least one nonexact
 * threshold keep was recorded, even if other pixels were painted. The caller
 * may re-encode the latest source with limit 0, retaining normal delta
 * history. This function neither schedules work nor retains source pixels.
 * Re-evaluating at zero clears the request even if post-lookup keeps remain.
 * A later frame replaces this result; callers own pending rectangle tracking.
 * NULL and invalidated encoders return zero. */
SIXELAPI int
sixel_encoder_needs_6delta_refinement(sixel_encoder_t const *encoder);

/* Number of opaque pixels painted by the latest successful delta frame.
 * Paired with needs_6delta_refinement, this distinguishes zero painting from
 * a small update even when palette/protocol overhead is large. NULL, disabled
 * and invalidated encoders return zero. No additional pixel scan is needed. */
SIXELAPI size_t
sixel_encoder_get_6delta_painted_pixels(sixel_encoder_t const *encoder);

/* set an option flag to encoder object */
SIXELAPI SIXELSTATUS
sixel_encoder_setopt(
    sixel_encoder_t /* in */ *encoder,
    int             /* in */ arg,
    char const      /* in */ *optarg);

/* load source data from specified file and encode it to SIXEL format */
SIXELAPI SIXELSTATUS
sixel_encoder_encode(
    sixel_encoder_t /* in */ *encoder,
    char const      /* in */ *filename);

#define SIXEL_HAVE_ENCODER_ENCODE_FRAME 1

/* encode an initialized frame to SIXEL format */
SIXELAPI SIXELSTATUS
sixel_encoder_encode_frame(
    sixel_encoder_t /* in */ *encoder,
    sixel_frame_t   /* in */ *frame,
    sixel_output_t  /* in */ *output);

/*
 * Frame playback queue.
 *
 * A playback object accepts frames one at a time from the application and
 * encodes them in submission order on internal workers, producing the same
 * bytes as calling sixel_encoder_encode_frame() for each frame in turn.  In
 * thread-enabled builds the palette of the next frame is constructed while
 * the current frame is diffused and written, so frames flow faster than
 * through repeated direct calls.  Thread-disabled builds encode inside the
 * submitting call; there only reservations hold slots, and a wait for a
 * slot times out at once because nothing else could free one.
 *
 * Backpressure.  Every frame occupies one of CAPACITY slots from admission
 * until its completion callback; reservations also occupy a slot.  When no
 * slot is free, SIXEL_PLAYBACK_NOWAIT admission returns SIXEL_QUEUE_FULL and
 * SIXEL_PLAYBACK_WAIT admission blocks, returning SIXEL_TIMEOUT once
 * TIMEOUT_MS milliseconds pass (a negative timeout waits indefinitely).
 * Rejected frames are never queued.  Applications that capture or decode
 * frames should reserve a slot first and produce the frame only after the
 * reservation succeeds, so work is not spent on frames that would be refused.
 *
 * Ownership.  An admitted frame is referenced by the playback object and
 * may be modified by encoding; the caller must neither read nor modify it
 * until its completion callback has run.  Per-frame 6delta placement and
 * threshold limits are taken from the submission options, not from the
 * encoder at the time the frame is encoded.
 *
 * While a playback object is attached, other calls on its encoder fail with
 * SIXEL_BAD_ARGUMENT; release the playback object to use the encoder
 * directly again.  The completion callback runs on a playback worker in
 * submission order; it must not call the playback object or its encoder.
 * sixel_helper_get_additional_message() inside the callback describes a
 * failed frame.  After a failure, frames not yet started complete with
 * SIXEL_INTERRUPTED and later admissions return the first failure status.
 * Progressive repair contexts, DRCS output and paired presentation are not
 * supported by playback.
 *
 * Threads.  Playback follows the owning encoder threading policy
 * (SIXEL_OPTFLAG_THREADING_POLICY and the SIXEL_ENCODER_THREADING_*
 * environment): lazy overlaps independent stages with one default dither band,
 * balanced uses size heuristics and performance CPUs, and greedy uses the full
 * global_budget without size thresholds. The library budget defaults to min(4,
 * performance logical CPUs) in every mode. global_budget accepts a positive
 * count or all (logical CPUs, capped by balanced). A mode alone does not raise
 * that budget. CLI budget, API setter, per-key environment, then library
 * defaults determine the count. Explicit stage keys override mode defaults and
 * shrink to fit the budget. Load and prepare default to ahead; prepare selects
 * whether the next frame is prepared during emission. CAPACITY, not the
 * policy's load_depth, bounds admission. palette_mode is the per-object
 * counterpart of the policy's palette key. An explicit CONFIG overrides the
 * encoder, including PER_FRAME (zero); NULL CONFIG inherits the encoder.
 * LATEST reuses the newest completed palette with source sequence <= the
 * current sequence. Selection occurs once, after delay, before LUT/gradient
 * setup. CPU generated palettes can overlap their own build and application,
 * including RGB submissions with multiframe=0. The first frame waits for its
 * own palette. One-worker/nonthreaded and feature fallback use PER_FRAME.
 * Delta, native color output, export, GPU and macros currently use PER_FRAME.
 * The requested mode is frozen for the session without changing the encoder.
 * palette_sequence identifies the selected source; zero means no selection.
 * Fixed/indexed/high-color bypass reports the current sequence on success
 * and starts a new palette epoch. PER_FRAME failures report zero. LATEST
 * retains a selected sequence on later failure, including own-build failure
 * after emission. Written bytes cannot be rolled back. Drain joins own builds
 * before completion; detach and a new input discard the session's palettes.
 */
#define SIXEL_HAVE_PLAYBACK 1

struct sixel_playback;
typedef struct sixel_playback sixel_playback_t;

#define SIXEL_PLAYBACK_CAPACITY_MAX       16
#define SIXEL_PLAYBACK_DEFAULT_CAPACITY   2

/* admission modes */
#define SIXEL_PLAYBACK_NOWAIT             0
#define SIXEL_PLAYBACK_WAIT               1

/* Palette dependency modes; unsupported features use PER_FRAME. */
#define SIXEL_PLAYBACK_PALETTE_PER_FRAME  0
#define SIXEL_PLAYBACK_PALETTE_LATEST     1

/* sixel_playback_options_t.flags */
#define SIXEL_PLAYBACK_OPTION_ORIGIN          0x1  /* apply origin_x/y */
#define SIXEL_PLAYBACK_OPTION_THRESHOLD_LIMIT 0x2  /* apply threshold_limit */

typedef struct sixel_playback_result {
    size_t struct_size;
    uint64_t user_tag;              /* copied from the submission options */
    uint64_t sequence;              /* admission order, starting at one */
    SIXELSTATUS status;
    size_t painted_pixels;          /* see sixel_encoder_get_6delta_... */
    int needs_6delta_refinement;    /* see sixel_encoder_needs_6delta_... */
    uint64_t palette_sequence;      /* palette source, or zero; see above */
    double queued_seconds;          /* admission to start of encoding */
    double processing_seconds;      /* start of encoding to completion */
} sixel_playback_result_t;

typedef void (*sixel_playback_done_function)(
    sixel_playback_result_t const *result,
    void *context);

typedef struct sixel_playback_config {
    size_t struct_size;
    unsigned int capacity;          /* 1..SIXEL_PLAYBACK_CAPACITY_MAX */
    int palette_mode;               /* SIXEL_PLAYBACK_PALETTE_* */
    sixel_playback_done_function done;  /* optional */
    void *done_context;
} sixel_playback_config_t;

typedef struct sixel_playback_options {
    size_t struct_size;
    int flags;                      /* SIXEL_PLAYBACK_OPTION_* */
    int origin_x;                   /* as set_6delta_plane_origin() */
    int origin_y;
    unsigned int threshold_limit;   /* as set_6delta_threshold_limit() */
    uint64_t user_tag;
} sixel_playback_options_t;

/* A reservation; valid until submitted or released. */
typedef struct sixel_playback_ticket {
    sixel_playback_t *owner;
    uint64_t id;
} sixel_playback_ticket_t;

typedef struct sixel_playback_stats {
    size_t struct_size;
    unsigned int capacity;
    unsigned int depth;             /* occupied slots, reservations included */
    unsigned int reserved;
    unsigned int free_slots;
    uint64_t submitted;
    uint64_t completed;
    uint64_t rejected;              /* admissions refused or timed out */
    double oldest_wait_seconds;     /* longest wait of a frame not started */
    double last_processing_seconds;
} sixel_playback_stats_t;

/* Initialize supported fields; call with sizeof(*config) or sizeof(*options).
 * Defaults: capacity 2, per-frame palettes, no callback, no flags. */
SIXELAPI SIXELSTATUS
sixel_playback_config_init(sixel_playback_config_t *config,
                           size_t struct_size);

SIXELAPI SIXELSTATUS
sixel_playback_options_init(sixel_playback_options_t *options,
                            size_t struct_size);

/* Attach a playback queue to ENCODER, writing to OUTPUT (NULL selects the
 * encoder destination). The playback object retains both. NULL CONFIG and
 * NULL ALLOCATOR select defaults; NULL CONFIG inherits the encoder palette
 * policy instead of overriding it with PER_FRAME. */
SIXELAPI SIXELSTATUS
sixel_playback_new(sixel_playback_t **playback,
                   sixel_encoder_t *encoder,
                   sixel_output_t *output,
                   sixel_playback_config_t const *config,
                   sixel_allocator_t *allocator);

/* Occupy one slot before producing a frame; see the admission rules above. */
SIXELAPI SIXELSTATUS
sixel_playback_reserve(sixel_playback_t *playback,
                       int mode,
                       int timeout_ms,
                       sixel_playback_ticket_t *ticket);

/* Admit FRAME into a reserved slot; this call never waits for space. NULL
 * OPTIONS selects defaults. The ticket is consumed even on failure. */
SIXELAPI SIXELSTATUS
sixel_playback_submit_reserved(sixel_playback_t *playback,
                               sixel_playback_ticket_t *ticket,
                               sixel_frame_t *frame,
                               sixel_playback_options_t const *options);

/* Return an unused reservation. */
SIXELAPI void
sixel_playback_release_reservation(sixel_playback_t *playback,
                                   sixel_playback_ticket_t *ticket);

/* Reserve and submit in one call. */
SIXELAPI SIXELSTATUS
sixel_playback_submit(sixel_playback_t *playback,
                      sixel_frame_t *frame,
                      int mode,
                      int timeout_ms,
                      sixel_playback_options_t const *options);

/* Wait until every admitted frame has completed. Outstanding reservations
 * are not waited for. Returns SIXEL_TIMEOUT when TIMEOUT_MS passes (negative
 * waits indefinitely) and the first failure status once playback failed. */
SIXELAPI SIXELSTATUS
sixel_playback_drain(sixel_playback_t *playback, int timeout_ms);

/* Discard admitted frames that have not started; each completes with
 * SIXEL_INTERRUPTED. Frames already being encoded finish normally. */
SIXELAPI SIXELSTATUS
sixel_playback_cancel(sixel_playback_t *playback);

/* Snapshot the queue state into STATS, whose struct_size the caller sets to
 * sizeof(*stats); a free slot may be taken immediately after. */
SIXELAPI SIXELSTATUS
sixel_playback_get_stats(sixel_playback_t *playback,
                         sixel_playback_stats_t *stats);

/* Drain, stop the workers and detach from the encoder. */
SIXELAPI void
sixel_playback_unref(sixel_playback_t *playback);

/* Progressive repair operates on the encoder's retained 6delta plane. */
#define SIXEL_HAVE_ENCODER_6DELTA_PROGRESSIVE 1
struct sixel_progressive;
typedef struct sixel_progressive sixel_progressive_t;

#define SIXEL_PROGRESSIVE_NONE             0
#define SIXEL_PROGRESSIVE_FRAME_EMITTED    1
#define SIXEL_PROGRESSIVE_YIELDED          2
#define SIXEL_PROGRESSIVE_CONVERGED        3
#define SIXEL_PROGRESSIVE_STALLED          4
#define SIXEL_PROGRESSIVE_NEEDS_BASELINE   5
#define SIXEL_PROGRESSIVE_NEEDS_SOURCE     6
#define SIXEL_PROGRESSIVE_BUDGET_TOO_SMALL 7
#define SIXEL_PROGRESSIVE_UNSUPPORTED     8

#define SIXEL_PROGRESSIVE_YIELD_NONE           0
#define SIXEL_PROGRESSIVE_YIELD_WORK_BUDGET    1
#define SIXEL_PROGRESSIVE_YIELD_UPDATE_PENDING 2
#define SIXEL_PROGRESSIVE_YIELD_BUSY           3

#define SIXEL_PROGRESSIVE_BACKEND_NONE  0
#define SIXEL_PROGRESSIVE_BACKEND_CPU   1
#define SIXEL_PROGRESSIVE_BACKEND_METAL 2

#define SIXEL_PROGRESSIVE_STAGE_NONE     0
#define SIXEL_PROGRESSIVE_STAGE_AUDIT    1
#define SIXEL_PROGRESSIVE_STAGE_SELECT   2
#define SIXEL_PROGRESSIVE_STAGE_PALETTE  3
#define SIXEL_PROGRESSIVE_STAGE_APPLY    4
#define SIXEL_PROGRESSIVE_STAGE_RESCUE   5
#define SIXEL_PROGRESSIVE_STAGE_PACKET   6
#define SIXEL_PROGRESSIVE_STAGE_COMMIT   7
#define SIXEL_PROGRESSIVE_STAGE_COMPLETE 8

#define SIXEL_PROGRESSIVE_OUTPUT_LEGACY     0
#define SIXEL_PROGRESSIVE_OUTPUT_DISPLAY_P3 1
#define SIXEL_PROGRESSIVE_GPU_INHERIT      (-1)
#define SIXEL_PROGRESSIVE_DEFAULT_PACKET_BYTES 16384
#define SIXEL_PROGRESSIVE_DEFAULT_PIXEL_VISITS 1048576
#define SIXEL_PROGRESSIVE_DEFAULT_DISTANCE_EVALUATIONS 8388608

typedef struct sixel_progressive_config {
    size_t struct_size;
    int stop_distance_auto;
    double stop_distance;
    double selection_fraction;
    unsigned int max_colors;
    unsigned int sample_limit;
    unsigned int candidate_limit;
    double min_gain_ratio;
    unsigned int swap_limit;
    double noise_strength;
    unsigned int noise_phase_x;
    unsigned int noise_phase_y;
    int noise_channel_rgb;
    int gpu_policy;
} sixel_progressive_config_t;

typedef struct sixel_progressive_budget {
    size_t struct_size;
    size_t max_packet_bytes;
    size_t max_pixel_visits;
    size_t max_distance_evaluations;
} sixel_progressive_budget_t;

typedef struct sixel_progressive_stats {
    size_t struct_size;
    int outcome;
    int yield_reason;
    int state_snapshot_valid;
    int audit_complete;
    uint64_t source_generation;
    uint64_t history_revision;
    uint64_t configuration_revision;
    int working_colorspace;
    int output_colorspace;
    int output_color_definition;
    int backend;
    int stage;
    uint64_t selection_round;
    int full_selection;
    size_t domain_count;
    size_t eligible_count;
    size_t invalid_count;
    size_t selected_count;
    size_t painted_pixels;
    size_t unresolved_count;
    double maximum_distance;
    double sum_squared_error;
    double sampled_cost_before;
    double sampled_cost_after;
    unsigned int constructed_colors;
    unsigned int transmitted_colors;
    size_t packet_bytes;
    size_t required_packet_bytes;
    size_t pixel_visits;
    size_t distance_evaluations;
    uint64_t total_pixel_visits;
    uint64_t total_distance_evaluations;
    int zero_noise_used;
    int rescue_used;
} sixel_progressive_stats_t;

/* Initialize supported fields without touching any future structure tail.
 * Call with sizeof(*config); no initialized size tag is required. */
SIXELAPI SIXELSTATUS
sixel_progressive_config_init(sixel_progressive_config_t *config,
                               size_t struct_size);

/* Retain ENCODER and ALLOCATOR, and copy CONFIG. Delta output must already be
 * enabled. A second context on the same encoder is rejected. NULL allocator
 * selects the default. The encoder continues to own the retained plane. */
SIXELAPI SIXELSTATUS
sixel_progressive_new(sixel_progressive_t **context, sixel_encoder_t *encoder,
    sixel_progressive_config_t const *config, sixel_allocator_t *allocator);

/* Copy and preprocess an unprocessed source, without changing the ordinary
 * frame origin or retained history. Generation is nonzero and increasing.
 * Failed refresh leaves the previous binding and its validity unchanged. */
SIXELAPI SIXELSTATUS
sixel_progressive_bind_frame(sixel_progressive_t *context,
    sixel_frame_t *frame, int origin_x, int origin_y, uint64_t generation);

/* Advance bounded work and emit at most one complete transparent packet.
 * Zero-initialize budget/stats and set each struct_size before calling;
 * all three budget limits must be positive. NULL output selects the encoder
 * destination. The caller places the cursor at the bound rectangle's origin,
 * orders all output to that surface, and owns delay/backpressure scheduling.
 *
 * Check status AND outcome: SIXEL_INTERRUPTED is not failure-class status.
 * State fields require state_snapshot_valid; complete-domain residual totals
 * additionally require audit_complete. A yield never implies convergence.
 * Cumulative counters are per binding and cannot wrap. Ordinary encoding
 * invalidates the source binding; bind a newer complete source before repair.
 *
 * Individual calls are serialized by the encoder in thread-enabled builds.
 * Keep every supplied object alive through active/waiting calls. Callbacks
 * must not reenter the same encoder/context. An accepted output callback must
 * consume/copy every byte; any nonnegative result, including zero, is success.
 * Output failure invalidates retained history. */
SIXELAPI SIXELSTATUS
sixel_progressive_step(sixel_progressive_t *context,
    sixel_progressive_budget_t const *budget, sixel_output_t *output,
    sixel_progressive_stats_t *stats);

/* Join active/waiting calls before releasing the context. Retained history
 * and ordinary delta configuration remain owned by the encoder. */
SIXELAPI void
sixel_progressive_unref(sixel_progressive_t *context);

/* encode specified pixel data to SIXEL format
 * output to encoder->outfd */
SIXELAPI SIXELSTATUS
sixel_encoder_encode_bytes(
    sixel_encoder_t     /* in */    *encoder,
    unsigned char       /* in */    *bytes,
    int                 /* in */    width,
    int                 /* in */    height,
    int                 /* in */    pixelformat,
    unsigned char       /* in */    *palette,
    int                 /* in */    ncolors);

#ifdef __cplusplus
}
#endif


/* easy encoder API */

/* handle type of dither context object */
struct sixel_decoder;
typedef struct sixel_decoder sixel_decoder_t;

#ifdef __cplusplus
extern "C" {
#endif

/* create decoder object */
SIXELAPI SIXELSTATUS
sixel_decoder_new(
    sixel_decoder_t    /* out */ **ppdecoder,  /* decoder object to be created */
    sixel_allocator_t  /* in */  *allocator);  /* allocator, null if you use
                                                  default allocator */

/* deprecated version of sixel_decoder_new() */
SIXELAPI @attr_func_deprecated@ sixel_decoder_t *
sixel_decoder_create(void);

/* increase reference count of decoder object (thread-unsafe) */
SIXELAPI void
sixel_decoder_ref(sixel_decoder_t *decoder);

/* decrease reference count of decoder object (thread-unsafe) */
SIXELAPI void
sixel_decoder_unref(sixel_decoder_t *decoder);

/* set an option flag to decoder object */
SIXELAPI SIXELSTATUS
sixel_decoder_setopt(
    sixel_decoder_t /* in */ *decoder,  /* decoder object */
    int             /* in */ arg,       /* one of SIXEL_OPTFLAG_*** */
    char const      /* in */ *optarg);  /* null or an argument of optflag */

/* load source data from stdin or the file specified with
   SIXEL_OPTFLAG_INPUT flag, and decode it */
SIXELAPI SIXELSTATUS
sixel_decoder_decode(
    sixel_decoder_t /* in */ *decoder);

/*
 * Decode in-memory SIXEL bytes with sixel_decoder_setopt() state and return
 * packed pixels.  The returned pixel buffer is allocated by the decoder's
 * allocator.
 */
#define SIXEL_HAVE_DECODER_DECODE_PIXELS 1

/* Stateful decoding accepts explicit multi-pass still-image captures. */
#define SIXEL_HAVE_DECODER_6DELTA_PROGRESSIVE 1

/* Object reconstruction in the output RGB basis selected by transform. */
SIXELAPI SIXELSTATUS
sixel_decoder_decode_mapped(sixel_decoder_t *decoder,
                            unsigned char const *data,
                            size_t size,
                            sixel_decode_options_t const *options,
                            sixel_palette_transform_t const *transform,
                            sixel_decode_result_t *result);

SIXELAPI SIXELSTATUS
sixel_decoder_decode_pixels(
    sixel_decoder_t /* in */ *decoder,
    unsigned char const /* in */ *data,
    size_t              /* in */ size,
    sixel_decode_options_t const
                        /* in */ *options,
    sixel_decode_result_t
                        /* out */ *result);

#ifdef __cplusplus
}
#endif

#endif  /* LIBSIXEL_SIXEL_H */

