# Encode Metal source as C string-array elements, without changing its bytes.
# Keep both physical source lines and concatenated literals portable. C99
# guarantees 4095 characters per literal; use 1024-byte chunks for headroom.
function emit(c,    encoded) {
    encoded = c
    if (c == "\\") encoded = "\\\\"
    else if (c == "\"") encoded = "\\\""
    else if (c == "\t") encoded = "\\t"
    else if (c == "\r") encoded = "\\r"
    else if (c == "\n") encoded = "\\n"
    else if (c == "?") encoded = "\\?"
    if (length(line) + length(encoded) > 72) {
        print "\"" line "\""
        line = ""
    }
    line = line encoded
    bytes++
    if (bytes == 1024) {
        print "\"" line "\","
        line = ""
        bytes = 0
    }
}
BEGIN {
    print "/* SPDX-License-Identifier: MIT */"
    print "/* Generated by tools/embed-metal.awk. Edit the .metal source. */"
}
{
    for (i = 1; i <= length($0); i++) emit(substr($0, i, 1))
    emit("\n")
}
END {
    if (bytes) print "\"" line "\","
}
