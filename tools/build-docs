#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Build the optional libsixel HTML documentation in an isolated venv."""

from __future__ import annotations

import argparse
import hashlib
from html.parser import HTMLParser
import os
from pathlib import Path
import platform
import shlex
import shutil
import subprocess
import sys
from urllib.parse import unquote, urlsplit


OUTPUT_MARKER = ".libsixel-docs-output"


class MediaReferenceParser(HTMLParser):
    """Collect media URLs that MkDocs itself does not validate in raw HTML."""

    def __init__(self) -> None:
        super().__init__()
        self.references: list[str] = []

    def handle_starttag(self, tag, attributes) -> None:
        values = dict(attributes)
        if tag == "img" and values.get("src"):
            self.references.append(values["src"])
        if tag != "source" or not values.get("srcset"):
            return
        for candidate in values["srcset"].split(","):
            fields = candidate.strip().split(None, 1)
            if fields:
                self.references.append(fields[0])


def parse_arguments(repo_root: Path) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Build docs/ as a static MkDocs Material site. Optional Python "
            "dependencies are cached in a private virtual environment."
        )
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=repo_root / "site",
        help="generated site directory (default: %(default)s)",
    )
    parser.add_argument(
        "--work-dir",
        type=Path,
        default=repo_root / ".docs-build",
        help="virtual-environment cache directory (default: %(default)s)",
    )
    parser.add_argument(
        "--no-bootstrap",
        action="store_true",
        help="use MkDocs from the current Python environment",
    )
    return parser.parse_args()


def run(command: list[str], env: dict[str, str] | None = None) -> None:
    print("+ " + shlex.join(command), flush=True)
    subprocess.run(command, check=True, env=env)


def dependency_fingerprint(requirements: Path) -> str:
    digest = hashlib.sha256()
    digest.update(requirements.read_bytes())
    digest.update(sys.implementation.name.encode())
    digest.update(str(sys.version_info[:2]).encode())
    digest.update(platform.system().encode())
    digest.update(platform.machine().encode())
    return digest.hexdigest()


def venv_python(venv_dir: Path) -> Path:
    if os.name == "nt":
        return venv_dir / "Scripts" / "python.exe"
    return venv_dir / "bin" / "python"


def prepare_python(work_dir: Path, requirements: Path) -> Path:
    venv_dir = work_dir / "venv"
    stamp = venv_dir / ".libsixel-docs-requirements"
    fingerprint = dependency_fingerprint(requirements)
    python = venv_python(venv_dir)

    if python.is_file() and stamp.is_file():
        if stamp.read_text(encoding="ascii").strip() == fingerprint:
            return python

    # Recreate only this tool-owned environment so removed dependencies cannot
    # survive a requirements update and influence later documentation builds.
    if venv_dir.exists():
        shutil.rmtree(venv_dir)
    work_dir.mkdir(parents=True, exist_ok=True)
    run([sys.executable, "-m", "venv", str(venv_dir)])
    run(
        [
            str(python),
            "-m",
            "pip",
            "install",
            "--disable-pip-version-check",
            "--no-input",
            "--requirement",
            str(requirements),
        ]
    )
    stamp.write_text(fingerprint + "\n", encoding="ascii")
    return python


def validate_output_directory(output_dir: Path) -> None:
    if not output_dir.exists():
        return
    entries = list(output_dir.iterdir())
    if not entries or (output_dir / OUTPUT_MARKER).is_file():
        return
    raise RuntimeError(
        f"refusing to clean non-documentation directory: {output_dir}"
    )


def validate_media_references(output_dir: Path) -> None:
    failures = []
    for html_path in output_dir.rglob("*.html"):
        parser = MediaReferenceParser()
        parser.feed(html_path.read_text(encoding="utf-8"))
        for reference in parser.references:
            parsed = urlsplit(reference)
            if parsed.scheme or parsed.netloc or not parsed.path:
                continue
            if parsed.path.startswith("/"):
                target = output_dir / unquote(parsed.path.lstrip("/"))
            else:
                target = html_path.parent / unquote(parsed.path)
            target = target.resolve()
            if output_dir not in target.parents or not target.is_file():
                relative_html = html_path.relative_to(output_dir)
                failures.append(f"{relative_html}: {reference}")
    if failures:
        formatted = "\n".join("  " + failure for failure in failures)
        raise RuntimeError("broken local media references:\n" + formatted)


def main() -> int:
    repo_root = Path(__file__).resolve().parent.parent
    arguments = parse_arguments(repo_root)
    output_dir = arguments.output_dir.resolve()
    work_dir = arguments.work_dir.resolve()
    requirements = repo_root / "tools" / "docs" / "requirements.txt"
    config = repo_root / "mkdocs.yml"

    validate_output_directory(output_dir)
    if arguments.no_bootstrap:
        python = Path(sys.executable)
    else:
        python = prepare_python(work_dir, requirements)

    environment = os.environ.copy()
    environment.setdefault("PYTHONDONTWRITEBYTECODE", "1")
    try:
        run(
            [
                str(python),
                "-m",
                "mkdocs",
                "build",
                "--strict",
                "--clean",
                "--config-file",
                str(config),
                "--site-dir",
                str(output_dir),
            ],
            env=environment,
        )
    finally:
        # Keep failed partial output recognizable so the next retry can clean
        # it without weakening protection for unrelated non-empty directories.
        if output_dir.is_dir():
            (output_dir / OUTPUT_MARKER).write_text(
                "Generated by tools/build-docs.\n", encoding="ascii"
            )
    validate_media_references(output_dir)
    (output_dir / ".nojekyll").touch()
    print(f"Documentation site: {output_dir}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"build-docs: {error}", file=sys.stderr)
        raise SystemExit(1) from error
