@OPENVMS_GNV_FALSE@test_runner_LINK = $(LIBTOOL) $(AM_V_lt) --tag=CC $(AM_LIBTOOLFLAGS) \
@OPENVMS_GNV_FALSE@	$(LIBTOOLFLAGS) --mode=link $(CCLD) $(test_runner_CFLAGS) \
@OPENVMS_GNV_FALSE@	$(CFLAGS) $(test_runner_LDFLAGS) $(LDFLAGS) -o $@

# Automake emits the link rule unconditionally, so a _LINK defined only
# in one branch leaves the variable empty everywhere else and make then
# tries to run the first object file as a command.  Spell out the
# default for the other branch.
@OPENVMS_GNV_TRUE@test_runner_LINK = $(SHELL) $(top_srcdir)/openvms/gnv-link-program.sh -o $@
LOG_DRIVER = $(T_LOG_DRIVER)
LOG_DRIVER_FLAGS = $(AM_TEST_LOG_DRIVER_FLAGS)
T_LOG_DRIVER = env AM_TAP_AWK='$(AWK)' $(SHELL) $(top_builddir)/build-aux/lso-tap-driver.sh
AM_TEST_LOG_DRIVER_FLAGS = --comments

# Default to soft errors so the harness continues after individual failures.
DISABLE_HARD_ERRORS = yes
AM_TEST_TIMEOUT = 90
AM_LOG_DRIVER_FLAGS = --timeout=$(AM_TEST_TIMEOUT)
# Leave AM_LOG_FLAGS empty so Automake does not append timeout parameters to
# LOG_COMPILE; the drivers consume timeout hints themselves.
AM_LOG_FLAGS = 
@OPENVMS_GNV_FALSE@sixel_clean_batch_size = $(if $(filter darwin% linux% freebsd% netbsd% openbsd% dragonfly% solaris% illumos% haiku% aix%,$(host_os)),128,16)

# Automake otherwise emits one rm recipe per dependency file.  Expand its
# exact inventory into small commands, preserving shared-directory files
# owned by other programs and avoiding shell argument limits.  Keep this
# compatible with GNU make 3.81.
# Common POSIX hosts accept larger batches.  Retain the conservative limit
# for Windows, OpenVMS, and other hosts with smaller command-line budgets.
@OPENVMS_GNV_TRUE@sixel_clean_batch_size = 16
# Appending each copied path rebuilds the shell's positional arguments.
# Use smaller copy batches so that cost does not outweigh saved rm launches.
sixel_clean_copy_batch_size = $(if $(filter 128,$(sixel_clean_batch_size)),32,16)

# Distribute fixture trees as directories so DISTFILES remains short and
# distdir does not hit shell ARG_MAX limits on some platforms.
