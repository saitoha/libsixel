# Source-only checks still read configured public headers. Refresh them via
# their owning Makefile before any checker can compare generated bindings.
.PHONY: prepare-staticcheck-headers
prepare-staticcheck-headers:
	+@$(MAKE) -C "$(top_builddir)/include" sixel.h 6cells.h

staticcheck: staticcheck-clean prepare-staticcheck-headers
	+@$(SHELL) "$(top_srcdir)/tests/_static/sh/run-check-batches.sh" \
	--make-command '$(MAKE)' env TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	SIXEL_STATICCHECK_IMAGE_AUDITS='$(ENABLE_STATICCHECK_IMAGE_AUDITS)' \
	"$(SHELL)" "$(top_srcdir)/tests/_static/sh/staticcheck-suite.sh" \
		"$(abs_top_srcdir)" \
		"$(abs_top_builddir)" \
		"$(ACTIONLINT)" \
		"$(top_srcdir)/tests/_static/sh/shellcheck.sh" \
		"$(SHELLCHECK)" \
		"$(CODESPELL)" \
		"$(PYTHON_STATICCHECK)" \
		"$(HAVE_TREE_SITTER_C)"

.PHONY: staticcheck-clean staticcheck-cache-clean

staticcheck-clean:
	@$(am__rm_f) staticcheck-*.log staticcheck-*.trs

# Successful per-file lint results survive ordinary report cleanup.
staticcheck-cache-clean:
	@rm -rf "$(top_builddir)/.staticcheck-cache"

staticcheck-staticcheck-suite-sync:
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	$(T_LOG_DRIVER) --test-name "staticcheck-staticcheck-suite-sync" \
		--log-file staticcheck-staticcheck-suite-sync.log \
		--trs-file staticcheck-staticcheck-suite-sync.trs \
		$(AM_T_LOG_DRIVER_FLAGS) $(T_LOG_DRIVER_FLAGS) -- \
		"$(top_srcdir)/tests/_static/sh/staticcheck-staticcheck-suite-sync.sh" \
		"$(abs_top_srcdir)"

