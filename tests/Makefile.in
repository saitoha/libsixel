staticcheck: staticcheck-clean
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	"$(SHELL)" "$(top_srcdir)/tests/_static/sh/staticcheck-suite.sh" \
		"$(abs_top_srcdir)" \
		"$(abs_top_builddir)" \
		"$(ACTIONLINT)" \
		"$(top_srcdir)/tests/_static/sh/shellcheck.sh" \
		"$(SHELLCHECK)" \
		"$(CODESPELL)" \
		"$(PYTHON_STATICCHECK)" \
		"$(HAVE_TREE_SITTER_C)"

.PHONY: staticcheck-clean

staticcheck-clean:
	@$(am__rm_f) staticcheck-*.log staticcheck-*.trs

staticcheck-staticcheck-suite-sync:
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	$(T_LOG_DRIVER) --test-name "staticcheck-staticcheck-suite-sync" \
		--log-file staticcheck-staticcheck-suite-sync.log \
		--trs-file staticcheck-staticcheck-suite-sync.trs \
		$(AM_T_LOG_DRIVER_FLAGS) $(T_LOG_DRIVER_FLAGS) -- \
		"$(top_srcdir)/tests/_static/sh/staticcheck-staticcheck-suite-sync.sh" \
		"$(abs_top_srcdir)"

staticcheck-tap-dispatch:
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	$(T_LOG_DRIVER) --test-name "staticcheck-tap-dispatch" \
		--log-file staticcheck-tap-dispatch.log \
		--trs-file staticcheck-tap-dispatch.trs \
		$(AM_T_LOG_DRIVER_FLAGS) $(T_LOG_DRIVER_FLAGS) -- \
		"$(top_srcdir)/tests/_static/sh/staticcheck-tap-dispatch.sh" \
		"$(abs_top_srcdir)"

staticcheck-suboption-image-coverage:
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	$(T_LOG_DRIVER) --test-name "staticcheck-suboption-image-coverage" \
		--log-file staticcheck-suboption-image-coverage.log \
		--trs-file staticcheck-suboption-image-coverage.trs \
		$(AM_T_LOG_DRIVER_FLAGS) $(T_LOG_DRIVER_FLAGS) -- \
		"$(top_srcdir)/tests/_static/sh/staticcheck-suboption-image-coverage.sh" \
		"$(abs_top_srcdir)"

staticcheck-actionlint:
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	$(T_LOG_DRIVER) --test-name "staticcheck-actionlint" \
		--log-file staticcheck-actionlint.log \
		--trs-file staticcheck-actionlint.trs \
		$(AM_T_LOG_DRIVER_FLAGS) $(T_LOG_DRIVER_FLAGS) -- \
		"$(top_srcdir)/tests/_static/sh/staticcheck-actionlint.sh" \
		"$(abs_top_srcdir)" "$(ACTIONLINT)"

staticcheck-shellcheck:
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	$(T_LOG_DRIVER) --test-name "staticcheck-shellcheck" \
		--log-file staticcheck-shellcheck.log \
		--trs-file staticcheck-shellcheck.trs \
		$(AM_T_LOG_DRIVER_FLAGS) $(T_LOG_DRIVER_FLAGS) -- \
		"$(top_srcdir)/tests/_static/sh/staticcheck-shellcheck.sh" \
		"$(top_srcdir)/tests/_static/sh/shellcheck.sh" \
		"$(abs_top_srcdir)" "$(SHELLCHECK)"

staticcheck-codespell:
	@TOP_SRCDIR='$(abs_top_srcdir)' TOP_BUILDDIR='$(abs_top_builddir)' \
	ARTIFACT_ROOT='$(ARTIFACT_ROOT)' \
	$(T_LOG_DRIVER) --test-name "staticcheck-codespell" \
		--log-file staticcheck-codespell.log \
		--trs-file staticcheck-codespell.trs \
