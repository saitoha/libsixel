# OpenVMS record-oriented files can reject the full test list when
# config.status writes it as one substituted line.  Avoid feeding the large
# list to Automake variables on that platform; check-TESTS reads this file.
@OPENVMS_GNV_TRUE@OPENVMS_CHECK_TESTS_LIST = $(builddir)/check-tests.list
@OPENVMS_GNV_TRUE@OPENVMS_TEST_SHARD_DIR = $(builddir)/check-tests-shards
@OPENVMS_GNV_TRUE@OPENVMS_TEST_WORKER_LIST = $(OPENVMS_CHECK_TESTS_LIST)
XFAIL_TESTS = \
    loader/builtin/1287_loader_builtin_psd_psdtools_advanced_blending_hardcase_lsqa.t \
    loader/builtin/1317_loader_builtin_psd_psdtools_effects_shape_fx2_hardcase_lsqa.t \
    loader/builtin/1318_loader_builtin_psd_psdtools_effects_stroke_composite_hardcase_lsqa.t

SERIAL_TESTS = \
    cli/aborttrace/0001_img2sixel_aborttrace.t \
    cli/aborttrace/0002_aborttrace_zero_disables.t \
    cli/aborttrace/0003_aborttrace_empty_enables.t \
    cli/aborttrace/0004_aborttrace_invalid_enables.t

COPY_TESTS = $(TESTS)
TEST_EXTENSIONS = .t .py .rb .pl .php
