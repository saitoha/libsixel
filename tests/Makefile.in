.PRECIOUS: Makefile

# Keep the default serialized on OpenVMS.  N=2 sharding is still available for
# experiments, but the extra GNV process and file I/O overhead is slower on the
# current runner.
@OPENVMS_GNV_TRUE@OPENVMS_TEST_JOBS ?= 1
# Discover once per make invocation, from the source tree even in VPATH
# builds.  Preserve command-line TESTS selections, including an empty list.
# The raw override is emitted after srcdir and before the custom log target;
# no inventory passes through configure or recursive make arguments.
@OPENVMS_GNV_FALSE@override TESTS := $(if $(filter file,$(origin TESTS)),$(shell $(SHELL) "$(top_srcdir)/build-aux/read-check-test-list.sh" tests "$(srcdir)" include newline || echo __SIXEL_TEST_DISCOVERY_FAILED__),$(TESTS))
# Keep the installed-command selection inside make, including caller-supplied
# TESTS. Passing the filtered inventory to recursive make exceeds argv limits.
# GNU make 3.81 has no .SHELLSTATUS; an explicit marker propagates scan
# failures instead of silently accepting an empty or partial test suite.
override TESTS := $(if $(filter __SIXEL_TEST_DISCOVERY_FAILED__,$(TESTS)),$(error could not discover tests in $(srcdir)),$(if $(filter 1,$(SIXEL_INSTALLCHECK_GENERIC)),$(filter-out extension/quicklook-installed/%,$(TESTS)),$(TESTS)))
SIXEL_INSTALLCHECK ?= 0
# The static suite and nested helpers need the same configured utility.
export CKSUM

# Keep object names out of the shell's -c argument. Even relative paths can
# exceed Linux's per-string limit long before the total argv limit is reached.
# Separate recipe lines bound each shell invocation while retaining GNU make
# 3.81 support; its implementation has no $(file ...) function.
define sixel_write_test_runner_objects
$(if $(strip $(1)),@printf '%s\n' $(wordlist 1,128,$(1)) >>$@.tmp
$(call sixel_write_test_runner_objects,$(wordlist 129,$(words $(1)),$(1))))
endef

# The configured Makefile owns the object inventory. Reuse the list across
# object rebuilds and publish it only after every batch was written.
test_runner.objects: Makefile
	@: >$@.tmp
	$(call sixel_write_test_runner_objects,$(test_runner_OBJECTS))
	@mv -f $@.tmp $@

# A successful configure link probe permits passing the object inventory
# straight to the compiler. Libtool forwards @file unchanged, avoiding its
# repeated argument/string processing for thousands of ordinary objects.
# Libraries remain visible to Libtool, preserving wrapper and runtime paths.
# Compilers without this grammar retain the shell-expanded argv fallback;
# -objectlist cannot replace it because that Libtool option requires .lo.
SIXEL_TEST_RUNNER_OBJECT_LIST ?= test_runner.objects
SIXEL_TEST_RUNNER_LINK_COMMAND ?= $(if \
    $(filter yes,$(SIXEL_TEST_RUNNER_USE_RESPONSE_FILE)),\
    $(test_runner_LINK) @test_runner.objects $(test_runner_LDADD) $(LIBS),\
    set -f; objects=$$(cat test_runner.objects) && \
    $(test_runner_LINK) $$objects $(test_runner_LDADD) $(LIBS))

# OpenVMS supplies its native command and an empty list prerequisite. Keep
# one unconditional target so Automake does not emit a second link recipe.
test_runner$(EXEEXT): $(test_runner_OBJECTS) $(test_runner_DEPENDENCIES) \
        $(EXTRA_test_runner_DEPENDENCIES) $(SIXEL_TEST_RUNNER_OBJECT_LIST)
	@rm -f $@
	$(AM_V_GEN)$(SIXEL_TEST_RUNNER_LINK_COMMAND)

