# The allocator-instrumented stb copy requires its own translation unit.
dist_test_runner_SOURCES = writer/png/0065_direct_png_allocation_failure.c
TEST_EXTENSIONS = .t .py .rb .pl .php
HELPER_FILES = \
    _support/docs/consistency/list_envvars.sh \
    bindings/python/_taptest.py \
    _support/bindings/check-loader-setopt-sync.sh \
    _support/bindings/perl-attach-gnu.h \
    _support/bindings/perl-attach-declspec.h \
    bindings/ruby/_coverage_runner.rb \
    bindings/ruby/_coverage_to_lcov.rb \
    bindings/perl/_coverage_to_lcov.pl \
    bindings/php/_coverage_runner.php \
    bindings/php/_coverage_to_lcov.php

ARTIFACT_ROOT = $(abs_builddir)/_artifacts
SIXEL_TEST_MACOS_PRODUCT_VERSION := $(shell sw_vers -productVersion 2>/dev/null || printf "")

# Keep executable suffix in sync with the configured target so TAP
# wrappers can resolve cross-built Windows binaries under Wine.
AM_TESTS_ENVIRONMENT = ARTIFACT_ROOT='$(ARTIFACT_ROOT)'; export \
	ARTIFACT_ROOT; CKSUM='$(CKSUM)'; export CKSUM; AWK='$(AWK)'; \
	export AWK; SED='$(SED)'; export SED; \
	SIXEL_TEST_PKG_CONFIG='$(PKG_CONFIG)'; export \
	SIXEL_TEST_PKG_CONFIG; \
	SIXEL_TEST_CONFIG_SHELL='$(SIXEL_TEST_SHELL)'; export \
	SIXEL_TEST_CONFIG_SHELL; \
	TOP_SRCDIR='$(SIXEL_TEST_TOP_SRCDIR)'; export TOP_SRCDIR; \
	TOP_BUILDDIR='$(abs_top_builddir)'; export TOP_BUILDDIR; \
	$(am__append_1) $(am__append_2) \
	QUICKLOOK_HOST_SYSTEM='@host_os@'; export \
	QUICKLOOK_HOST_SYSTEM; \
	QUICKLOOK_PLIST_DIR='$(abs_top_builddir)/quicklook-extension/generated-resources'; \
	export QUICKLOOK_PLIST_DIR; \
	QUICKLOOK_PACKAGE_VERSION='@QUICKLOOK_PACKAGE_VERSION@'; \
	export QUICKLOOK_PACKAGE_VERSION; SIXEL_BIN_EXT='@EXEEXT@'; \
	export SIXEL_BIN_EXT; SIXEL_TSAN_BUILD='@SIXEL_TSAN_BUILD@'; \
	export SIXEL_TSAN_BUILD; \
	SIXEL_MSAN_BUILD='@SIXEL_MSAN_BUILD@'; export \
	SIXEL_MSAN_BUILD; CROSS_COMPILING='@cross_compiling@'; export \
	CROSS_COMPILING; \
	SIXEL_TEST_NATIVE_PYTHON='$(PYTHON_STATICCHECK)'; export \
	SIXEL_TEST_NATIVE_PYTHON; SIXEL_TEST_CC='$(CC)'; export \
	SIXEL_TEST_CC; SIXEL_TEST_MAKE='$(MAKE)'; export \
	SIXEL_TEST_MAKE; $(am__append_3) \
	SIXEL_INSTALLCHECK='$(SIXEL_INSTALLCHECK)'; export \
	SIXEL_INSTALLCHECK; ENABLE_PYTHON='@ENABLE_PYTHON@'; export \
	ENABLE_PYTHON; ENABLE_RUBY='@ENABLE_RUBY@'; export \
	ENABLE_RUBY; ENABLE_PERL='@ENABLE_PERL@'; export ENABLE_PERL; \
	ENABLE_PHP='@ENABLE_PHP@'; export ENABLE_PHP; \
	SIXEL_CONFIGURED_RUBY='@RUBY@'; export SIXEL_CONFIGURED_RUBY; \
	SIXEL_CONFIGURED_PHP='@PHP@'; export SIXEL_CONFIGURED_PHP; \
	RUNTIME_SHLIBPATH_VAR='@SIXEL_LIBTOOL_SHLIBPATH_VAR@'; export \
	RUNTIME_SHLIBPATH_VAR; \
	RUNTIME_SHLIBPATH_SEP='@SIXEL_LIBTOOL_PATH_SEPARATOR@'; export \
	RUNTIME_SHLIBPATH_SEP; \
	SIXEL_SHLIBPATH_OVERRIDES_RUNPATH='@SIXEL_SHLIBPATH_OVERRIDES_RUNPATH@'; \
	export SIXEL_SHLIBPATH_OVERRIDES_RUNPATH; \
	SIXEL_TEST_ADDITIOANL_PATH='@SIXEL_TEST_ADDITIOANL_PATH@'; \
	export SIXEL_TEST_ADDITIOANL_PATH; \
	SIXEL_TEST_GZIP='@SIXEL_TEST_GZIP@'; export SIXEL_TEST_GZIP; \
	SIXEL_TEST_MACOS_PRODUCT_VERSION='$(SIXEL_TEST_MACOS_PRODUCT_VERSION)'; \
	export SIXEL_TEST_MACOS_PRODUCT_VERSION; \
	SIXEL_TEST_HOST_ARCH='@host_cpu@'; export \
	SIXEL_TEST_HOST_ARCH; \
	RUNTIME_ENV_IS_OPENVMS='@RUNTIME_ENV_IS_OPENVMS@'; export \
	RUNTIME_ENV_IS_OPENVMS;
# Native Windows programs need drive paths inside compound icc:... options.
# MSYS/Cygwin targets instead consume POSIX colon-separated XDG/PATH lists;
# a drive prefix would become a separate entry. Select by target, not shell.
# Braced make expansion keeps shell case-pattern ')' outside its delimiter.
SIXEL_TEST_TOP_SRCDIR := ${shell cd '$(abs_top_srcdir)' && case '@host_os@' in mingw*|windows*|msvc*) pwd -W 2>/dev/null || pwd ;; *) pwd ;; esac}
TESTS_COMMON_CPPFLAGS_VAL = $(AM_CPPFLAGS) \
       -I$(top_builddir) -I$(top_builddir)/include \
       -I$(top_srcdir)/include -I$(top_srcdir)/src \
       -I$(top_srcdir)

# Thread ABI flags apply to support objects as well as included library code.
@WANT_AMALGAMATED_TOOLS_FALSE@TESTS_COMMON_CFLAGS_VAL = $(AM_CFLAGS) \
@WANT_AMALGAMATED_TOOLS_FALSE@	@THREAD_CFLAGS@ \
@WANT_AMALGAMATED_TOOLS_FALSE@	$(MAYBE_COVERAGE) \
@WANT_AMALGAMATED_TOOLS_FALSE@	@SIXEL_TEST_DEPRECATED_CFLAGS@ \
@WANT_AMALGAMATED_TOOLS_FALSE@	@SIXEL_TEST_PRINTF_CFLAGS@ \
@WANT_AMALGAMATED_TOOLS_FALSE@	$(am__empty)
@WANT_AMALGAMATED_TOOLS_TRUE@TESTS_COMMON_CFLAGS_VAL = $(AM_CFLAGS) \
@WANT_AMALGAMATED_TOOLS_TRUE@	$(LIBCURL_CFLAGS) \
