# Keep distdir recipe lines below per-argument shell limits by copying
# discovered test scripts in dist-hook instead of expanding $(TESTS) in
# EXTRA_DIST.
dist-hook:
	@set -eu; \
	$(SHELL) "$(top_srcdir)/build-aux/read-check-test-list.sh" \
	    tests "$(srcdir)" include | tr ' ' '\n' | \
	while IFS= read -r test_path; do \
	    test -n "$$test_path" || continue; \
	    dst="$(distdir)/$$test_path"; \
	    $(MKDIR_P) "`dirname "$$dst"`"; \
	    cp -p "$(srcdir)/$$test_path" "$$dst"; \
	done

# Avoid deleting the in-tree timeout wrapper when building in the source
# directory. The wrapper is regenerated for out-of-tree builds, so remove it
# only in that case to prevent accidental loss from "make clean".
CLEANFILES = check-tests.list
DISTCLEANFILES = check-tests.mk

# Avoid deleting in-tree test scripts when "make clean" is invoked.
# Only remove copied test files in an out-of-tree build so that the
# distributed sources remain intact for developers and package builds.
# Skip absent copies and remove existing ones in bounded batches; discovery
# lists every test even when no tests have been built or run.

# Keep this recipe tab-indented; GNU make requires tabs for commands.
clean-local:
	@if test "$(abs_builddir)" != "$(abs_srcdir)"; then \
	rm -f $(LOG_COMPILER) $(HELPER_FILES); \
	$(SHELL) "$(top_srcdir)/build-aux/read-check-test-list.sh" \
	    tests "$(abs_srcdir)" include newline | { \
	    set --; \
	    while IFS= read -r test_path; do \
	        test -n "$$test_path" || continue; \
	        test -e "$$test_path" || test -L "$$test_path" || continue; \
	        set -- "$$@" "./$$test_path"; \
	        if test "$$#" -eq "$(sixel_clean_copy_batch_size)"; then \
	            rm -f "$$@" || exit $$?; \
	            set --; \
	        fi; \
	    done; \
	    test "$$#" -eq 0 || rm -f "$$@"; \
	}; \
	fi
	rm -rf $(ARTIFACT_ROOT)
	rm -rf $(OPENVMS_TEST_SHARD_DIR)
	rm -rf $(abs_top_builddir)/tests/.lso-test-bin
	rm -rf $(abs_top_builddir)/tests/.python-test-venv
	rm -rf $(abs_top_builddir)/tests/.ruby-test-venv
	rm -rf $(abs_top_builddir)/tests/.perl-test-venv
	rm -rf $(abs_top_builddir)/tests/.php-test-venv
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/webp-static-icc-overlimit-padded.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/webp-static-icc-limit-padded.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/snake_64_embedded_a98_icc_xmp_iccprofile_iccp_overlimit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/animated-lossy-8x8-2frame-min-embedded-srgb-icc-overlimit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/animated-lossy-8x8-2frame-min-embedded-srgb-icc-xmp-icc-displayp3-overlimit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/orientation_exif_o6_vp8_static_12x8_exif_limit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/orientation_exif_o6_vp8_static_12x8_exif_overlimit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/orientation_exif_o6_vp8_static_12x8_xmp_o3_exif_overlimit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/animated-lossy-8x8-2frame-min-exif-o6-limit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/animated-lossy-8x8-2frame-min-exif-o6-overlimit.webp
	rm -f $(abs_top_builddir)/tests/data/inputs/formats/snake16_psb_*_high_offset_xxlarge*.psd

# Keep this recipe tab-indented; GNU make requires tabs for commands.
$(COPY_TESTS) $(HELPER_FILES):
	$(MKDIR_P) $(builddir)/$(dir $@)
	$(AM_V_GEN){ if test -f $(srcdir)/$@; then \
	    cp $(srcdir)/$@ $(builddir)/$@; \
	fi; }


