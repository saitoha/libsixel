    $(top_srcdir)/gdk-pixbuf-loader/sixel-pixbuf-loader.c \
    $(TEST_RUNNER_LOOKUP_POLICY_SOURCE) \
    $(top_srcdir)/converters/aborttrace.c \
    $(top_srcdir)/converters/cli.c \
    $(top_srcdir)/converters/terminal-color.c \
    $(top_srcdir)/converters/path.c
# Numeric and fault-injection helpers include CMS, PNG and TIFF directly;
# their optional headers are also required in the normal runner build.
test_runner_CPPFLAGS = $(TESTS_COMMON_CPPFLAGS_VAL) \
    $(LIBPNG_CFLAGS) \
    $(LCMS2_CFLAGS) \
    $(LIBTIFF_CFLAGS) \
    $(LIBWEBP_CFLAGS) \
    $(GDK_PIXBUF_CFLAGS) \
    -DGDK_PIXBUF_ENABLE_BACKEND \
    -DSIXEL_PIXBUF_LOADER_TESTING \
    -DSIXEL_ENABLE_GDK_PIXBUF_LOADER_TESTS
test_runner_CFLAGS = $(TESTS_COMMON_CFLAGS_VAL)
test_runner_LDFLAGS = $(TESTS_COMMON_LDFLAGS_VAL)
test_runner_LDADD = $(TESTS_COMMON_LDADD_VAL) \
        $(LIBS) \
        $(LIBCURL_LIBS) \
        $(LIBFETCH_LIBS) \
        $(WINHTTP_LIBS) \
        $(LIBPNG_LIBS) \
        $(LIBTIFF_LIBS) \
        $(LIBJPEG_LIBS) \
        $(LIBWEBP_LIBS) \
        $(GDK_PIXBUF_LIBS) \
        $(GD_LIBS) \
        $(WIC_LIBS) \
        $(COREGRAPHICS_LIBS) \
        $(QUICKLOOK_LIBS) \
        $(METAL_LIBS) \
        $(CLIPBOARD_LIBS) \
        $(ABORTTRACE_LIBS) \
        @THREAD_LIBS@
endif
# Automake emits the link rule unconditionally, so a _LINK defined only
# in one branch leaves the variable empty everywhere else and make then
# tries to run the first object file as a command.  Spell out the
# default for the other branch.
if OPENVMS_GNV
test_runner_LINK = $(SHELL) $(top_srcdir)/openvms/gnv-link-program.sh -o $@
else
test_runner_LINK = $(LIBTOOL) $(AM_V_lt) --tag=CC $(AM_LIBTOOLFLAGS) \
	$(LIBTOOLFLAGS) --mode=link $(CCLD) $(test_runner_CFLAGS) \
	$(CFLAGS) $(test_runner_LDFLAGS) $(LDFLAGS) -o $@
endif

