#!/bin/sh
# Verify horizontal fs gpu dispatch.
# Policy: docs/encoder/output/delta-encoding.md
set -eux
echo "1..1"
set -v
status=0
${SIXEL_RUNTIME-} "${TEST_RUNNER_PATH}" --require-gpu-palette \
    delta/refresh/0124_horizontal_fs_gpu_dispatch || status=$?
test "$status" -ne 77 || {
    echo "ok 1 # SKIP GPU palette backend unavailable"
    exit 0
}
test "$status" -eq 0 || {
    echo "not ok 1 - horizontal fs gpu dispatch"
    exit 0
}
echo "ok 1 - horizontal fs gpu dispatch"
exit 0
