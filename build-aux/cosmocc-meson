#!/bin/sh -e

output=
prev=
for arg do
    if test "$prev" = -o; then
        output=$arg
    fi
    prev=$arg
done

# Meson launches linked probes directly with subprocess, without a shell to
# interpret an APE executable. Keep the compiler output and give each
# temporary probe a shell launcher. Installed and test binaries stay APE.
case "$output" in
    /*) ;;
    *) output=$PWD/$output ;;
esac
case "$output" in
    */meson-private/*.exe) ;;
    *) exec cosmocc "$@" ;;
esac

cosmocc "$@"
test "$(head -n 1 "$output")" = "MZqFpD='" || exit 0
mv "$output" "$output.ape"
cat >"$output" <<'LAUNCHER'
#!/bin/sh
exec sh "$0.ape" "$@"
LAUNCHER
chmod +x "$output"
