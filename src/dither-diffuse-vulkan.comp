#version 450
/* SPDX-License-Identifier: MIT */
/*
 * Vulkan port of the four-phase GPU error diffusion in
 * dither-policy-{fs,atkinson,jajuni,stucki,burkes,sierra*}-gpu.metal and
 * dither-policy-lso2-gpu.metal. Two cycles of four spatial phases; k is a
 * subpass, never video time. Each tap names the sender of an error
 * contribution: dy rows above, and dx columns behind it along the sender
 * row's scan direction.
 *
 * KERNEL selects initialize, iterate, finish, solve_tail or resolve.
 * METHOD 0 is the fixed-tap family with the CPU carry limiter; METHOD 1 is
 * LSO2 with per-magnitude weights. Lookup is either the exact nearest
 * palette scan of lookup-policy-none-fractional-gpu.metal (squared
 * differences, lowest index on ties) or the fractional FHEDT query of
 * lookup-policy-fhedt-fractional-gpu.metal over the table that
 * lookup-policy-fhedt-vulkan.comp builds (bindings 14 and 15 view it as
 * bytes without refinement or as label | boundary << 8 | zero << 9 words).
 * Lookup 2 is the fractional 5bit/6bit query of
 * lookup-policy-bitlut-fractional-gpu.metal over the cell-center table of
 * lookup-policy-bitlut-vulkan.comp, read through binding 14.
 */
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const int KERNEL = 0;
layout(constant_id = 1) const int METHOD = 0;

const int KERNEL_INITIALIZE = 0;
const int KERNEL_ITERATE = 1;
const int KERNEL_FINISH = 2;
const int KERNEL_SOLVE_TAIL = 3;
const int KERNEL_RESOLVE = 4;
const int METHOD_LSO2 = 1;

layout(std430, set = 0, binding = 0) readonly buffer Source {
    uint8_t source[];
};
layout(std430, set = 0, binding = 1) readonly buffer Palette {
    uint8_t palette[];
};
layout(std430, set = 0, binding = 2) buffer StateA {
    vec4 a[];
};
layout(std430, set = 0, binding = 3) buffer StateB {
    vec4 b[];
};
/* Field order and sizes match sixel_vk_diffuse_params_t. */
layout(std430, set = 0, binding = 4) readonly buffer Params {
    uint width, height, ncolors, tiles_x;
    uint keycolor, delta, threshold, metric;
    uint columns, rows, tiled, selected_threshold;
    uint serpentine, clamp_hard, tap_count, weight_base;
    float deadzone, clamp_lower, clamp_upper, reserved;
    int dx[12];
    int dy[12];
    float tap_weights[12];
    uint selection[128];
    uint lookup, fhedt_resolution, fhedt_shift, fhedt_refine;
    uint fhedt_dist2, bitlut_bits, unused1, unused2;
} p;
layout(std430, set = 0, binding = 5) readonly buffer Phase {
    uint8_t phase[];
};
layout(std430, set = 0, binding = 6) readonly buffer Positions {
    uint positions[];
};
layout(std430, set = 0, binding = 7) readonly buffer Weights {
    float weights[];
};
layout(std430, set = 0, binding = 8) readonly buffer Transparent {
    uint8_t transparent[];
};
layout(std430, set = 0, binding = 9) readonly buffer Retained {
    uint8_t retained[];
};
layout(std430, set = 0, binding = 10) readonly buffer Valid {
    uint8_t valid[];
};
layout(std430, set = 0, binding = 11) writeonly buffer Result {
    uint8_t result[];
};
layout(std430, set = 0, binding = 12) buffer Invalid {
    uint invalid[];
};
layout(std430, set = 0, binding = 13) writeonly buffer Skip {
    uint8_t skip[];
};
layout(std430, set = 0, binding = 14) readonly buffer FhedtTable8 {
    uint8_t fhedt_table8[];
};
layout(std430, set = 0, binding = 15) readonly buffer FhedtTable32 {
    uint fhedt_table32[];
};

/* step: subpass for iterate; count: invocations that do work; pitch:
 * invocations per dispatch row. */
layout(push_constant) uniform Push {
    uint step;
    uint pitch;
    uint count;
} pc;

vec3 diffuse_color(uint index)
{
    return vec3(float(palette[3u * index]), float(palette[3u * index + 1u]),
        float(palette[3u * index + 2u]));
}

vec3 diffuse_source(uint i)
{
    return vec3(float(source[3u * i]), float(source[3u * i + 1u]),
        float(source[3u * i + 2u]));
}

/* The query's FHEDT cell, then the corner refinement for a boundary cell.
 * A zero-cost grid point certifies only the query that is that seed
 * point. Corners compare the quantized palette coordinates in the
 * original traversal order. Queries are clamped to the byte range before
 * quantization; uint conversion of a negative float is undefined. */
uint diffuse_fhedt(vec3 query)
{
    uvec3 cell, corner;
    ivec3 color;
    vec3 gap;
    uint r, at, word, best, candidate, x, y, z;
    float distance, minimum;

    r = p.fhedt_resolution;
    cell = uvec3(clamp(query, 0.0, 255.0)) >> p.fhedt_shift;
    at = cell.x + cell.y * r + cell.z * r * r;
    if (p.fhedt_refine == 0u) {
        return uint(fhedt_table8[at]);
    }
    word = fhedt_table32[at];
    best = word & 255u;
    if ((word & 256u) == 0u || (p.fhedt_dist2 != 0u &&
            (word & 512u) != 0u &&
            all(equal(query, vec3(cell << p.fhedt_shift))))) {
        return best;
    }
    minimum = uintBitsToFloat(0x7f800000u);
    for (z = 0u; z < 2u; ++z) {
        for (y = 0u; y < 2u; ++y) {
            for (x = 0u; x < 2u; ++x) {
                corner = min(cell + uvec3(x, y, z), uvec3(r - 1u));
                at = corner.x + corner.y * r + corner.z * r * r;
                candidate = fhedt_table32[at] & 255u;
                color = ivec3(int(palette[3u * candidate]),
                    int(palette[3u * candidate + 1u]),
                    int(palette[3u * candidate + 2u]));
                color = (color >> int(p.fhedt_shift)) <<
                    int(p.fhedt_shift);
                gap = query - vec3(color);
                distance = dot(gap, gap);
                if (distance < minimum) {
                    minimum = distance;
                    best = candidate;
                }
            }
        }
    }
    return best;
}

/* Bucket addressing keeps the query's sub-byte position up to the cell
 * boundary. A negative sum is clamped first because its uint conversion
 * is undefined; any such query lands in cell 0 either way. */
uint diffuse_bitlut(vec3 query)
{
    uint bits, shift;
    uvec3 address;

    bits = p.bitlut_bits;
    shift = 8u - bits;
    address = min(uvec3(max(query + float(1u << (shift - 1u)), 0.0) /
        float(1u << shift)), uvec3((1u << bits) - 1u));
    return uint(fhedt_table8[(address.x << (2u * bits)) |
        (address.y << bits) | address.z]);
}

/* Direct squared differences avoid cancellation in |c|^2 - 2 q.c. */
uint diffuse_lookup(vec3 query)
{
    uint best, i;
    float minimum, distance;
    vec3 gap;

    if (p.lookup == 2u) {
        return diffuse_bitlut(query);
    }
    if (p.lookup != 0u) {
        return diffuse_fhedt(query);
    }
    best = 0u;
    minimum = uintBitsToFloat(0x7f800000u);
    for (i = 0u; i < p.ncolors; ++i) {
        gap = query - diffuse_color(i);
        distance = dot(gap, gap);
        if (distance < minimum) {
            minimum = distance;
            best = i;
        }
    }
    return best;
}

uint diffuse_version(uint x, uint y)
{
    uint bucket;

    bucket = uint(phase[(y & 63u) * 64u + (x & 63u)]);
    return ((pc.step / 4u) + (bucket < pc.step % 4u ? 1u : 0u)) & 1u;
}

vec4 diffuse_state(uint x, uint y, uint i)
{
    return diffuse_version(x, y) != 0u ? b[i] : a[i];
}

int diffuse_direction(int y)
{
    return p.serpentine != 0u && (y & 1) != 0 ? -1 : 1;
}

/* Limit the corrected sample as the CPU carry limiter does: scale the whole
 * correction until every channel lies within the soft bounds, preserving
 * its direction; hard clipping limits each channel independently. */
vec3 diffuse_carry(vec3 value_source, vec3 incoming)
{
    vec3 value;
    float scale;
    int n;

    if (dot(incoming, incoming) < p.deadzone * p.deadzone) {
        return value_source;
    }
    value = value_source + incoming;
    if (p.clamp_hard != 0u) {
        return roundEven(clamp(value, 0.0, 255.0));
    }
    scale = 1.0;
    for (n = 0; n < 3; ++n) {
        if (value[n] < p.clamp_lower) {
            scale = min(scale,
                (value_source[n] - p.clamp_lower) / (-incoming[n]));
        } else if (value[n] > p.clamp_upper) {
            scale = min(scale,
                (p.clamp_upper - value_source[n]) / incoming[n]);
        }
    }
    return roundEven(value_source + incoming * scale);
}

vec3 diffuse_send_taps(int x, int y, uint tap)
{
    uint i;

    if (x < 0 || y < 0 || x >= int(p.width) || y >= int(p.height)) {
        return vec3(0.0);
    }
    i = uint(y) * p.width + uint(x);
    return diffuse_state(uint(x), uint(y), i).xyz * p.tap_weights[tap];
}

vec3 diffuse_send_lso2(int x, int y, uint tap)
{
    vec3 error;
    uvec3 row;
    uint i;

    if (x < 0 || y < 0 || x >= int(p.width) || y >= int(p.height)) {
        return vec3(0.0);
    }
    i = uint(y) * p.width + uint(x);
    error = diffuse_state(uint(x), uint(y), i).xyz;
    row = uvec3(clamp(floor(abs(error) + 0.5), 0.0, 255.0));
    return error * vec3(weights[p.weight_base + 8u * row.x + tap],
        weights[p.weight_base + 8u * row.y + tap],
        weights[p.weight_base + 8u * row.z + tap]);
}

/* The solved state stores the residual against the chosen entry; rebuild
 * the fractional query the lookup consumed. The tap family keeps the
 * unclamped carry residual, so it clamps to the byte range again. */
vec3 diffuse_solved_query(vec4 state)
{
    vec3 query;

    query = state.xyz + diffuse_color(uint(state.w));
    if (METHOD != METHOD_LSO2) {
        query = clamp(query, 0.0, 255.0);
    }
    return query;
}

uint diffuse_classify(uint i, vec3 query, uint best)
{
    uint code, threshold, x, y, cell;
    vec3 old, gap, fresh;
    float old_distance, new_distance;
    bool within;

    code = 0u;
    fresh = diffuse_color(best);
    old = vec3(float(retained[3u * i]), float(retained[3u * i + 1u]),
        float(retained[3u * i + 2u]));
    gap = abs(query - old);
    threshold = p.threshold;
    if (p.columns != 0u) {
        x = i % p.width;
        y = i / p.width;
        cell = p.tiled != 0u ? (y & 63u) * 64u + (x & 63u)
            : (((y + 1u) * p.rows - 1u) / p.height) * p.columns
                + ((x + 1u) * p.columns - 1u) / p.width;
        if ((p.selection[cell / 32u] & (1u << (cell % 32u))) != 0u) {
            threshold = min(threshold, p.selected_threshold);
        }
    }
    within = all(lessThanEqual(gap, vec3(float(threshold))));
    if (p.metric == 2u) {
        within = dot(gap * gap, vec3(2.0, 4.0, 1.0))
            <= 7.0 * float(threshold) * float(threshold);
    }
    old_distance = dot(query - old, query - old);
    new_distance = dot(query - fresh, query - fresh);
    if (within) {
        code = any(notEqual(gap, vec3(0.0))) ? 3u : 1u;
    } else if (old_distance <= new_distance) {
        code = 1u;
    }
    return code;
}

void diffuse_initialize(uint i)
{
    vec3 query;
    uint best;

    if (transparent[i] != uint8_t(0)) {
        a[i] = vec4(0.0);
        return;
    }
    query = diffuse_source(i);
    best = diffuse_lookup(query);
    if (best >= p.ncolors) {
        invalid[0] = 1u;
        a[i] = vec4(0.0);
        return;
    }
    a[i] = vec4(query - diffuse_color(best), float(best));
}

void diffuse_iterate(uint lane)
{
    uint tile, position, i, best, tap;
    int x, y, sender, direction, above;
    vec3 incoming, candidate;
    precise vec3 query, previous;
    vec4 updated, state;

    tile = lane / 1024u;
    position = positions[(pc.step % 4u) * 1024u + lane % 1024u];
    x = int((tile % p.tiles_x) * 64u + position % 64u);
    y = int((tile / p.tiles_x) * 64u + position / 64u);
    if (x >= int(p.width) || y >= int(p.height)) {
        return;
    }
    i = uint(y) * p.width + uint(x);
    updated = vec4(0.0);
    if (transparent[i] == uint8_t(0)) {
        if (METHOD == METHOD_LSO2) {
            direction = (y & 1) != 0 ? -1 : 1;
            above = ((y - 1) & 1) != 0 ? -1 : 1;
            incoming = diffuse_send_lso2(x - direction, y, 0u);
            incoming += diffuse_send_lso2(x - 4 * direction, y, 1u);
            incoming += diffuse_send_lso2(x + above, y - 1, 2u);
            incoming += diffuse_send_lso2(x, y - 1, 3u);
            incoming += diffuse_send_lso2(x - above, y - 1, 4u);
            incoming += diffuse_send_lso2(x, y - 4, 5u);
            query = clamp(diffuse_source(i) + incoming, 0.0, 255.0);
            state = diffuse_state(uint(x), uint(y), i);
            previous = state.xyz + diffuse_color(uint(state.w));
            query = previous + (query - previous);
            candidate = query;
        } else {
            incoming = vec3(0.0);
            for (tap = 0u; tap < p.tap_count; ++tap) {
                sender = y - p.dy[tap];
                incoming += diffuse_send_taps(
                    x - diffuse_direction(sender) * p.dx[tap], sender, tap);
            }
            candidate = diffuse_carry(diffuse_source(i), incoming);
            query = clamp(candidate, 0.0, 255.0);
        }
        best = diffuse_lookup(query);
        if (best >= p.ncolors) {
            invalid[0] = 1u;
        } else {
            updated = vec4(candidate - diffuse_color(best), float(best));
        }
    }
    /* Earlier phases read new generations; this phase reads the old one.
     * No invocation can read another same-phase invocation's write. */
    if ((((pc.step / 4u) + 1u) & 1u) != 0u) {
        b[i] = updated;
    } else {
        a[i] = updated;
    }
}

void diffuse_finish(uint i)
{
    uint best, code;
    vec3 query;

    best = uint(a[i].w);
    code = 0u;
    if (transparent[i] != uint8_t(0)) {
        code = 1u;
    } else if (p.delta != 0u && valid[i] != uint8_t(0)) {
        /* Reconstruct the solved fractional query. Retained history is
         * consulted only now and never seeds a later frame's diffusion. */
        query = diffuse_solved_query(a[i]);
        best = diffuse_lookup(query);
        if (best >= p.ncolors) {
            invalid[0] = 1u;
            return;
        }
        code = diffuse_classify(i, query, best);
    }
    result[i] = uint8_t(code != 0u ? p.keycolor : best);
    skip[i] = uint8_t(code);
}

/* Preserve both the iterative index and the reconstructed-query choice.
 * The second state plane is dead after eight passes and owns the latter. */
void diffuse_solve_tail(uint i)
{
    vec3 query;
    uint best;

    if (transparent[i] != uint8_t(0)) {
        return;
    }
    query = diffuse_solved_query(a[i]);
    best = diffuse_lookup(query);
    if (best >= p.ncolors) {
        invalid[0] = 1u;
        return;
    }
    b[i] = vec4(query, float(best));
}

void diffuse_resolve(uint i)
{
    uint best, code;

    best = uint(a[i].w);
    code = 0u;
    if (transparent[i] != uint8_t(0)) {
        code = 1u;
    } else if (p.delta != 0u && valid[i] != uint8_t(0)) {
        /* The ready solution owns q and j; no lookup is needed here. */
        best = uint(b[i].w);
        code = diffuse_classify(i, b[i].xyz, best);
    }
    result[i] = uint8_t(code != 0u ? p.keycolor : best);
    skip[i] = uint8_t(code);
}

void main()
{
    uint index;

    index = gl_GlobalInvocationID.y * pc.pitch + gl_GlobalInvocationID.x;
    if (index >= pc.count) {
        return;
    }
    if (KERNEL == KERNEL_INITIALIZE) {
        diffuse_initialize(index);
    } else if (KERNEL == KERNEL_ITERATE) {
        diffuse_iterate(index);
    } else if (KERNEL == KERNEL_FINISH) {
        diffuse_finish(index);
    } else if (KERNEL == KERNEL_SOLVE_TAIL) {
        diffuse_solve_tail(index);
    } else {
        diffuse_resolve(index);
    }
}
