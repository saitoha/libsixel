if have_metal
  srcs += ['gpu-palette-metal.m', 'palette-kmeans-metal.m',
           'progressive-gpu-metal.m']
endif

if have_quicklook_thumbnailing
  srcs += ['quicklook_thumbnailing.m']
endif

if have_clipboard_macos
  if conf.get('HAVE_APPKIT', 0) == 1
    srcs += ['clipboard_macos.m']
  else
    srcs += ['clipboard_carbon.c']
  endif
endif

lt_soversion = ls_lt_current - ls_lt_age
lt_version = '@0@.@1@.@2@'.format(lt_soversion, ls_lt_age, ls_lt_revision)

float_lookup_objects = []
if amalgamated_lib_enabled
  libsixel_sources = [
    amalgamation_out,
  ]
  libsixel_c_args = libsixel_posix_defs
else
  float_lookup = static_library('sixel_float_lookup',
    ['lookup-vptree-float32.c', 'lookup-delaunay-float32.c',
     'lookup-blockcull-float32.c', sixcells_h],
    include_directories: project_inc,
    dependencies: deps,
    c_args: libsixel_posix_defs + float_lookup_c_args,
    pic: true,
    install: false)
  float_lookup_objects = float_lookup.extract_all_objects(recursive: true)
  libsixel_sources = srcs
  libsixel_c_args = libsixel_posix_defs
endif
libsixel_sources += [sixcells_h]
libsixel_build_deps = deps + msvc_pgo_post_wic_deps

libsixel = library('sixel',
                   libsixel_sources,
                   objects: float_lookup_objects,
                   include_directories: project_inc,
                   c_args: libsixel_c_args,
                   objc_args: libsixel_c_args,
                   dependencies: libsixel_build_deps,
                   version: lt_version,
                   soversion: lt_soversion.to_string(),
                   install: true)

libsixel_dep = declare_dependency(link_with: libsixel,
                                  include_directories: project_inc,
                                  sources: [sixcells_h],
                                  dependencies: libsixel_build_deps)

# Export the library target for other subdirectories (e.g. wheel builds).
set_variable('libsixel_library', libsixel)

