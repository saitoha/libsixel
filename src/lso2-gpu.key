#
# lso2 gpu
#
#   awk -f tools/gen_varcoefs.awk src/lso2-gpu.key > src/lso2-gpu-coefficients.h
#
# Input format (*.key):
#   g  w10  w20  wm11  w01  w11  w02   (g in [0..255], weights may be int or float)
#   Lines starting with '#' are comments.
#
#         curr  w10  w20
#   wm11  w01   w11
#         w02
0        8      0      3         6     0     1          0.905
1       13      0      3         6     0     1          0.935
2        8      0      3         6     0     1          0.960
32       7      2      1         5     1     4          0.755
64       4      4      4         4     4     4          0.755
96       5      3      4         5     4     3          0.855
108      4      1      3         5     3     3          0.855
120      4      0      1         4     0     5          0.890
116      4      1      1         5     1     5          0.885
127      4      1      1         5     1     5          0.885

# Small-error gain knots; interpolated in absolute RGB8 error units.
# gain ERROR MULTIPLIER
gain 0 0.6
gain 8 0.6
gain 32 1.0
gain 255 1.0
